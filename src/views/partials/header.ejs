<header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 md:px-8">
    <div>
        <h1 class="text-xl font-bold text-slate-900">Room Categories</h1>
        <p class="text-xs text-slate-500 hidden sm:block">Global Management System</p>
    </div>
    <div class="flex items-center space-x-4">
        
        <!-- Hotel Selector & Dropdown Wrapper -->
        <div class="relative" id="hotelSelectorWrapper">
            <!-- Main Header Button -->
            <div id="hotelSelectorBtn" class="flex items-center space-x-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 cursor-pointer hover:bg-slate-100 transition">
                <div class="w-7 h-7 bg-slate-800 rounded-md flex items-center justify-center text-white text-xs font-bold overflow-hidden" id="logoContainer"></div>
                <div class="text-left hidden sm:block">
                    <p class="text-xs font-semibold text-slate-800 leading-tight truncate max-w-[120px]" id="hotelName">Loading...</p>
                    <p class="text-[10px] text-slate-500 leading-none truncate max-w-[120px]" id="hotelCity">Please wait</p>
                </div>
                <i class="fa-solid fa-chevron-down text-xs text-slate-400 transition-transform duration-200" id="chevronIcon"></i>
            </div>

            <!-- Expanded Dropdown Panel -->
            <div id="hotelDetailsDropdown" class="hidden absolute right-0 top-full mt-2 w-[380px] bg-white rounded-xl shadow-2xl border border-slate-200 z-50 overflow-hidden">
                
                <!-- Cover Image Header -->
                <div class="h-28 bg-slate-200 relative" id="coverContainer">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
                    <div class="absolute bottom-3 left-4 flex items-center space-x-3">
                        <div class="w-14 h-14 rounded-lg border-2 border-white shadow-lg overflow-hidden bg-white" id="largeLogoContainer"></div>
                        <div>
                            <h3 class="text-white font-bold text-lg leading-tight drop-shadow-md" id="dropdownHotelName"></h3>
                            <p class="text-white/80 text-xs drop-shadow-sm" id="dropdownHotelSlug"></p>
                        </div>
                    </div>
                </div>

                <!-- Details Body -->
                <div class="p-5 space-y-5">
                    <!-- Status & ID -->
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Property Status</span>
                        <span id="statusBadge" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">Active</span>
                    </div>

                    <!-- Contact Info -->
                    <div class="space-y-2.5">
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Contact Information</h4>
                        <div class="flex items-center space-x-3 text-sm text-slate-700">
                            <i class="fa-solid fa-phone text-slate-400 w-4 text-xs"></i>
                            <span id="dropdownPhone" class="font-medium"></span>
                        </div>
                        <div class="flex items-center space-x-3 text-sm text-slate-700">
                            <i class="fa-solid fa-envelope text-slate-400 w-4 text-xs"></i>
                            <span id="dropdownEmail" class="truncate font-medium"></span>
                        </div>
                    </div>

                    <!-- Full Address -->
                    <div class="space-y-2.5">
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Location</h4>
                        <div class="flex items-start space-x-3 text-sm text-slate-700">
                            <i class="fa-solid fa-location-dot text-slate-400 w-4 text-xs mt-1"></i>
                            <p id="dropdownAddress" class="leading-relaxed font-medium"></p>
                        </div>
                    </div>

                    <!-- Footer / Metadata -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                        <span>Joined: <span id="dropdownCreatedAt" class="font-semibold text-slate-600"></span></span>
                        <span>Property ID: #<span id="dropdownHotelId" class="font-semibold text-slate-600"></span></span>
                    </div>
                </div>
            </div>
        </div>

        <button class="p-2 text-slate-400 hover:text-slate-600 relative">
            <!-- <i class="fa-regular fa-bell text-lg"></i> -->
        </button>
    </div>
</header>

<script>
const fetchHotelDetails = async () => {
    try {
        const response = await fetch("/hotelAdmin/hotel", { method: "GET" });
        const data = await response.json();
        
        // Check if data exists and has the hotel object
        if (data && data.hotel) {
            const hotel = data.hotel;

            // --- 1. Populate Main Header Elements ---
            const hotelName = document.getElementById("hotelName");
            const hotelCity = document.getElementById("hotelCity");
            const logoContainer = document.getElementById("logoContainer");

            hotelName.innerText = hotel.name || "Unknown Hotel";
            // Show City, Country in the small header text
            const shortLocation = [hotel.city, hotel.country].filter(Boolean).join(", ");
            hotelCity.innerText = shortLocation || "No location";
            
            if (hotel.logo_url) {
                logoContainer.style.backgroundImage = `url(${hotel.logo_url})`;
                logoContainer.style.backgroundSize = 'cover';
                logoContainer.style.backgroundPosition = 'center';
                logoContainer.innerText = ''; // Clear default text
            }

            // --- 2. Populate Dropdown Elements ---
            const coverContainer = document.getElementById("coverContainer");
            const largeLogoContainer = document.getElementById("largeLogoContainer");
            
            // Cover & Large Logo
            if (hotel.cover_url) {
                coverContainer.style.backgroundImage = `url(${hotel.cover_url})`;
                coverContainer.style.backgroundSize = 'cover';
                coverContainer.style.backgroundPosition = 'center';
            }
            if (hotel.logo_url) {
                largeLogoContainer.style.backgroundImage = `url(${hotel.logo_url})`;
                largeLogoContainer.style.backgroundSize = 'cover';
                largeLogoContainer.style.backgroundPosition = 'center';
                largeLogoContainer.innerText = '';
            }

            // Text Details
            document.getElementById("dropdownHotelName").innerText = hotel.name || "N/A";
            document.getElementById("dropdownHotelSlug").innerText = hotel.slug ? `@${hotel.slug}` : "";
            
            // Status Mapping (Assuming 1 = Active, adjust logic if your DB uses different IDs)
            const statusBadge = document.getElementById("statusBadge");
            if (hotel.tenant_status_id == 1) {
                statusBadge.innerText = "Active";
                statusBadge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200";
            } else {
                statusBadge.innerText = "Inactive / Pending";
                statusBadge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200";
            }

            document.getElementById("dropdownPhone").innerText = hotel.phone || "Not provided";
            document.getElementById("dropdownEmail").innerText = hotel.email || "Not provided";
            
            // Full Address (Combines address, city, state, country)
            const fullAddress = [hotel.address, hotel.city, hotel.state, hotel.country].filter(Boolean).join(", ");
            document.getElementById("dropdownAddress").innerText = fullAddress || "No address provided";

            // Dates & IDs
            const createdDate = hotel.created_at ? new Date(hotel.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : "N/A";
            document.getElementById("dropdownCreatedAt").innerText = createdDate;
            document.getElementById("dropdownHotelId").innerText = hotel.hotel_id || "N/A";

        } else {
            console.warn("No hotel data found in response.");
        }
    } catch (error) {
        console.error("Failed to fetch hotel details:", error);
    }
};

// Toggle Dropdown Logic
document.addEventListener('DOMContentLoaded', () => {
    fetchHotelDetails();

    const selectorBtn = document.getElementById('hotelSelectorBtn');
    const dropdown = document.getElementById('hotelDetailsDropdown');
    const chevron = document.getElementById('chevronIcon');

    if (selectorBtn && dropdown) {
        // Open/Close on click
        selectorBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        });

        // Close dropdown when clicking anywhere outside of it
        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target) && !selectorBtn.contains(e.target)) {
                dropdown.classList.add('hidden');
                chevron.classList.remove('rotate-180');
            }
        });
    }
});
</script>