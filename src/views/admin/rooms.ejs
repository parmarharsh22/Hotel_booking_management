<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStay - Room Categories</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
                <!-- SweetAlert2 for beautiful alerts -->
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <div class="flex flex-1 flex-col md:flex-row">
        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-white border-r border-slate-200 flex flex-col justify-between p-4 shrink-0">
            <div>
                <div class="text-2xl font-bold text-[#0f172a] tracking-tight px-3 py-4">
                    LuxeStay
                </div>
                
                <nav class="mt-4 space-y-1">
                    <a href="/hotelAdmin/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-table-columns w-5 text-slate-400"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/hotelAdmin/rooms" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-[#1e293b] text-white transition">
                        <i class="fa-solid fa-bed w-5"></i>
                        <span>Rooms</span>
                    </a>
                    <a href="/hotelAdmin/room-types/new" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-calendar-days w-5 text-slate-400"></i>
                        <span>Room Types</span>
                    </a>
                    <a href="/hotelAdmin/staff" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-address-book w-5 text-slate-400"></i>
                        <span>Staff</span>
                    </a>
                    <a href="/hotelAdmin/policies/new" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-chart-simple w-5 text-slate-400"></i>
                        <span>Cancellation Policy</span>
                    </a>
                    
                </nav>
            </div>

            <div class="mt-8 pt-4 border-t border-slate-100 space-y-1">
               
               <a href="/frontDesk/logout" class="flex items-center space-x-3 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-slate-400"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

<script>

function handleLogout() {
  
    // Clear all cookies
    document.cookie.split(";").forEach((cookie) => {
        const cookieName = cookie.split("=")[0].trim();

        document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
        document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${window.location.hostname};`;
    });

    // Clear localStorage and sessionStorage if used
    localStorage.clear();
    sessionStorage.clear();

    // Redirect to login page
    window.location.href = "/login";
}

</script>
        <!-- Main Workspace -->
        <main class="flex-1 flex flex-col">
            <%- include('../partials/header') %>
            
            <div class="p-6 md:p-8 space-y-6 max-w-[1600px] w-full mx-auto">
                
                <!-- Controls and Actions Header -->
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Inventory Overview</h2>
                        <p class="text-sm text-slate-500">Manage property room types, base pricing strategies, and amenity bundles.</p>
                    </div>
                    
                    <div class="flex items-center gap-3 relative self-end lg:self-auto">
                        <!-- <button onclick="toggleFilterDropdown()" id="filterToggleBtn" class="flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-md border border-slate-300 transition">
                            <i class="fa-solid fa-sliders text-xs"></i>
                            <span>Filter</span>
                        </button> -->
                        <a href="/hotelAdmin/rooms/new">
                            <button class="flex items-center space-x-2 bg-[#0f172a] hover:bg-slate-800 text-white text-sm font-medium px-4 py-2 rounded-md shadow-sm transition">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span>Add Rooms</span>
                            </button>
                        </a>
                        
                        <!-- Filter Dropdown Drawer -->
                        <div id="filterDropdown" class="hidden absolute right-0 top-12 w-72 bg-white rounded-xl shadow-xl border border-slate-200 p-4 z-50 transition-all duration-200">
                            <h4 class="text-sm font-bold text-slate-900 mb-3 border-b pb-2">Filter Rooms</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Room Type</label>
                                    <select id="filterRoomType" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                        <option value="">All Types</option>
                                        <% 
                                        // Robust mapping for unique room types
                                        const uniqueTypes = [...new Map(
                                            rooms.map(room => [room.room_type_id || room.type_id || room.category_id, room.type_name || room.category_name])
                                        ).entries()];
                                        %>
                                        <% uniqueTypes.forEach(([typeId, typeName]) => { %>
                                            <option value="<%= typeId %>"><%= typeName %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Status</label>
                                    <select id="filterStatus" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                        <option value="">All Statuses</option>
                                        <option value="1">Available</option>
                                        <option value="2">Occupied</option>
                                        <option value="3">Dirty</option>
                                        <option value="4">Maintenance</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Floor</label>
                                    <input type="number" id="filterFloor" placeholder="e.g. 4" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                </div>
                                <div class="flex items-center justify-end gap-2 pt-2">
                                    <button onclick="resetFilters()" class="text-xs text-slate-500 hover:text-slate-800 font-medium px-3 py-1.5 rounded">Reset</button>
                                    <button onclick="applyFiltersAndSearch(); toggleFilterDropdown();" class="text-xs bg-[#0f172a] text-white font-medium px-3 py-1.5 rounded hover:bg-slate-800">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI Metric Row -->
                <%- include('../partials/KPIMetrics', {rooms}) %>

                <!-- Inventory Data Sheet -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div class="flex items-baseline space-x-3">
                            <h3 class="font-bold text-slate-900">Current Room Inventory</h3>
                            <span id="visibleCounter" class="text-xs text-slate-500 border-l pl-3 border-slate-300"><%= rooms.length %> rooms visible</span>
                        </div>
                        <div class="relative w-full sm:w-64">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            <input type="text" id="tableSearch" oninput="applyFiltersAndSearch()" placeholder="Search rooms..." class="w-full text-xs bg-slate-50 border border-slate-200 rounded-md pl-9 pr-3 py-2 outline-none focus:bg-white focus:border-slate-400 transition">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                                    <th class="py-3 px-6">Category Name</th>
                                    <th class="py-3 px-6">Room / Floor Info</th>
                                    <th class="py-3 px-6">Amenities / Status</th>
                                    <th class="py-3 px-6">Base Price</th>
                                    <th class="py-3 px-6 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="roomContainer" class="divide-y divide-slate-100 text-sm text-slate-700">
                                <!-- JS will populate this dynamically to support pagination/search -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination / Footer Indicators -->
                    <div class="p-4 border-t border-slate-200 flex items-center justify-between flex-wrap gap-2 text-xs text-slate-500">
                        <div id="showingIndicator">Showing 0-0 of 0 items</div>
                        <div class="flex items-center space-x-1" id="paginationControls">
                            <!-- JS will populate pagination buttons -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Footer -->
            <footer class="mt-auto bg-white border-t border-slate-200 py-6 px-6 md:px-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <div>
                    <span class="font-semibold text-slate-700">LuxeStay</span> &copy; 2026 LuxeStay Hospitality Group. All rights reserved.
                </div>
                <div class="flex items-center space-x-4">
                    <a href="#" class="hover:text-slate-800 transition">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Terms of Service</a>
                </div>
            </footer>
        </main>
    </div>

    <!-- Interface Event Control Scripts -->
    <script>
        // Initialize Database
        const roomsData = <%- JSON.stringify(rooms) %>;
        console.log(roomsData);
        
        let mockRoomsDatabase = Array.isArray(roomsData) ? roomsData : [];
        let filteredData = [...mockRoomsDatabase];

        // Pagination Config
        const itemsPerPage = 5; 
        let currentPage = 1;

        // --- UI Interactions ---
        function toggleFilterDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('hidden');
        }

        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('filterDropdown');
            const toggleBtn = document.getElementById('filterToggleBtn');
            if (dropdown && !dropdown.contains(e.target) && !toggleBtn.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });

        function handleLogout() {
            document.cookie.split(";").forEach((cookie) => {
                const cookieName = cookie.split("=")[0].trim();
                document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
            });
            localStorage.clear();
            sessionStorage.clear();
            window.location.href = "/login";
        }

        // --- Core Logic Engine ---
        function applyFiltersAndSearch() {
            const typeValue = document.getElementById('filterRoomType').value;
            const statusValue = document.getElementById('filterStatus').value;
            const floorValue = document.getElementById('filterFloor').value;
            const searchVal = document.getElementById('tableSearch').value.toLowerCase();

            filteredData = mockRoomsDatabase.filter(room => {
                let matchesType = typeValue === "" || room.room_type_id == typeValue || room.type_id == typeValue;
                let matchesStatus = statusValue === "" || room.room_status_id == statusValue;
                let matchesFloor = floorValue === "" || room.floor == floorValue;
                
                let matchesSearch = (room.category_name || room.type_name || '').toLowerCase().includes(searchVal) || 
                                    (room.notes || '').toLowerCase().includes(searchVal) ||
                                    (room.room_number || '').toString().toLowerCase().includes(searchVal);
                                    
                return matchesType && matchesStatus && matchesFloor && matchesSearch;
            });

            currentPage = 1; // Reset to first page on new filter/search
            renderRoomCards();
        }

        function resetFilters() {
            document.getElementById('filterRoomType').value = "";
            document.getElementById('filterStatus').value = "";
            document.getElementById('filterFloor').value = "";
            document.getElementById('tableSearch').value = "";
            applyFiltersAndSearch();
            toggleFilterDropdown();
        }

        // --- Rendering Engine ---
        function renderRoomCards() {
            const container = document.getElementById('roomContainer');
            container.innerHTML = '';

            const totalPages = Math.ceil(filteredData.length / itemsPerPage) || 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const paginatedData = filteredData.slice(startIndex, endIndex);

            if (paginatedData.length === 0) {
                container.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-12 text-center text-slate-400 font-medium">
                            <i class="fa-solid fa-box-open text-2xl mb-2 text-slate-300"></i><br>
                            No active entries match current filter rules.
                        </td>
                    </tr>`;
                updateCounters(0);
                updatePaginationControls(0);
                return;
            }

            paginatedData.forEach(room => {
                // Status Badge Logic
                let statusBadge = '';
                if (room.room_status_id == 1) {
                    statusBadge = '<span class="text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">Available</span>';
                } else if (room.room_status_id == 2) {
                    statusBadge = '<span class="text-[10px] px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold border border-amber-200">Occupied</span>';
                } else if (room.room_status_id == 3) {
                    statusBadge = '<span class="text-[10px] px-2 py-0.5 rounded bg-red-50 text-red-700 font-semibold border border-red-200">Dirty</span>';
                } else if (room.room_status_id == 4) {
                    statusBadge = '<span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-semibold border border-slate-200">Maintenance</span>';
                } else {
                    statusBadge = '<span class="text-[10px] px-2 py-0.5 rounded bg-slate-50 text-slate-500 font-semibold border border-slate-200">Unknown</span>';
                }

                // Amenities
                let amenitiesHtml = '';
                if (room.amenities && Array.isArray(room.amenities)) {
                    amenitiesHtml = room.amenities.map(icon => 
                        `<i class="fa-solid ${icon} text-xs text-slate-400 bg-slate-100 p-1 rounded"></i>`
                    ).join(' ');
                }

                let imgUrl = room.photo_url || 'https://site-img-res-new.s3.ap-south-1.amazonaws.com/next-site-images/mobileplaceholder.jpg';
                let displayName = room.category_name || room.type_name || 'Standard Room';

                let rowHtml = `
                    <tr class="hover:bg-slate-50/70 transition">
                        <td class="py-4 px-6 flex items-center space-x-4">
                            <img src="${imgUrl}" alt="Room Thumbnail" class="w-12 h-12 object-cover rounded-lg bg-slate-100 shrink-0 border border-slate-200">
                            <div>
                                <div class="font-semibold text-slate-900">${displayName}</div>
                                <div class="text-[10px] tracking-wide font-bold text-slate-400 uppercase mt-0.5">${room.tag || ''}</div>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="text-xs font-semibold text-slate-700">Room ${room.room_number}</div>
                            <div class="text-[11px] text-slate-400">Floor Layout: ${room.floor}</div>
                        </td>
                        <td class="py-4 px-6 max-w-xs">
                            <div class="flex items-center space-x-2 mb-1.5 flex-wrap gap-1">
                                ${amenitiesHtml}
                                ${statusBadge}
                            </div>
                            <p class="text-[11px] text-slate-500 italic truncate" title="${room.notes || ''}">"${room.notes || 'No extra notes.'}"</p>
                        </td>
                        <td class="py-4 px-6 font-bold text-slate-900 text-base">
                            ₹${room.base_price || 0}
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="flex items-center justify-end space-x-2 text-slate-400">
                              
                                <a href="/hotelAdmin/rooms/${room.room_id}/edit" class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition" title="Edit">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <button class="p-1.5 hover:text-red-600 hover:bg-red-50 rounded transition" title="Delete" onclick="HandleRoomDelete('${room.room_id}')">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });

            updateCounters(filteredData.length);
            updatePaginationControls(filteredData.length);
        }

        // --- Metrics & Pagination UI ---
        function updateCounters(total) {
            document.getElementById('visibleCounter').innerText = `${total} room${total !== 1 ? 's' : ''} visible`;
            const start = total === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
            const end = Math.min(currentPage * itemsPerPage, total);
            document.getElementById('showingIndicator').innerText = `Showing ${start}-${end} of ${total} items`;
        }

        function updatePaginationControls(totalItems) {
            const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
            const paginationContainer = document.getElementById('paginationControls');
            paginationContainer.innerHTML = '';

            // Prev Button
            paginationContainer.insertAdjacentHTML('beforeend', `
                <button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} 
                class="px-2.5 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                </button>
            `);

            // Smart Page Numbers Logic
            const maxVisiblePages = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
            if (endPage - startPage + 1 < maxVisiblePages) startPage = Math.max(1, endPage - maxVisiblePages + 1);

            if (startPage > 1) {
                paginationContainer.insertAdjacentHTML('beforeend', `<button onclick="changePage(1)" class="px-3 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition">1</button>`);
                if (startPage > 2) paginationContainer.insertAdjacentHTML('beforeend', `<span class="px-2 text-slate-400">...</span>`);
            }

            for (let i = startPage; i <= endPage; i++) {
                const isActive = i === currentPage ? 'bg-[#0f172a] text-white border-transparent' : 'border border-slate-200 hover:bg-slate-50 text-slate-700';
                paginationContainer.insertAdjacentHTML('beforeend', `<button onclick="changePage(${i})" class="px-3 py-1.5 rounded font-medium ${isActive} transition">${i}</button>`);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) paginationContainer.insertAdjacentHTML('beforeend', `<span class="px-2 text-slate-400">...</span>`);
                paginationContainer.insertAdjacentHTML('beforeend', `<button onclick="changePage(${totalPages})" class="px-3 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition">${totalPages}</button>`);
            }

            // Next Button
            paginationContainer.insertAdjacentHTML('beforeend', `
                <button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} 
                class="px-2.5 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
            `);
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage) || 1;
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderRoomCards();
        }

        // --- Action Handlers ---
        async function HandleRoomDelete(room_id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this action!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, delete it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/hotelAdmin/rooms/${room_id}`, {
                        method: "DELETE"
                    });
                    
                    const resData = await response.json();

                    if (!response.ok) throw new Error(resData.message || "Failed to delete room");

                    await Swal.fire('Deleted!', resData.message || 'Room has been deleted successfully.', 'success');
                    
                    // Update local state and re-render
                    mockRoomsDatabase = mockRoomsDatabase.filter(r => r.room_id != room_id);
                    applyFiltersAndSearch();

                } catch (error) {
                    Swal.fire('Error!', error.message, 'error');
                }
            }
        }

        // Initial Render on Page Load
        document.addEventListener('DOMContentLoaded', () => {
            applyFiltersAndSearch();
        });
    </script>
</body>
</html>