 
<%
 
  pageTitle  = "Add Hotel — HBMS";
 
  activePage = "hotels";
 
%>
 
  <%- include('_layout_start') %>

<!-- Top bar -->
 
 
<div class="px-8 py-5 border-b border-surface-border flex items-center gap-4">
 
  <a href="/superadmin/hotels" class="p-1.5 rounded-lg text-muted hover: hover:bg-surface-2 transition-colors">
 
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
 
  </a>
 
  <div>
 
    <h1 class="text-lg font-semibold ">Add New Hotel</h1>
 
    <p class="text-xs text-muted mt-0.5">Create a new tenant and admin account</p>
 
  </div>
 
</div>
 
 
<div class="px-8 py-8 max-w-3xl">
 
  <div id="form-error" class="hidden mb-5 px-4 py-3 rounded-lg bg-red-950 border border-red-800 text-red-300 text-sm"></div>
 
 
  <!-- Hotel details section -->
 
  <div class="card p-6 mb-6">
 
    <div class="flex items-center gap-2 mb-5">
 
      <div class="w-6 h-6 rounded-md bg-accent-muted text-accent flex items-center justify-center">
 
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
 
      </div>
 
      <h2 class="text-sm font-semibold ">Hotel Details</h2>
 
    </div>
 
 
    <div class="grid grid-cols-2 gap-4">
 
      <div class="col-span-2">
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Hotel Name <span class="text-danger">*</span></label>
 
        <input type="text" name="name" id="name" placeholder="e.g. Grand Palace Hotel" class="input-field text-sm" required />
 
      </div>
 
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Email <span class="text-danger">*</span></label>
 
        <input type="email" name="email" id="email" placeholder="hotel@example.com" class="input-field text-sm" required />
 
      </div>
 
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Phone</label>
 
        <input type="text" name="phone" id="phone" placeholder="+1 234 567 8900" class="input-field text-sm" />
 
      </div>
 
 
      <div class="col-span-2">
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Address</label>
 
        <input type="text" name="address" id="address" placeholder="Street address" class="input-field text-sm" />
 
      </div>
 
 
    <!-- Country -->
<div>
    <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
        Country
    </label>

    <select id="country" name="country" class="input-field text-sm">
        <option value="">Select Country</option>
    </select>
</div>


<!-- State -->
<div>
    <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
        State
    </label>

    <select id="state" name="state" class="input-field text-sm" disabled>
        <option value="">Select State</option>
    </select>
</div>


<!-- City -->
<div>
    <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
        City
    </label>

    <select id="city" name="city" class="input-field text-sm" disabled>
        <option value="">Select City</option>
    </select>
</div>
 
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Logo URL</label>
 
        <!-- <input type="url" name="logo_url" id="logo_url" placeholder="https://..." class="input-field text-sm" /> -->
 <input type="file" name="logo_url" accept="image/*" id="logo_url" class="input-field text-sm" />
      </div>
 
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Cover Image URL</label>
 
        <!-- <input type="url" name="cover_url" id="cover_url" placeholder="https://..." class="input-field text-sm" /> -->
 <input type="file" name="cover_url" accept="image/*" id="cover_url" class="input-field text-sm" />
      </div>
 
    </div>
 
  </div>
 
 
  <!-- Admin account section -->
 
  <div class="card p-6 mb-6">
 
    <div class="flex items-center gap-2 mb-5">
 
      <div class="w-6 h-6 rounded-md bg-accent-muted text-accent flex items-center justify-center">
 
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
 
      </div>
 
      <h2 class="text-sm font-semibold ">Admin Account</h2>
 
      <span class="text-xs text-muted ml-1">— auto-generated password will be logged</span>
 
    </div>
 
 
    <div class="grid grid-cols-2 gap-4">
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">First Name <span class="text-danger">*</span></label>
 
        <input type="text" name="admin_first_name" id="admin_first_name" placeholder="John" class="input-field text-sm" required />
 
      </div>
 
 
      <div>
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Last Name <span class="text-danger">*</span></label>
 
        <input type="text" name="admin_last_name" id="admin_last_name" placeholder="Smith" class="input-field text-sm" required />
 
      </div>
 
 
      <div class="col-span-2">
 
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Admin Email <span class="text-danger">*</span></label>
 
        <input type="email" name="admin_email" id="admin_email" placeholder="admin@grandpalace.com" class="input-field text-sm" required />
 
      </div>
 
    </div>
 
  </div>
 
 
  <!-- Actions -->
 
  <div class="flex items-center gap-3">
 
    <button id="submit-btn" onclick="submitForm()" class="btn-primary px-6 py-2.5 rounded-lg text-sm font-medium flex items-center gap-2">
 
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
 
      Create Hotel
 
    </button>
 
    <a href="/superadmin/hotels" class="btn-ghost px-6 py-2.5 rounded-lg text-sm font-medium">Cancel</a>
 
  </div>
 
</div>
 
 
<script>

const countrySelect = document.getElementById("country");
const stateSelect = document.getElementById("state");
const citySelect = document.getElementById("city");


/* ===============================
   Load Countries
================================= */
async function loadCountries() {
    try {

        const response = await fetch(
            "https://countriesnow.space/api/v0.1/countries/positions"
        );

        const result = await response.json();

        countrySelect.innerHTML =
            '<option value="">Select Country</option>';

        result.data
            .sort((a,b) => a.name.localeCompare(b.name))
            .forEach(country => {

                const option = document.createElement("option");

                option.value = country.name;
                option.textContent = country.name;

                countrySelect.appendChild(option);
            });

    } catch(err) {

        console.error("Failed to load countries", err);

    }
}


/* ===============================
   Load States
================================= */
async function loadStates(country) {

    stateSelect.disabled = true;
    citySelect.disabled = true;

    stateSelect.innerHTML =
        '<option>Loading states...</option>';

    try {

        const response = await fetch(
            "https://countriesnow.space/api/v0.1/countries/states",
            {
                method: "POST",
                headers: {
                    "Content-Type":"application/json"
                },
                body: JSON.stringify({
                    country: country
                })
            }
        );


        const result = await response.json();


        stateSelect.innerHTML =
            '<option value="">Select State</option>';


        result.data.states
            .sort((a,b) => a.name.localeCompare(b.name))
            .forEach(state => {

                const option = document.createElement("option");

                option.value = state.name;
                option.textContent = state.name;

                stateSelect.appendChild(option);

            });


        stateSelect.disabled = false;


    } catch(err) {

        console.error("Failed loading states", err);

    }

}


/* ===============================
   Load Cities
================================= */
async function loadCities(country, state) {

    citySelect.disabled = true;

    citySelect.innerHTML =
        '<option>Loading cities...</option>';


    try {


        const response = await fetch(
            "https://countriesnow.space/api/v0.1/countries/state/cities",
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body: JSON.stringify({
                    country: country,
                    state: state
                })
            }
        );


        const result = await response.json();


        citySelect.innerHTML =
            '<option value="">Select City</option>';


        result.data
            .sort((a,b) => a.localeCompare(b))
            .forEach(city => {


                const option =
                    document.createElement("option");


                option.value = city;

                option.textContent = city;


                citySelect.appendChild(option);

            });


        citySelect.disabled = false;


    } catch(err) {

        console.error("Failed loading cities", err);

    }
}



/* ===============================
   Dropdown Events
================================= */

countrySelect.addEventListener("change", function(){

    stateSelect.innerHTML =
        '<option value="">Select State</option>';

    citySelect.innerHTML =
        '<option value="">Select City</option>';


    stateSelect.disabled = true;
    citySelect.disabled = true;


    if(this.value){

        loadStates(this.value);

    }

});


stateSelect.addEventListener("change", function(){

    citySelect.innerHTML =
        '<option value="">Select City</option>';

    citySelect.disabled = true;


    if(this.value){

        loadCities(
            countrySelect.value,
            this.value
        );

    }

});


/* ===============================
   Submit Form
================================= */

async function submitForm() {


    const formData = new FormData();


    const fields = [
        "name",
        "email",
        "phone",
        "address",
        "country",
        "state",
        "city",
        "admin_first_name",
        "admin_last_name",
        "admin_email"
    ];


    fields.forEach(field => {

        const element =
            document.getElementById(field);

        formData.append(
            field,
            element.value.trim()
        );

    });



    // Images

    const logo =
        document.getElementById("logo_url").files[0];


    const cover =
        document.getElementById("cover_url").files[0];


    if(logo){
        formData.append("logo_url", logo);
    }


    if(cover){
        formData.append("cover_url", cover);
    }


    try {

        const res = await fetch(
            "/superadmin/hotels",
            {
                method:"POST",
                body: formData
            }
        );


        if(res.ok){

            window.location.href =
                "/superadmin/hotels";

        } else {

            alert("Failed to create hotel");

        }


    } catch(error){

        console.error(error);

        alert("Something went wrong");

    }

}


/* ===============================
   Initial Load
================================= */

document.addEventListener(
    "DOMContentLoaded",
    loadCountries
);

</script>
 

 <%- include('_layout_end') %>
