    <!-- Interface Event Control Scripts -->
    <script>
// Dynamically adjusts UI metrics when a user stages a local binary image asset
function updateUploadIndicator(input) {
    const feedback = document.getElementById('uploadFeedback');
    const txt = document.getElementById('feedbackText');
    
    if (input.files && input.files[0]) {
        const file = input.files[0];
        txt.innerText = `Asset ready: "${file.name}" (${(file.size / 1024).toFixed(1)} KB)`;
        feedback.className = "flex mt-2 text-[11px] font-semibold text-slate-700 bg-slate-100 border border-slate-200 rounded-md py-1.5 px-3 items-center space-x-2";
    } else {
        feedback.classList.add('hidden');
    }
}

// Submits data dynamically while maintaining standard multipart payload states
async function submitStaffCreation(event) {
    event.preventDefault();
    
    const form = event.target;
    const alertBox = document.getElementById('formAlert');
    const submitBtn = document.getElementById('submitFormBtn');
    
    // Package standard inputs along with file fields natively 
    const payload = new FormData(form);

    // Apply interactive UI loading hooks
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-70');
    
    try {
        const response = await fetch('/hotelAdmin/staff', {
            method: 'POST',
            body: payload // Sent directly without manual headers to allow proper Boundary Generation
        });

        const result = await response.json();

        if (!response.ok || result.success === false) {
            throw new Error(result.message || 'An upstream fault occurred during staff initialization provisioning pipeline.');
        }

        // Show Success confirmation alert
        alertBox.className = "p-4 rounded-lg text-xs font-medium border bg-emerald-50 text-emerald-800 border-emerald-200 mb-6";
        alertBox.innerHTML = `<i class="fa-solid fa-circle-check mr-2"></i> Operational staff account provisioned securely! Redirecting to index list...`;
        alertBox.classList.remove('hidden');
        
        setTimeout(() => {
            window.location.href = '/hotelAdmin/staff';
        }, 1500);

    } catch (error) {
        // Output localized application faults
        alertBox.className = "p-4 rounded-lg text-xs font-medium border bg-rose-50 text-rose-800 border-rose-200 mb-6";
        alertBox.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-2"></i> ${error.message}`;
        alertBox.classList.remove('hidden');
        
        // Re-enable interactive element targets
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-70');
    }
}







</script>
