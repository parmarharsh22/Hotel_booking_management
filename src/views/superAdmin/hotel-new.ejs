 async function submitForm() {
    const formData = new FormData();

    // text fields
    ['name','email','phone','address','city','state','country',
     'admin_first_name','admin_last_name','admin_email'].forEach(f => {
        formData.append(f, document.getElementById(f).value.trim());
    });

    // file fields
    const logo  = document.getElementById('logo_url').files[0];
    const cover = document.getElementById('cover_url').files[0];
    if (logo)  formData.append('logo_url',  logo);
    if (cover) formData.append('cover_url', cover);

    const res = await fetch('/superadmin/hotels', {
        method: 'POST',
        body: formData,
        // NO Content-Type header — browser sets it automatically with boundary
    });

    if (res.ok) window.location.href = '/superadmin/hotels';
}

</script>
 

