<% pageTitle = "Add Hotel — HBMS"; activePage = "hotels"; %> <%-
include('_layout_start') %>

<style>
  .glass-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 8px 32px rgba(0,0,0,0.24), inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .field-error {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    color: #fca5a5;
    margin-top: 5px;
    min-height: 16px;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .field-error.show { opacity: 1; transform: translateY(0); }
  .field-error svg { width: 12px; height: 12px; flex-shrink: 0; }

  .input-field.has-error {
    border-color: #f87171 !important;
    box-shadow: 0 0 0 3px rgba(248,113,113,0.12);
  }
  .input-field.is-valid {
    border-color: rgba(34,197,94,0.4) !important;
  }

  .section-glow {
    position: relative;
    overflow: hidden;
  }
  .section-glow::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(79,142,247,0.10), transparent 70%);
    pointer-events: none;
  }

  .upload-zone {
    transition: all 0.2s ease;
  }
  .upload-zone:hover {
    border-color: rgba(79,142,247,0.4) !important;
    background: rgba(79,142,247,0.04);
  }
  .upload-zone.filled {
    border-color: rgba(34,197,94,0.4) !important;
    background: rgba(34,197,94,0.04);
  }
</style>

<!-- Top bar -->
<div class="px-8 py-5 border-b border-surface-border flex items-center gap-4 sticky top-0 z-30 backdrop-blur-xl bg-surface-1/80">
  <a
    href="/superadmin/hotels"
    class="p-2 rounded-lg text-muted hover:text-white hover:bg-surface-2 transition-all hover:-translate-x-0.5"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  </a>

  <div>
    <h1 class="text-lg font-semibold">Add New Hotel</h1>
    <p class="text-xs text-muted mt-0.5">Create a new tenant and admin account</p>
  </div>
</div>

<div class="px-8 py-8 max-w-3xl">

  <!-- Hotel details section -->
  <div class="glass-card section-glow rounded-2xl p-6 mb-6">
    <div class="flex items-center gap-2.5 mb-6">
      <div class="w-7 h-7 rounded-lg bg-accent-muted text-accent flex items-center justify-center shrink-0">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        </svg>
      </div>
      <h2 class="text-sm font-semibold tracking-tight">Hotel Details</h2>
    </div>

    <div class="grid grid-cols-2 gap-5">
      <div class="col-span-2">
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
          Hotel Name <span class="text-danger">*</span>
        </label>
        <input type="text" name="name" id="name" placeholder="e.g. Grand Palace Hotel" class="input-field text-sm" />
        <p class="field-error" id="err-name"></p>
      </div>

      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
          Email <span class="text-danger">*</span>
        </label>
        <input type="email" name="email" id="email" placeholder="hotel@example.com" class="input-field text-sm" />
        <p class="field-error" id="err-email"></p>
      </div>

      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Phone</label>
        <input type="text" name="phone" id="phone" placeholder="+1 234 567 8900" class="input-field text-sm" />
        <p class="field-error" id="err-phone"></p>
      </div>

      <div class="col-span-2">
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Address</label>
        <input type="text" name="address" id="address" placeholder="Street address" class="input-field text-sm" />
        <p class="field-error" id="err-address"></p>
      </div>

      <!-- Country -->
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Country</label>
        <select id="country" name="country" class="input-field text-sm">
          <option value="">Select Country</option>
        </select>
        <p class="field-error" id="err-country"></p>
      </div>

      <!-- State -->
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">State</label>
        <select id="state" name="state" class="input-field text-sm" disabled>
          <option value="">Select State</option>
        </select>
        <p class="field-error" id="err-state"></p>
      </div>

      <!-- City -->
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">City</label>
        <select id="city" name="city" class="input-field text-sm" disabled>
          <option value="">Select City</option>
        </select>
        <p class="field-error" id="err-city"></p>
      </div>

      <div></div>

      <!-- Logo upload -->
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Hotel Logo</label>
        <label for="logo_url" class="upload-zone flex items-center gap-3 px-3.5 py-3 rounded-lg border border-dashed border-surface-border cursor-pointer">
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="text-xs text-muted truncate" id="logo_label">Click to upload image</span>
        </label>
        <input type="file" name="logo_url" accept="image/*" id="logo_url" class="hidden" />
        <p class="field-error" id="err-logo_url"></p>
      </div>

      <!-- Cover upload -->
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Cover Image</label>
        <label for="cover_url" class="upload-zone flex items-center gap-3 px-3.5 py-3 rounded-lg border border-dashed border-surface-border cursor-pointer">
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="text-xs text-muted truncate" id="cover_label">Click to upload image</span>
        </label>
        <input type="file" name="cover_url" accept="image/*" id="cover_url" class="hidden" />
        <p class="field-error" id="err-cover_url"></p>
      </div>
    </div>
  </div>

  <!-- Admin account section -->
  <div class="glass-card section-glow rounded-2xl p-6 mb-6">
    <div class="flex items-center gap-2.5 mb-6">
      <div class="w-7 h-7 rounded-lg bg-accent-muted text-accent flex items-center justify-center shrink-0">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4" /><path d="M20 21a8 8 0 1 0-16 0" />
        </svg>
      </div>
      <h2 class="text-sm font-semibold tracking-tight">Admin Account</h2>
      <span class="text-xs text-muted ml-1">— auto-generated password will be logged</span>
    </div>

    <div class="grid grid-cols-2 gap-5">
      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
          First Name <span class="text-danger">*</span>
        </label>
        <input type="text" name="admin_first_name" id="admin_first_name" placeholder="John" class="input-field text-sm" />
        <p class="field-error" id="err-admin_first_name"></p>
      </div>

      <div>
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
          Last Name <span class="text-danger">*</span>
        </label>
        <input type="text" name="admin_last_name" id="admin_last_name" placeholder="Smith" class="input-field text-sm" />
        <p class="field-error" id="err-admin_last_name"></p>
      </div>

      <div class="col-span-2">
        <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
          Admin Email <span class="text-danger">*</span>
        </label>
        <input type="email" name="admin_email" id="admin_email" placeholder="admin@grandpalace.com" class="input-field text-sm" />
        <p class="field-error" id="err-admin_email"></p>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-3">
    <button id="submit-btn" onclick="submitForm()" class="btn-primary px-6 py-2.5 rounded-lg text-sm font-medium flex items-center gap-2 transition-transform active:scale-95">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path d="M12 5v14M5 12h14" />
      </svg>
      Create Hotel
    </button>
    <a href="/superadmin/hotels" class="btn-ghost px-6 py-2.5 rounded-lg text-sm font-medium">Cancel</a>
  </div>
</div>

<script>
  const countrySelect = document.getElementById("country");
  const stateSelect   = document.getElementById("state");
  const citySelect    = document.getElementById("city");

  /* ── File label updates ─────────────────────────── */
  function wireFileInput(inputId, labelId) {
    const input = document.getElementById(inputId);
    const label = document.getElementById(labelId);
    input.addEventListener("change", () => {
      const zoneEl = document.querySelector(`label[for="${inputId}"]`);
      if (input.files[0]) {
        label.textContent = input.files[0].name;
        zoneEl.classList.add("filled");
        clearFieldError(inputId);
      } else {
        label.textContent = "Click to upload image";
        zoneEl.classList.remove("filled");
      }
    });
  }
  wireFileInput("logo_url", "logo_label");
  wireFileInput("cover_url", "cover_label");

  /* ── Inline field error helpers ─────────────────── */
  function setFieldError(fieldId, message) {
    const errEl = document.getElementById(`err-${fieldId}`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) {
      errEl.innerHTML = `
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>${message}</span>`;
      errEl.classList.add("show");
    }
    const target = (fieldId === "logo_url" || fieldId === "cover_url")
      ? document.querySelector(`label[for="${fieldId}"]`)
      : inputEl;
    if (target) {
      target.classList.add("has-error");
      target.classList.remove("is-valid");
    }
  }

  function clearFieldError(fieldId) {
    const errEl = document.getElementById(`err-${fieldId}`);
    const inputEl = document.getElementById(fieldId);
    if (errEl) { errEl.classList.remove("show"); errEl.textContent = ""; }
    const target = (fieldId === "logo_url" || fieldId === "cover_url")
      ? document.querySelector(`label[for="${fieldId}"]`)
      : inputEl;
    if (target) target.classList.remove("has-error");
  }

  function markValid(fieldId) {
    const inputEl = document.getElementById(fieldId);
    if (inputEl && inputEl.value.trim()) inputEl.classList.add("is-valid");
  }

  function clearAllErrors() {
    document.querySelectorAll(".field-error").forEach(el => { el.classList.remove("show"); el.textContent = ""; });
    document.querySelectorAll(".has-error").forEach(el => el.classList.remove("has-error"));
  }

  /* Live-clear error as user types/selects */
  ["name","email","phone","address","country","state","city","admin_first_name","admin_last_name","admin_email"].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener("input", () => { clearFieldError(id); markValid(id); });
    el.addEventListener("change", () => { clearFieldError(id); markValid(id); });
  });

  /* ===============================
     Load Countries
  ================================= */
  async function loadCountries() {
    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/positions");
      const result = await response.json();
      countrySelect.innerHTML = '<option value="">Select Country</option>';
      result.data
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach((country) => {
          const option = document.createElement("option");
          option.value = country.name;
          option.textContent = country.name;
          countrySelect.appendChild(option);
        });
    } catch (err) {
      console.error("Failed to load countries", err);
    }
  }

  /* ===============================
     Load States
  ================================= */
  async function loadStates(country) {
    stateSelect.disabled = true;
    citySelect.disabled = true;
    stateSelect.innerHTML = "<option>Loading states...</option>";

    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/states", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ country: country }),
      });
      const result = await response.json();

      stateSelect.innerHTML = '<option value="">Select State</option>';
      result.data.states
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach((state) => {
          const option = document.createElement("option");
          option.value = state.name;
          option.textContent = state.name;
          stateSelect.appendChild(option);
        });
      stateSelect.disabled = false;
    } catch (err) {
      console.error("Failed loading states", err);
    }
  }

  /* ===============================
     Load Cities
  ================================= */
  async function loadCities(country, state) {
    citySelect.disabled = true;
    citySelect.innerHTML = "<option>Loading cities...</option>";

    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/state/cities", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ country: country, state: state }),
      });
      const result = await response.json();

      citySelect.innerHTML = '<option value="">Select City</option>';
      result.data
        .sort((a, b) => a.localeCompare(b))
        .forEach((city) => {
          const option = document.createElement("option");
          option.value = city;
          option.textContent = city;
          citySelect.appendChild(option);
        });
      citySelect.disabled = false;
    } catch (err) {
      console.error("Failed loading cities", err);
    }
  }

  /* ===============================
     Dropdown Events
  ================================= */
  countrySelect.addEventListener("change", function () {
    stateSelect.innerHTML = '<option value="">Select State</option>';
    citySelect.innerHTML = '<option value="">Select City</option>';
    stateSelect.disabled = true;
    citySelect.disabled = true;
    clearFieldError("country");
    if (this.value) loadStates(this.value);
  });

  stateSelect.addEventListener("change", function () {
    citySelect.innerHTML = '<option value="">Select City</option>';
    citySelect.disabled = true;
    clearFieldError("state");
    if (this.value) loadCities(countrySelect.value, this.value);
  });

  /* ===============================
     Validation -- now per-field
  ================================= */
  function validateForm() {
    clearAllErrors();
    let firstErrorField = null;
    let hasError = false;

    function fail(fieldId, message) {
      setFieldError(fieldId, message);
      hasError = true;
      if (!firstErrorField) firstErrorField = fieldId;
    }

    const name    = document.getElementById("name").value.trim();
    const email   = document.getElementById("email").value.trim();
    const phone   = document.getElementById("phone").value.trim();
    const address = document.getElementById("address").value.trim();
    const country = document.getElementById("country").value;
    const state   = document.getElementById("state").value;
    const city    = document.getElementById("city").value;

    const adminFirstName = document.getElementById("admin_first_name").value.trim();
    const adminLastName  = document.getElementById("admin_last_name").value.trim();
    const adminEmail     = document.getElementById("admin_email").value.trim();

    const logo  = document.getElementById("logo_url").files[0];
    const cover = document.getElementById("cover_url").files[0];

    if (!name) fail("name", "Hotel name is required");

    if (!email) fail("email", "Email is required");
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) fail("email", "Enter a valid email address");

    if (!phone) fail("phone", "Phone number is required");
    else if (!/^[0-9+\-\s]{8,15}$/.test(phone)) fail("phone", "Enter a valid phone number");

    if (!address) fail("address", "Address is required");
    if (!country) fail("country", "Please select a country");
    if (!state) fail("state", "Please select a state");
    if (!city) fail("city", "Please select a city");

    if (!logo) fail("logo_url", "Hotel logo is required");
    else if (!logo.type.startsWith("image/")) fail("logo_url", "File must be an image");

    if (!cover) fail("cover_url", "Cover image is required");
    else if (!cover.type.startsWith("image/")) fail("cover_url", "File must be an image");

    if (!adminFirstName) fail("admin_first_name", "First name is required");
    if (!adminLastName) fail("admin_last_name", "Last name is required");

    if (!adminEmail) fail("admin_email", "Admin email is required");
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(adminEmail)) fail("admin_email", "Enter a valid email address");

    return { hasError, firstErrorField };
  }

  /* ===============================
     Submit Form
  ================================= */
  async function submitForm() {
    const { hasError, firstErrorField } = validateForm();

    if (hasError) {
      const el = document.getElementById(firstErrorField) || document.querySelector(`label[for="${firstErrorField}"]`);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    const formData = new FormData();
    const fields = [
      "name","email","phone","address","country","state","city",
      "admin_first_name","admin_last_name","admin_email",
    ];
    fields.forEach((field) => {
      const element = document.getElementById(field);
      formData.append(field, element.value.trim());
    });

    const logo  = document.getElementById("logo_url").files[0];
    const cover = document.getElementById("cover_url").files[0];
    if (logo) formData.append("logo_url", logo);
    if (cover) formData.append("cover_url", cover);

    const btn = document.getElementById("submit-btn");
    btn.disabled = true;
    btn.classList.add("opacity-60", "cursor-not-allowed");
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
      </svg> Creating...`;

    try {
      const res = await fetch("/superadmin/hotels", { method: "POST", body: formData });
      if (res.ok) {
        window.location.href = "/superadmin/hotels";
      } else {
        const msg = await res.text();
        setFieldError("name", msg || "Failed to create hotel");
        btn.disabled = false;
        btn.classList.remove("opacity-60", "cursor-not-allowed");
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Create Hotel`;
      }
    } catch (error) {
      console.error(error);
      setFieldError("name", "Something went wrong. Please try again.");
      btn.disabled = false;
      btn.classList.remove("opacity-60", "cursor-not-allowed");
      btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Create Hotel`;
    }
  }

  document.addEventListener("DOMContentLoaded", loadCountries);
</script>

<%- include('_layout_end') %>