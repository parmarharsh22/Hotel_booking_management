<%
  const inr = n => "₹" + Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2 });
  const fmtDate = d => {
    if (!d) return "—";
    return new Date(d).toLocaleDateString("en-IN", { day:"2-digit", month:"short", year:"numeric" });
  };
  const nights = Math.max(1, Math.round(
    (new Date(booking.checkout_date) - new Date(booking.checkin_date)) / 86400000
  ));
  const statusCfg = s => ({
    CONFIRMED:   { cls:"sc",  label:"Confirmed",   color:"#0d9f6e", bg:"#e6f9f3" },
    CHECKED_IN:  { cls:"sci", label:"Checked In",  color:"#1c64f2", bg:"#e1effe" },
    CHECKED_OUT: { cls:"sco", label:"Checked Out", color:"#4b5563", bg:"#f3f4f6" },
    CANCELLED:   { cls:"sx",  label:"Cancelled",   color:"#e02424", bg:"#fde8e8" },
    PENDING:     { cls:"sp",  label:"Pending",     color:"#c27803", bg:"#fdf6b2" },
  }[s] || { cls:"sd", label: s, color:"#6b7280", bg:"#f3f4f6" });
  const sc = statusCfg(booking.status_name);
  const isHttp = u => u && u.startsWith("http");
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= booking.booking_reference %></title>
  <style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600;700;800&display=swap');

:root{
  --bg:#f8fafc;
  --card:#ffffff;

  --ink:#0f172a;
  --ink2:#475569;
  --muted:#64748b;
  --line:#e2e8f0;

  --accent:#b45309;
  --accent-dark:#92400e;
  --accent-light:#fef3e2;

  --radius:16px;

  --shadow:
    0 2px 8px rgba(0,0,0,.06),
    0 8px 24px rgba(0,0,0,.08);

  --shadow-hover:
    0 20px 50px rgba(0,0,0,.10);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:'Inter',-apple-system,sans-serif;
  background:var(--bg);
  color:var(--ink);
  min-height:100vh;
}


/* ================= HERO ================= */

.hero{
  height:320px;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(135deg,#1e293b,#0f172a);
}

.hero-img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .5s ease;
}

.hero:hover .hero-img{
  transform:scale(1.03);
}

.hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.15),
      rgba(0,0,0,.65)
    );
}


/* Back button */

.hero-back{
  position:absolute;
  top:20px;
  left:20px;
  z-index:10;

  display:inline-flex;
  align-items:center;
  gap:6px;

  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.25);

  color:#fff;
  text-decoration:none;
  font-size:13px;
  font-weight:500;

  padding:8px 14px;
  border-radius:999px;

  backdrop-filter:blur(10px);
  transition:.2s;
}

.hero-back:hover{
  background:rgba(255,255,255,.25);
}


/* Hotel Info */

.hero-bottom{
  position:absolute;
  bottom:0;
  left:0;
  right:0;

  z-index:5;

  padding:24px 28px;

  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:16px;
}


.hero-hotel{
  display:flex;
  align-items:flex-end;
  gap:14px;
}


.hero-logo{
  width:60px;
  height:60px;

  border-radius:12px;
  overflow:hidden;

  background:#fff;
  border:2px solid rgba(255,255,255,.7);

  flex-shrink:0;

  display:flex;
  align-items:center;
  justify-content:center;
}


.hero-logo img{
  width:100%;
  height:100%;
  object-fit:cover;
}


.hero-logo .logo-init{
  font-size:24px;
  font-weight:700;
  color:var(--accent);
}


.hero-text h1{
  font-family:'Playfair Display',serif;
  font-size:30px;
  font-weight:700;
  color:#fff;
  line-height:1.2;
}


.hero-text p{
  font-size:13px;
  color:rgba(255,255,255,.75);
  margin-top:4px;
}


/* Status */

.hero-status{
  display:inline-flex;
  align-items:center;
  gap:6px;

  padding:6px 14px;

  border-radius:999px;

  font-size:12px;
  font-weight:700;
  letter-spacing:.04em;

  flex-shrink:0;

  background:
    linear-gradient(
      135deg,
      #b45309,
      #92400e
    );

  color:#fff;
}


/* ================= LAYOUT ================= */

.layout{
  max-width:900px;

  margin:-56px auto 40px;

  padding:0 16px;

  position:relative;
  z-index:10;

  display:grid;

  grid-template-columns:1fr 340px;

  gap:20px;

  align-items:start;
}


/* ================= CARDS ================= */

.dcard{
  background:var(--card);

  border-radius:var(--radius);

  box-shadow:var(--shadow);

  border:1px solid var(--line);

  overflow:hidden;

  margin-bottom:16px;

  transition:.25s ease;
}


.dcard:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow-hover);
}


.dcard-header{
  padding:16px 20px;

  border-bottom:1px solid var(--line);

  display:flex;

  align-items:center;

  gap:10px;
}


.dcard-header h2{
  font-size:14px;
  font-weight:700;
}


.dcard-icon{
  width:32px;
  height:32px;

  border-radius:8px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  color:var(--accent);

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:16px;
}


.dcard-body{
  padding:20px;
}/* ================= BOOKING REFERENCE ================= */

.ref-block{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 20px;
  border-bottom:1px solid var(--line);
}

.ref-lbl{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}

.ref-val{
  font-family:'Playfair Display', serif;
  font-size:20px;
  font-weight:700;
  letter-spacing:.04em;
  color:var(--accent-dark);
}

.booked-on{
  text-align:right;
}

.booked-on .lbl{
  font-size:11px;
  color:var(--muted);
}

.booked-on .val{
  font-size:14px;
  font-weight:600;
  margin-top:2px;
}


/* ================= DATE TIMELINE ================= */

.dates-timeline{
  display:flex;
  align-items:center;
  gap:0;
  margin-bottom:20px;
}


.dt-cell{
  flex:1;
  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  border:1px solid #fde3b8;

  border-radius:12px;

  padding:14px 16px;

  text-align:center;
}


.dt-label{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--accent);
  margin-bottom:4px;
}


.dt-date{
  font-size:16px;
  font-weight:700;
  color:var(--ink);
}


.dt-day{
  font-size:11px;
  color:var(--muted);
  margin-top:2px;
}


.dt-mid{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:0 12px;
}


.dt-mid .nights-bubble{
  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-dark)
    );

  color:#fff;

  font-size:11px;
  font-weight:700;

  padding:5px 12px;

  border-radius:999px;
  white-space:nowrap;
}


.dt-mid .arr{
  font-size:20px;
  color:var(--accent);
  margin:4px 0;
}


/* ================= INFO ROWS ================= */

.info-row{
  display:flex;
  align-items:center;
  padding:14px 0;
  border-bottom:1px solid var(--line);
}


.info-row:last-child{
  border-bottom:none;
}


.info-icon{
  width:36px;
  font-size:18px;
  flex-shrink:0;
  color:var(--accent);
}


.info-lbl{
  font-size:12px;
  color:var(--muted);
}


.info-val{
  font-size:14px;
  font-weight:600;
  margin-top:2px;
  color:var(--ink);
}


/* ================= NOTE BOX ================= */

.note-box{
  margin-top:16px;

  display:flex;
  gap:10px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  border:1px solid #fde3b8;

  border-radius:12px;

  padding:14px 16px;
}


.note-box .note-icon{
  font-size:18px;
  flex-shrink:0;
  color:var(--accent);
}


.note-box p{
  color:var(--accent-dark);
  line-height:1.5;
  font-size:13px;
}


/* ================= ROOM CARDS ================= */

.rcard{
  display:flex;

  border:1px solid var(--line);

  border-radius:12px;

  overflow:hidden;

  margin-bottom:12px;

  transition:.25s ease;
}


.rcard:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 24px rgba(0,0,0,.08);
}


.rcard:last-child{
  margin-bottom:0;
}


.rcard-img{
  width:90px;
  min-width:90px;

  overflow:hidden;

  background:#f1f5f9;
}


.rcard-img img{
  width:100%;
  height:100%;
  object-fit:cover;
}


.rcard-fallback{
  width:100%;
  height:100%;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:30px;
  color:#94a3b8;
}


.rcard-info{
  flex:1;

  padding:14px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:8px;
}


.rcard-num{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}


.rcard-type{
  font-size:15px;
  font-weight:700;
  margin-top:2px;
}


.rcard-right{
  text-align:right;
}


.rcard-rate{
  font-family:'Playfair Display', serif;
  font-size:18px;
  font-weight:700;
  color:var(--accent-dark);
}


.rcard-per{
  font-size:11px;
  color:var(--muted);
}


.rcard-sub{
  margin-top:6px;

  display:inline-block;

  background:#fef3e2;

  color:var(--accent-dark);

  padding:4px 9px;

  border-radius:8px;

  font-size:12px;

  font-weight:600;
}


/* ================= PRICE SIDEBAR ================= */

.price-card{
  background:
    linear-gradient(
      160deg,
      #0f172a,
      #1e293b
    );

  border:1px solid #334155;

  border-radius:var(--radius);

  padding:24px;

  color:#fff;

  box-shadow:
    0 12px 32px rgba(15,23,42,.35);

  margin-bottom:16px;
}


.price-card h3{
  font-size:12px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:rgba(255,255,255,.6);
  margin-bottom:12px;
}


.price-main{
  font-family:'Playfair Display', serif;
  font-size:40px;
  font-weight:700;
  margin-bottom:6px;
}


.price-note{
  font-size:13px;
  color:rgba(255,255,255,.65);
}


.price-divider{
  border:none;
  border-top:1px solid rgba(255,255,255,.15);
  margin:18px 0;
}


.price-row{
  display:flex;
  justify-content:space-between;
  font-size:13px;
  margin-bottom:10px;
}


.price-row .pl{
  color:rgba(255,255,255,.65);
}


.price-row .pr{
  font-weight:600;
}


/* ================= BUTTONS ================= */

.action-btns{
  display:flex;
  flex-direction:column;
  gap:10px;
}


.btn-primary{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  width:100%;

  padding:13px;

  background:
    linear-gradient(
      135deg,
      #b45309,
      #92400e
    );

  color:#fff;

  border:none;

  border-radius:10px;

  font-size:14px;

  font-weight:600;

  text-decoration:none;

  cursor:pointer;

  transition:.2s ease;
}


.btn-primary:hover{
  background:
    linear-gradient(
      135deg,
      #92400e,
      #78350f
    );

  transform:translateY(-2px);

  box-shadow:
    0 8px 24px rgba(180,83,9,.35);
}


.btn-ghost{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  width:100%;

  padding:13px;

  background:#fff;

  color:var(--ink);

  border:1.5px solid var(--line);

  border-radius:10px;

  font-size:14px;

  font-weight:600;

  text-decoration:none;

  transition:.2s ease;
}


.btn-ghost:hover{
  border-color:var(--accent);

  background:#fff8f0;

  color:var(--accent);
}


/* ================= STATUS BADGE ================= */

.status-badge-lg{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  padding:12px;

  border-radius:12px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  color:var(--accent-dark);

  font-size:14px;

  font-weight:700;

  margin-bottom:16px;

  border:1px solid #fde3b8;
}


/* ================= RESPONSIVE ================= */

@media(max-width:700px){

  .layout{
    grid-template-columns:1fr;
    margin-top:-20px;
  }


  .hero{
    height:250px;
  }


  .hero-bottom{
    padding:18px;
    flex-direction:column;
    align-items:flex-start;
  }


  .hero-text h1{
    font-size:22px;
  }


  .dates-timeline{
    flex-direction:column;
    gap:10px;
  }


  .dt-mid{
    transform:rotate(90deg);
    margin:8px 0;
  }


  .rcard-info{
    flex-direction:column;
    align-items:flex-start;
  }


  .rcard-right{
    text-align:left;
  }
}
  </style>
</head>
<body>

<!-- hero -->
<div class="hero">
  <% if (isHttp(booking.hotel_cover)) { %>
    <img class="hero-img" src="<%= booking.hotel_cover %>" alt="<%= booking.hotel_name %>"
         onerror="this.style.display='none'"/>
  <% } %>
  <div class="hero-overlay"></div>

  <a href="/bookings/all" class="hero-back">← My Bookings</a>

  <div class="hero-bottom">
    <div class="hero-hotel">
      <div class="hero-logo">
        <% if (isHttp(booking.hotel_logo)) { %>
          <img src="<%= booking.hotel_logo %>" alt=""
               onerror="this.style.display='none';this.nextElementSibling.style.display='block'"/>
          <span class="logo-init" style="display:none"><%= (booking.hotel_name||"H")[0] %></span>
        <% } else { %>
          <span class="logo-init"><%= (booking.hotel_name||"H")[0] %></span>
        <% } %>
      </div>
      <div class="hero-text">
        <h1><%= booking.hotel_name %></h1>
        <p>📍 <%= booking.hotel_city %><% if (booking.hotel_address) { %> &nbsp;·&nbsp; <%= booking.hotel_address %><% } %></p>
      </div>
    </div>
    <span class="hero-status" style="background:<%= sc.bg %>;color:<%= sc.color %>">
      <%= sc.label %>
    </span>
  </div>
</div>

<!-- main layout -->
<div class="layout">

  <!-- LEFT column -->
  <div>

    <!-- booking reference -->
    <div class="dcard">
      <div class="ref-block">
        <div>
          <div class="ref-lbl">Booking Reference</div>
          <div class="ref-val"># <%= booking.booking_reference %></div>
        </div>
        <div class="booked-on">
          <div class="lbl">Booked on</div>
          <div class="val"><%= fmtDate(booking.created_at) %></div>
        </div>
      </div>

      <!-- dates timeline -->
      <div style="padding:20px">
        <div class="dates-timeline">
          <div class="dt-cell">
            <div class="dt-label">Check-in</div>
            <div class="dt-date"><%= fmtDate(booking.checkin_date) %></div>
            <div class="dt-day"><%= new Date(booking.checkin_date).toLocaleDateString("en-IN",{weekday:"long"}) %></div>
          </div>
          <div class="dt-mid">
            <div class="nights-bubble"><%= nights %> Night<%= nights > 1 ? "s" : "" %></div>
            <div class="arr">→</div>
          </div>
          <div class="dt-cell">
            <div class="dt-label">Check-out</div>
            <div class="dt-date"><%= fmtDate(booking.checkout_date) %></div>
            <div class="dt-day"><%= new Date(booking.checkout_date).toLocaleDateString("en-IN",{weekday:"long"}) %></div>
          </div>
        </div>

        <!-- info rows -->
        <div class="info-row">
          <div class="info-icon">👥</div>
          <div>
            <div class="info-lbl">Guests</div>
            <div class="info-val">
              <%= booking.adults %> Adult<%= booking.adults > 1 ? "s" : "" %>
              <% if (booking.children > 0) { %> · <%= booking.children %> Child<%= booking.children > 1 ? "ren" : "" %><% } %>
            </div>
          </div>
        </div>
        <div class="info-row">
          <div class="info-icon">🌐</div>
          <div>
            <div class="info-lbl">Booking Source</div>
            <div class="info-val"><%= booking.source_name %></div>
          </div>
        </div>

        <% if (booking.special_requests) { %>
          <div class="note-box">
            <div class="note-icon">📝</div>
            <p><strong>Special Requests:</strong> <%= booking.special_requests %></p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- rooms -->
    <div class="dcard">
      <div class="dcard-header">
        <div class="dcard-icon">🛏</div>
        <h2>Rooms Booked</h2>
      </div>
      <div class="dcard-body">
        <% booking.rooms.forEach(r => {
             const rate = parseFloat(r.rate_per_night);
             const sub  = rate * nights;
        %>
          <div class="rcard">
            <div class="rcard-img" style="height:100px">
              <% if (isHttp(r.room_photo)) { %>
                <img src="<%= r.room_photo %>" alt="<%= r.type_name %>"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
                <div class="rcard-fallback" style="display:none">🛏</div>
              <% } else { %>
                <div class="rcard-fallback">🛏</div>
              <% } %>
            </div>
            <div class="rcard-info">
              <div class="rcard-left">
                <div class="rcard-num">Room <%= r.room_number %></div>
                <div class="rcard-type"><%= r.type_name %></div>
              </div>
              <div class="rcard-right">
                <div class="rcard-rate"><%= inr(rate) %></div>
                <div class="rcard-per">per night</div>
                <div class="rcard-sub"><%= inr(sub) %> · <%= nights %>N</div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  </div>

  <!-- RIGHT sidebar -->
  <div>

    <!-- price card -->
    <div class="price-card">
      <h3>Total Amount</h3>
      <div class="price-main"><%= inr(booking.total_amount) %></div>
      <div class="price-note">for <%= nights %> night<%= nights > 1 ? "s" : "" %> · <%= booking.adults %> guest<%= booking.adults > 1 ? "s" : "" %></div>
      <hr class="price-divider"/>
      <% booking.rooms.forEach(r => { %>
        <div class="price-row">
          <span class="pl">Room <%= r.room_number %> (<%= r.type_name %>)</span>
          <span class="pr"><%= inr(parseFloat(r.rate_per_night) * nights) %></span>
        </div>
      <% }) %>
    </div>

    <!-- status -->
    <div class="dcard" style="margin-bottom:16px">
      <div class="dcard-body">
        <div class="status-badge-lg" style="background:<%= sc.bg %>;color:<%= sc.color %>">
          <span style="font-size:18px">
            <% if (sc.label==="Confirmed") { %>✓<% } else if (sc.label==="Checked In") { %>🏠<% } else if (sc.label==="Checked Out") { %>✔<% } else if (sc.label==="Cancelled") { %>✕<% } else { %>⏳<% } %>
          </span>
          <%= sc.label %>
        </div>
        <div style="font-size:12px;color:var(--muted);text-align:center">
          Booking created <%= fmtDate(booking.created_at) %> via <%= booking.source_name %>
        </div>
      </div>
    </div>

    <!-- actions -->
    <div class="action-btns">
      <a href="/invoices/<%= booking.booking_id %>" class="btn-primary">
        🧾 View & Print Invoice
      </a>
      <a href="/bookings/all" class="btn-ghost">
        ← Back to All Bookings
      </a>
    </div>

  </div>

</div>
</body>
</html>