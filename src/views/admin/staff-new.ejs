    <!-- Interface Event Control Scripts -->
    <script>
        function handleLogout() {
            document.cookie.split(";").forEach((cookie) => {
                const cookieName = cookie.split("=")[0].trim();
                document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
                document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${window.location.hostname};`;
            });
            localStorage.clear();
            sessionStorage.clear();
            window.location.href = "/login";
        }

        // Comprehensive Client-Side Validation
        function validateForm(form) {
            const formData = new FormData(form);
            const errors = [];

            const firstName = formData.get('first_name').trim();
            if (firstName.length < 2) errors.push("First Name must be at least 2 characters long.");

            const lastName = formData.get('last_name').trim();
            if (lastName.length < 2) errors.push("Last Name must be at least 2 characters long.");

            const email = formData.get('email').trim();
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) errors.push("Please enter a valid email address.");

            const password = formData.get('password');
            if (password.length < 8) errors.push("Password must be at least 8 characters long.");
            if (!/[A-Z]/.test(password)) errors.push("Password must contain at least one uppercase letter.");
            if (!/[a-z]/.test(password)) errors.push("Password must contain at least one lowercase letter.");
            if (!/[0-9]/.test(password)) errors.push("Password must contain at least one number.");

            const dob = formData.get('dob');
            if (dob) {
                const birthDate = new Date(dob);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
                if (age < 18) errors.push("Staff member must be at least 18 years old.");
            }

            const phone = formData.get('phone').trim();
            if (phone) {
                const phoneRegex = /^\+?[1-9]\d{1,14}$/;
                if (!phoneRegex.test(phone.replace(/[\s\-\(\)]/g, ''))) {
                    errors.push("Please enter a valid phone number.");
                }
            }

            const fileInput = document.getElementById('staff_photo');
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                if (file.size > 2 * 1024 * 1024) errors.push("Profile image must be less than 2MB.");
                const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
                if (!validTypes.includes(file.type)) errors.push("Profile image must be JPG, PNG, or WEBP.");
            }

            return errors;
        }

        // Real-time File Upload Validation & Feedback
        function updateUploadIndicator(input) {
            const feedback = document.getElementById('uploadFeedback');
            const txt = document.getElementById('feedbackText');
            
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
                
                if (!validTypes.includes(file.type)) {
                    txt.innerText = `Invalid file type. Please select JPG, PNG, or WEBP.`;
                    feedback.className = "flex mt-2 text-[11px] font-semibold text-rose-700 bg-rose-50 border border-rose-200 rounded-md py-1.5 px-3 items-center space-x-2";
                    input.value = ""; // Clear invalid file
                    return;
                }
                
                if (file.size > 2 * 1024 * 1024) {
                    txt.innerText = `File too large. Maximum size is 2MB.`;
                    feedback.className = "flex mt-2 text-[11px] font-semibold text-rose-700 bg-rose-50 border border-rose-200 rounded-md py-1.5 px-3 items-center space-x-2";
                    input.value = ""; // Clear invalid file
                    return;
                }

                txt.innerText = `Asset ready: "${file.name}" (${(file.size / 1024).toFixed(1)} KB)`;
                feedback.className = "flex mt-2 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-md py-1.5 px-3 items-center space-x-2";
            } else {
                feedback.classList.add('hidden');
            }
        }

        // Form Submission with Advanced Error Handling
        async function submitStaffCreation(event) {
            event.preventDefault();
            
            const form = event.target;
            const submitBtn = document.getElementById('submitFormBtn');
            
            // 1. Run Client-Side Validations
            const validationErrors = validateForm(form);
            if (validationErrors.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Validation Errors',
                    html: `<ul class="text-left list-disc pl-4 mt-2 text-sm">${validationErrors.map(e => `<li>${e}</li>`).join('')}</ul>`,
                    confirmButtonColor: '#0f172a'
                });
                return;
            }

            const payload = new FormData(form);

            // 2. Show Loading State
            Swal.fire({
                title: 'Provisioning Account...',
                text: 'Please wait while we securely create the staff account.',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
            
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70');
            
            try {
                const response = await fetch('/hotelAdmin/staff', {
                    method: 'POST',
                    body: payload
                });

                let result = {};
                try {
                    result = await response.json();
                } catch (e) {
                    if (!response.ok) throw new Error(`Server returned status ${response.status}`);
                }

                // 3. Handle Server Responses
                if (!response.ok) {
                    // Handle specific 400 Bad Request Validation Errors from Backend
                    if (response.status === 400 && result.errors) {
                        let errorHtml = '<ul class="text-left list-disc pl-4 mt-2 text-sm">';
                        for (const [field, messages] of Object.entries(result.errors)) {
                            const msg = Array.isArray(messages) ? messages.join(', ') : messages;
                            errorHtml += `<li><strong>${field.replace(/_/g, ' ')}:</strong> ${msg}</li>`;
                        }
                        errorHtml += '</ul>';
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'Server Validation Failed',
                            html: errorHtml,
                            confirmButtonColor: '#0f172a'
                        });
                    } else {
                        throw new Error(result.message || 'An upstream fault occurred during staff initialization.');
                    }
                } else {
                    // 4. Handle Success
                    await Swal.fire({
                        icon: 'success',
                        title: 'Account Provisioned!',
                        text: 'Operational staff account provisioned securely. Redirecting to index list...',
                        confirmButtonColor: '#0f172a',
                        timer: 2000,
                        timerProgressBar: true
                    });
                    window.location.href = '/hotelAdmin/staff';
                }

            } catch (error) {
                // 5. Handle Network/Unexpected Errors
                Swal.fire({
                    icon: 'error',
                    title: 'Provisioning Failed',
                    text: error.message || 'An unexpected network error occurred. Please try again.',
                    confirmButtonColor: '#0f172a'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70');
            }
        }
    </script>
</body>
</html>