<aside
    class="fixed left-0 top-0 w-[260px] h-screen bg-gradient-to-b from-[#031632] to-[#1a2b48] text-white shadow-2xl flex flex-col z-50">

    <!-- brand -->
    <div class="px-6 py-6 border-b border-white/10">

        <h1 class="text-2xl font-bold text-white">
            <a href="/frontDesk/home">
                LuxeStay
            </a>
        </h1>

        <p class="text-xs uppercase tracking-[0.2em] text-yellow-200 mt-2">
            Front Desk Panel
        </p>

    </div>

    <!-- navigation -->
    <nav class="flex-1 px-4 py-6">

        <p class="text-[11px] uppercase tracking-widest text-blue-200 mb-3 px-3">
            Operations
        </p>

        <ul class="space-y-2">

            <li>
                <a href="/frontDesk/home"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">dashboard</span>
                    Dashboard
                </a>
            </li>

            <li>
                <a href="/frontDesk/bookings"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">event_note</span>
                    Bookings
                </a>
            </li>

            <li>
                <a href="/frontDesk/home"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">login</span>
                    Check-In
                </a>
            </li>

            <li>
                <a href="/frontDesk/checkout"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">logout</span>
                    Check-Out
                </a>
            </li>

            <li>
                <a href="/frontDesk/showRoomStatuses"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">bed</span>
                    Room Status
                </a>
            </li>

            <li>
                <a href="/frontDesk/incidentals"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">add_card</span>
                    Incidentals
                </a>
            </li>

        </ul>

        <p class="text-[11px] uppercase tracking-widest text-blue-200 mt-8 mb-3 px-3">
            Guest Services
        </p>

        <ul class="space-y-2">

            <li>
                <a href="/frontDesk/guests"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">groups</span>
                    Guests
                </a>
            </li>

            <li>
                <a href="/frontDesk/payments"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">payments</span>
                    Payments
                </a>
            </li>

            <li>
                <a href="/frontDesk/invoices"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition">
                    <span class="material-symbols-outlined">receipt_long</span>
                    Invoices
                </a>
            </li>

        </ul>

    </nav>

    <!-- user info + logout -->
    <div class="border-t border-white/10 p-5">

        <div class="flex items-center gap-3 mb-4">

            <!-- profile photo — falls back to initials background if photo is null -->
            <div class="w-10 h-10 rounded-full bg-[#775a19] flex items-center justify-center text-white font-semibold">
                <img src="/uploads/profile-photos/<%= photo %>" alt="Profile"
                    class="w-10 h-10 rounded-full object-cover border border-gray-300">
            </div>

            <div>
                <p class="font-medium text-sm">
                    <%= first_name + " " + last_name %>
                </p>
                <p class="text-xs text-blue-200">
                    Shift: <%= shift %>
                </p>
            </div>

        </div>

        <a href="/frontDesk/logout"
            class="w-full flex items-center justify-center gap-2 bg-[#775a19] hover:bg-[#5d4201] rounded-lg py-3 font-medium transition">
            <span class="material-symbols-outlined">logout</span>
            Logout
        </a>

    </div>

</aside>