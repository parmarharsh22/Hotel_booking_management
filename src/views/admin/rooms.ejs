        <%- include('../partials/header') %>
            <div class="p-6 md:p-8 space-y-6 max-w-[1600px] w-full mx-auto">
                
                <!-- Controls and Actions Header -->
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Inventory Overview</h2>
                        <p class="text-sm text-slate-500">Manage property room types, base pricing strategies, and amenity bundles.</p>
                    </div>
                    
                    <div class="flex items-center gap-3 relative self-end lg:self-auto">
                        <button onclick="toggleFilterDropdown()" class="flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-md border border-slate-300 transition">
                            <i class="fa-solid fa-sliders text-xs"></i>
                            <span>Filter</span>
                        </button>
                        <a href="/hoteladmin/rooms/new">
                        <button class="flex items-center space-x-2 bg-[#0f172a] hover:bg-slate-800 text-white text-sm font-medium px-4 py-2 rounded-md shadow-sm transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add Rooms</span>
                        </button>
                        </a>
                        <!-- Filter Dropdown Drawer -->
                        <div id="filterDropdown" class="hidden absolute right-0 top-12 w-72 bg-white rounded-xl shadow-xl border border-slate-200 p-4 z-50 transition-all duration-200">
                            <h4 class="text-sm font-bold text-slate-900 mb-3 border-b pb-2">Filter Rooms</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Room Type ID</label>
                                    <select id="filterRoomType"
        class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
    <option value="">All Types</option>

    <% 
    const uniqueTypes = [...new Map(
        rooms.map(room => [room.type_name ])
    ).entries()];
    %>

    <% uniqueTypes.forEach(([typeId, typeName]) => { %>
        <option value="<%= typeId %>">
            <%= typeName %> (<%= typeId %>)
        </option>
    <% }) %>
</select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Status ID</label>
                                    <select id="filterStatus" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                        <option value="">All Statuses</option>
                                        <option value="1">Available (1)</option>
                                        <option value="2">Occupied (2)</option>
                                        <option value="3">Maintenance (3)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Floor</label>
                                    <input type="number" id="filterFloor" placeholder="e.g. 4" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                </div>
                                <div class="flex items-center justify-end gap-2 pt-2">
                                    <button onclick="resetFilters()" class="text-xs text-slate-500 hover:text-slate-800 font-medium px-3 py-1.5 rounded">Reset</button>
                                    <button onclick="applyFilters()" class="text-xs bg-[#0f172a] text-white font-medium px-3 py-1.5 rounded hover:bg-slate-800">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI Metric Row -->
               <%-include('../partials/KPIMetrics' , {rooms})%>

                <!-- Inventory Data Sheet -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div class="flex items-baseline space-x-3">
                            <h3 class="font-bold text-slate-900">Current Room Inventory</h3>
                            <span id="visibleCounter" class="text-xs text-slate-500 border-l pl-3 border-slate-300"><%= rooms.length %> types visible</span>
                        </div>
                        <div class="relative w-full sm:w-64">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            <input type="text" id="tableSearch" oninput="searchTable()" placeholder="Search categories..." class="w-full text-xs bg-slate-50 border border-slate-200 rounded-md pl-9 pr-3 py-2 outline-none focus:bg-white focus:border-slate-400 transition">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                                    <th class="py-3 px-6">Category Name</th>
                                    <th class="py-3 px-6">Room / Floor Info</th>
                                    <th class="py-3 px-6">Amenities / Status</th>
                                    <th class="py-3 px-6">Base Price</th>
                                    <th class="py-3 px-6 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="roomContainer" class="divide-y divide-slate-100 text-sm text-slate-700">
                                
                                <% rooms.forEach(room => { %>
                                    
                                    <tr class="hover:bg-slate-50/70 transition">
                                        <td class="py-4 px-6 flex items-center space-x-4">
                                            <img src="<%= room.photo_url || 'https://site-img-res-new.s3.ap-south-1.amazonaws.com/next-site-images/mobileplaceholder.jpg' %>" alt="Room Thumbnail" class="w-12 h-12 object-cover rounded-lg bg-slate-100 shrink-0 border border-slate-200">
                                            <div>
                                                <div class="font-semibold text-slate-900"><%= room.category_name %></div>
                                                <div class="text-[10px] tracking-wide font-bold text-slate-400 uppercase mt-0.5"><%= room.tag %></div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-6">
                                            <div class="text-xs font-semibold text-slate-700">Room <%= room.room_number %></div>
                                            <div class="text-[11px] text-slate-400">Floor Layout: <%= room.floor %></div>
                                        </td>
                                        <td class="py-4 px-6 max-w-xs">
                                           <div class="flex items-center space-x-2 mb-1.5">

   <% if (room.room_status_id == 1) { %>

    <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
        Available
    </span>

<% } else if (room.room_status_id == 3) { %>

    <span class="text-[10px] px-2 py-0.5 rounded bg-red-50 text-red-700 font-semibold border border-red-200">
        Maintenance
    </span>

<% } else { %>

    <span class="text-[10px] px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold border border-amber-200">
        Occupied
    </span>

<% } %>

</div>
                                            <p class="text-[11px] text-slate-500 italic truncate" title="<%= room.notes %>">"<%= room.notes || 'No extra notes.' %>"</p>
                                        </td>
                                        <td class="py-4 px-6 font-bold text-slate-900 text-base">
                                            $<%= room.base_price%>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <div class="flex items-center justify-end space-x-2 text-slate-400">
                                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-eye"></i></button>
                                                <a href="rooms/<%= room.room_id%>/edit">
                                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-pen-to-square"></i></button>
                                            </a>
                                            <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition" onclick="HandleRoomDelete('<%=room.room_id%>')"><i class="fa-regular fa-trash-can"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>

                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination / Footer Indicators -->
                    <div class="p-4 border-t border-slate-200 flex items-center justify-between flex-wrap gap-2 text-xs text-slate-500">
                        <div id="showingIndicator">Showing 1-<%= rooms.length %> of <%= rooms.length %> items</div>
                        <div class="flex items-center space-x-1">
                            <button class="px-2.5 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition"><i class="fa-solid fa-chevron-left text-[10px]"></i></button>
                            <button class="px-3 py-1.5 rounded bg-[#0f172a] text-white font-medium">1</button>
                            <button class="px-3 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition">2</button>
                            <button class="px-3 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition">3</button>
                            <button class="px-2.5 py-1.5 rounded border border-slate-200 hover:bg-slate-50 transition"><i class="fa-solid fa-chevron-right text-[10px]"></i></button>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Page Footer -->
            <footer class="mt-auto bg-white border-t border-slate-200 py-6 px-6 md:px-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <div>
                    <span class="font-semibold text-slate-700">LuxeStay</span> &copy; 2026 LuxeStay Hospitality Group. All rights reserved.
                </div>
                <div class="flex items-center space-x-4">
                    <a href="#" class="hover:text-slate-800 transition">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Terms of Service</a>
                    <a href="#" class="hover:text-slate-800 transition">Cookie Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Accessibility</a>
                </div>
            </footer>
        </main>
    </div>

    <!-- Interface Event Control Scripts -->
    <script>
          const roomsData = <%- JSON.stringify(rooms) %>;
         console.log(roomsData);
         
        // Safely parse the EJS variables directly into a client-side database matrix 
        // to keep search/filter features working completely without extra API hits!
      
        // Toggle Filter UI Popup Card
        function toggleFilterDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside components boundary
        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('filterDropdown');
            if (!dropdown.contains(e.target) && !e.target.closest('button')?.innerText.includes('Filter')) {
                dropdown.classList.add('hidden');
            }
        });


async function HandleRoomDelete(room_id){

    const response = await fetch(`/hotelAdmin/rooms/${room_id}` , {
        method:"DELETE"

    })
    
    console.log(response.json());
    alert(response)


}


        // Dynamic table structural redraw client side for sorting/filtering mechanisms
        function renderRoomCards(dataset) {
            const container = document.getElementById('roomContainer');
            container.innerHTML = '';

            if (dataset.length === 0) {
                container.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400 font-medium">
                            No active entries match current filter rules.
                        </td>
                    </tr>`;
                updateCounters(0);
                return;
            }

            dataset.forEach(room => {
                let statusBadge = room.room_status_id === 1 
                    ? '<span class="text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">Available</span>'
                    : '<span class="text-[10px] px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold border border-amber-200">Occupied</span>';

                let amenitiesHtml = (room.amenities || []).map(icon => 
                    `<i class="fa-solid ${icon} text-xs text-slate-400 bg-slate-100 p-1 rounded"></i>`
                ).join(' ');

                let imgUrl = room.photo_url || 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=200&q=80';

                let rowHtml = `
                    <tr class="hover:bg-slate-50/70 transition">
                        <td class="py-4 px-6 flex items-center space-x-4">
                            <img src="${imgUrl}" alt="Room Thumbnail" class="w-12 h-12 object-cover rounded-lg bg-slate-100 shrink-0 border border-slate-200">
                            <div>
                                <div class="font-semibold text-slate-900">${room.category_name}</div>
                                <div class="text-[10px] tracking-wide font-bold text-slate-400 uppercase mt-0.5">${room.tag || ''}</div>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="text-xs font-semibold text-slate-700">Room ${room.room_number}</div>
                            <div class="text-[11px] text-slate-400">Floor Layout: ${room.floor}</div>
                        </td>
                        <td class="py-4 px-6 max-w-xs">
                            <div class="flex items-center space-x-2 mb-1.5">
                                ${amenitiesHtml}
                                ${statusBadge}
                            </div>
                            <p class="text-[11px] text-slate-500 italic truncate" title="${room.notes || ''}">"${room.notes || 'No extra notes.'}"</p>
                        </td>
                        <td class="py-4 px-6 font-bold text-slate-900 text-base">
                            ${room}
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="flex items-center justify-end space-x-2 text-slate-400">
                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-eye"></i></button>
                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-pen-to-square"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });

            updateCounters(dataset.length);
        }

        // Reactive UI text adjustments for table metrics counters
        function updateCounters(count) {
            document.getElementById('visibleCounter').innerText = `${count} type${count !== 1 ? 's' : ''} visible`;
            document.getElementById('showingIndicator').innerText = `Showing 1-${count} of ${count} items`;
        }

        // Filter Evaluation Engine 
        function applyFilters() {
            const typeValue = document.getElementById('filterRoomType').value;
            const statusValue = document.getElementById('filterStatus').value;
            const floorValue = document.getElementById('filterFloor').value;

            let filteredResult = mockRoomsDatabase.filter(room => {
                let matchesType = typeValue === "" || room.room_type_id == typeValue;
                let matchesStatus = statusValue === "" || room.room_status_id == statusValue;
                let matchesFloor = floorValue === "" || room.floor == floorValue;
                return matchesType && matchesStatus && matchesFloor;
            });

            renderRoomCards(filteredResult);
            toggleFilterDropdown(); 
        }

        // Clear filter panel state triggers
        function resetFilters() {
            document.getElementById('filterRoomType').value = "";
            document.getElementById('filterStatus').value = "";
            document.getElementById('filterFloor').value = "";
            renderRoomCards(mockRoomsDatabase);
            toggleFilterDropdown();
        }

        // Live client-side interactive search engine
        function searchTable() {
            const searchVal = document.getElementById('tableSearch').value.toLowerCase();
            let queryMatch = mockRoomsDatabase.filter(room => {
                return (room.category_name || '').toLowerCase().includes(searchVal) || 
                       (room.notes || '').toLowerCase().includes(searchVal) ||
                       (room.room_number || '').toString().toLowerCase().includes(searchVal);
            });
            renderRoomCards(queryMatch);
        }
    </script>
</body>
</html>