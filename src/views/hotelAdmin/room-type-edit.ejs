<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStay - Room Categories</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<style>
#toastContainer {
    position: fixed;
    top: 20px;
    right: 20px;

    display: flex;
    flex-direction: column;
    gap: 10px;

    z-index: 9999;

    pointer-events: none;
}

.toast {
    min-width: 300px;
    max-width: 450px;

    padding: 14px 18px;
    border-radius: 8px;

    color: white;
    font-size: 14px;
    font-weight: 500;

    box-shadow: 0 4px 12px rgba(0,0,0,.15);

    animation: slideIn .3s ease;

    pointer-events: auto;
}

.toast-success {
    background: #16a34a;
}

.toast-error {
    background: #dc2626;
}

.toast-warning {
    background: #f59e0b;
}

.toast-info {
    background: #2563eb;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}


    
</style>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
<div id="toastContainer"></div>
    <div class="flex flex-1 flex-col md:flex-row">
        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-white border-r border-slate-200 flex flex-col justify-between p-4 shrink-0">
            <div>
                <div class="text-2xl font-bold text-[#0f172a] tracking-tight px-3 py-4">
                    LuxeStay
                </div>
                
                <nav class="mt-4 space-y-1">
                    <a href="/hotelAdmin/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-table-columns w-5 text-slate-400"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/hotelAdmin/rooms" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-bed w-5"></i>
                        <span>Rooms</span>
                    </a>
                    <a href="/hotelAdmin/room-types/new" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-white text-sm bg-[#1e293b]  font-medium  text-slate-600  transition">
                        <i class="fa-solid fa-calendar-days w-5 text-slate-400"></i>
                        <span>Rooms Types </span>
                    </a>
                    <a href="/hotelAdmin/staff" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-address-book w-5 text-slate-400"></i>
                        <span>Staff</span>
                    </a>
                    <a href="/hotelAdmin/policies/new" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-chart-simple w-5 text-slate-400"></i>
                        <span>Cancellation Policy</span>
                    </a>
                    
                </nav>
            </div>

            <div class="mt-8 pt-4 border-t border-slate-100 space-y-1">
                
                 <a href="/frontdesk/logout" class="flex items-center space-x-3 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition">
                    <i class="fa-regular fa-circle-question w-5 text-slate-400"></i>
                    <span>Logout</span>
                </a>
                
<script>





</script>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="flex-1 flex flex-col">
            <%- include('../partials/header') %>

            <div class="p-6 md:p-8 space-y-6 max-w-[1600px] w-full mx-auto">
                
                <!-- Controls and Actions Header -->
             

                <!-- KPI Metric Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Categories</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900">12</span>
                            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">+1 New</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Avg. Base Price</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900">$420</span>
                            <span class="text-xs font-medium text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded">Peak Season</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active Inventory</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900">184</span>
                            <span class="text-xs text-slate-500">Rooms Total</span>
                        </div>
                    </div>
                    <div class="bg-[#0f172a] p-5 rounded-xl border border-slate-800 shadow-sm text-white">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">RevPAR Forecast</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-white">$312.45</span>
                            <span class="text-xs text-slate-400"><i class="fa-solid fa-chart-line"></i></span>
                        </div>
                    </div>
                </div>

                <!-- Inventory Data Sheet -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">

    <!-- Header -->
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <div>
            <h2 class="text-lg font-semibold text-slate-800">
                Edit Room Category & Amenities
            </h2>
            <p class="text-sm text-slate-500">
                Update room category details, pricing, capacity and amenities.
            </p>
        </div>

        <div>
            <span class="px-3 py-1 text-xs font-semibold rounded-md bg-violet-100 text-violet-700">
                ROOM TYPE #<%= roomType.room_type_id %>
            </span>
        </div>
    </div> 
    <form
        id="editRoomTypeForm"
       
        class="p-6">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- LEFT COLUMN -->
            <div class="space-y-5">

                <!-- Room Type Name -->
                <div>
                    <label class="block text-xs font-semibold tracking-wide uppercase text-slate-600 mb-2">
                        Category Class Name
                    </label>

                    <input
                        type="text"
                        name="type_name"
                        required
                        id="type_name" 
                        value="<%= roomType.type_name %>"
                        class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <!-- Pricing -->
                <div class="grid grid-cols-2 gap-4">

                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-600 mb-2">
                            Base Rate Price
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            id="base_price"
                            name="base_price"
                            value="<%= roomType.base_price %>"
                            class="w-full px-4 py-3 border border-slate-300 rounded-lg">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-600 mb-2">
                            Max Adults Capacity
                        </label>

                        <input
                            type="number"
                            name="max_adults"
                            id="max_adults"
                            value="<%= roomType.max_adults %>"
                            class="w-full px-4 py-3 border border-slate-300 rounded-lg">
                    </div>

                </div>

                <!-- Children -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-2">
                        Max Children Capacity
                    </label>

                    <input
                        type="number"
                        name="max_children"
                        value="<%= roomType.max_children %>"
                        id="max_children" 
                        class="w-full px-4 py-3 border border-slate-300 rounded-lg">
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-2">
                        Marketing Description
                    </label>

                    <textarea
                        name="description"
                        rows="6",
                        id="description"
        
                        value="<%= roomType.description%>"
                        class="w-full px-4 py-3 border border-slate-300 rounded-lg resize-none"><%= roomType.description || '' %></textarea>
                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="space-y-5">

                <!-- Amenities -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-3">
                        Allocate Category Feature Amenities
                    </label>

                    <div class="border border-slate-300 rounded-lg p-4">

                        <div class="grid grid-cols-2 gap-3">
                            <% amenities.forEach(amenity => { %>
                                
                                <label class="flex items-center gap-3 cursor-pointer">

                                    <input
                                        type="checkbox"
                                        name="amenities"
                                        value="<%= amenity.amenity_id %>"

                                        <%= roomType.amenities.some(
                                                a => a.amenity_id === amenity.amenity_id
                                            )
                                            ? 'checked'
                                            : '' %>

                                        class="h-4 w-4">

                                    <span class="text-sm text-slate-700">
                                        <%= amenity.amenity_name %>
                                    </span>

                                </label>

                            <% }) %>

                        </div>

                    </div>
                </div>

                <!-- Image Upload -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-3">
                        Visual Identity Media
                    </label>

                    <div class="border border-slate-300 rounded-lg p-4">

                        <div class="flex gap-4">

                            <!-- Preview -->
                            <div>
                                 <input type="hidden" name="existing_photo" value="<%= roomType.photo_url || '' %>">
                                <img id="imagePreview" src="<%= roomType.photo_url ||
                                 '/images/no-image.png' %>" class="h-28 w-28 rounded-lg border object-cover">
                            </div>

                            <!-- Upload -->
                            <div class="flex-1">

                                <input
                                    type="file"
                                    
                                    id="roomImage"
                                    name="  "
                                    accept="image/*"
                                    class="block w-full text-sm">

                                <p class="mt-2 text-xs text-slate-500">
                                    PNG, JPG, JPEG up to 5MB
                                </p>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Metadata -->
                <div class="border border-slate-200 rounded-lg p-4 bg-slate-50">

                    <div class="grid grid-cols-2 gap-4 text-sm">

                        <div>
                            <span class="text-slate-500 block">
                                Created
                            </span>

                            <span class="font-medium">
                                <%= roomType.created_at %>
                            </span>
                        </div>

                        <div>
                            <span class="text-slate-500 block">
                                Last Updated
                            </span>

                            <span class="font-medium">
                                <%= roomType.updated_at %>
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Footer -->
        <div class="mt-8 pt-6 border-t border-slate-200 flex justify-end gap-3">

            <a
                href="/hotelAdmin/room-types"
                class="px-5 py-3 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-100">
                Cancel
            </a>

            <button
                type="submit"
                class="px-6 py-3 bg-slate-900 text-white rounded-lg hover:bg-slate-800">
                Update Room Category
            </button>

        </div>

    </form>

</div>



                    <!-- Pagination / Footer Indicators -->
                    <div class="p-4 border-t border-slate-200 flex items-center justify-between flex-wrap gap-2 text-xs text-slate-500">
                        
                        <div class="flex items-center space-x-1">
                        </div>
                    </div>
                </div>

            </div>

            <!-- Page Footer -->
            <footer class="mt-auto bg-white border-t border-slate-200 py-6 px-6 md:px-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <div>
                    <span class="font-semibold text-slate-700">LuxeStay</span> &copy; 2026 LuxeStay Hospitality Group. All rights reserved.
                </div>
                <div class="flex items-center space-x-4">
                    <a href="#" class="hover:text-slate-800 transition">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Terms of Service</a>
                    <a href="#" class="hover:text-slate-800 transition">Cookie Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Accessibility</a>
                </div>
            </footer>
        </main>
    </div>
<script>
document.addEventListener("DOMContentLoaded", () => {

    const form = document.getElementById("editRoomTypeForm");
    const imageInput = document.getElementById("roomImage");
    const imagePreview = document.getElementById("imagePreview");

    if (!form) {
        console.error("Form not found");
        return;
    }

    const MAX_FILE_SIZE = 2 * 1024 * 1024;

    const ALLOWED_TYPES = [
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/webp"
    ];

    /*
    |--------------------------------------------------------------------------
    | Image Preview + Validation
    |--------------------------------------------------------------------------
    */
    imageInput?.addEventListener("change", function () {

        const file = this.files?.[0];

        if (!file) return;

        if (!ALLOWED_TYPES.includes(file.type)) {
            alert("Only JPG, PNG and WEBP images are allowed.");
            this.value = "";
            return;
        }

        if (file.size > MAX_FILE_SIZE) {
            alert("Image must be less than 2 MB.");
            this.value = "";
            return;
        }

        const previewUrl = URL.createObjectURL(file);

        imagePreview.src = previewUrl;

        imagePreview.onload = () => {
            URL.revokeObjectURL(previewUrl);
        };
    });

    /*
    |--------------------------------------------------------------------------
    | Form Submit
    |--------------------------------------------------------------------------
    */
    form.addEventListener("submit", updateRoomType);

    async function updateRoomType(event) {

        event.preventDefault();

        const submitBtn =
            form.querySelector('button[type="submit"]');

        try {

            submitBtn?.setAttribute("disabled", "true");

            const typeId =
                Number(window.location.pathname.split("/").pop());

            if (!Number.isInteger(typeId) || typeId <= 0) {
                throw new Error("Invalid room type ID.");
            }

            const typeName =
                document.getElementById("type_name");

            const basePrice =
                document.getElementById("base_price");

            const maxAdults =
                document.getElementById("max_adults");

            const maxChildren =
                document.getElementById("max_children");

            const description =
                document.getElementById("description");

            if (
                !typeName ||
                !basePrice ||
                !maxAdults ||
                !maxChildren ||
                !description
            ) {
                throw new Error(
                    "One or more form fields are missing."
                );
            }

            if (!typeName.value.trim()) {
                throw new Error("Room type name is required.");
            }

            if (!basePrice.value) {
                throw new Error("Base price is required.");
            }

            const formData = new FormData();

            formData.append(
                "type_name",
                typeName.value.trim()
            );

            formData.append(
                "base_price",
                basePrice.value
            );

            formData.append(
                "max_adults",
                maxAdults.value
            );

            formData.append(
                "max_children",
                maxChildren.value
            );

            formData.append(
                "description",
                description.value.trim()
            );
    formData.append("type_photo", document.querySelector('input[name="existing_photo"]').value);
            /*
            |--------------------------------------------------------------------------
            | Amenities
            |--------------------------------------------------------------------------
            */
            document.querySelectorAll('input[name="amenities"]:checked').forEach(input => {
    formData.append("amenities", input.value); // Changed from "amenities[]"
});

            /*
            |--------------------------------------------------------------------------
            | Image
            |--------------------------------------------------------------------------
            */
            const imageFile = imageInput?.files?.[0];

            if (imageFile) {
                formData.append(
                    "type_photo",
                    imageFile
                );
            }

            const response = await fetch(
                `/hotelAdmin/room-types/${typeId}`,
                {
                    method: "PUT",
                    body: formData
                }
            );

            let result = {};

            try {
                result = await response.json();
            } catch {
                result = {};
            }

            if (!response.ok) {
                throw new Error(
                    result.message || "Update failed."
                );
            }
await Swal.fire({
            icon: "success",
            title: "Success!",
            text: result.message || "Staff updated successfully.",
            confirmButtonText: "OK"
        });
            

            window.location.href =
                "/hotelAdmin/room-types/new";

        } catch (error) {

            console.error(error);   

            Swal.fire({
            icon: "error",
            title: "Update Failed",
            text: err.message || "An unexpected error occurred."
        });

        } finally {

            submitBtn?.removeAttribute("disabled");

        }
    }

});
</script>
</body>
</html>