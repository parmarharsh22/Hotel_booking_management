                        <div class="relative">
                            <input type="number"
                            type="number"
            
            name="free_cancellation_hours"
            placeholder="e.g. 24"
            required
            min="0"
            max="72"
            step="1"
            inputmode="numeric"
            autocomplete="off"
            class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition"
            onkeydown="return allowIntegerOnly(event)"
            oninput="validateHours(this)"
                            
                            
                            
                            
                            id="edit_free_cancellation_hours" min="0" step="1" placeholder="e.g. 24" required class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 pr-10 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition">
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-medium pointer-events-none">hrs</span>
                        </div>
                    </div>
                    <div>
                        <label for="edit_refund_percentage" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Refund Percentage</label>
                        <div class="relative">
                            <input type="number"
                            
                            type="number"
            
            name="refund_percentage"
            placeholder="e.g. 100"
            required
            min="0"
            max="100"
            step="0.01"
            inputmode="decimal"
            autocomplete="off"
            class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition"
            onkeydown="return allowDecimalOnly(event)"
            oninput="validatePercentage(this)"
                            
                            id="edit_refund_percentage" min="0" max="100" step="0.01" placeholder="e.g. 100" required class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 pr-10 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition">
