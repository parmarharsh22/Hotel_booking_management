                        <div>
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Mobile Contact Vector</label>
                            <div class="relative">
                                <i class="fa-solid fa-phone absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input type="tel" name="phone" placeholder="+1 (555) 000-0000" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2.5 outline-none focus:bg-white focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Primary Station City</label>
                            <div class="relative">
                                <i class="fa-solid fa-city absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
