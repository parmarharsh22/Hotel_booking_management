<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStay - Hotel Details</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50 text-gray-800 font-sans">


    <!-- ================= NAVBAR ================= -->

    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 px-6 py-3 shadow-sm">

        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">

            <a href="/" class="text-2xl font-bold text-slate-900">
                LuxeStay
            </a>


            <div
                class="hidden md:flex items-center bg-gray-100 border rounded-full px-4 py-2 text-sm divide-x divide-gray-300">

                <div class="px-3">
                    <i class="fa-solid fa-location-dot text-amber-700"></i>
                    <span class="font-medium capitalize">
                        <%= query.location || "Anywhere" %>
                    </span>
                </div>


                <div class="px-3">
                    <i class="fa-regular fa-calendar"></i>
                    In:
                    <strong>
                        <%= query.check_in || "--/--/--" %>
                    </strong>
                </div>


                <div class="px-3">
                    <i class="fa-regular fa-calendar"></i>
                    Out:
                    <strong>
                        <%= query.check_out || "--/--/--" %>
                    </strong>
                </div>


                <div class="px-3">
                    <i class="fa-solid fa-users"></i>

                    <%= query.adults || 1 %> Adults,
                        <%= query.children || 0 %> Children
                </div>

            </div>


            <% if(locals.user){ %>

                <img class="h-9 w-9 rounded-full object-cover border-2 border-amber-700"
                    src="<%= user.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde' %>">

                <% } else { %>

                    <a href="/login" class="bg-slate-900 text-white px-5 py-2 rounded-lg">

                        Log In / Sign Up

                    </a>

                    <% } %>

        </div>

    </nav>



    <!-- =============== HOTEL COVER =============== -->


    <div class="relative h-[350px] overflow-hidden">

        <img src="<%= hotel.cover_url || 'https://placehold.co/1200x400' %>" class="w-full h-full object-cover">


        <div class="absolute inset-0 bg-black/40"></div>


        <div class="absolute bottom-6 left-8 text-white">

            <h1 class="text-4xl font-bold">
                <%= hotel.name %>
            </h1>


            <p class="mt-2 text-lg">

                <i class="fa-solid fa-location-dot"></i>

                <%= hotel.address %>,
                    <%= hotel.city %>,
                        <%= hotel.state %>,
                            <%= hotel.country %>

            </p>

        </div>

    </div>



    <!-- =============== MAIN CONTENT =============== -->


    <div class="max-w-7xl mx-auto px-4 py-8">


        <div class="flex flex-col lg:flex-row gap-8">


            <!-- =============== ROOM SECTION =============== -->


            <div class="w-full lg:w-3/4">


                <h2 class="text-3xl font-bold mb-6">

                    Choose Your Room

                </h2>


                <% room_type.forEach(room=> { %>


                    <div class="bg-white rounded-2xl shadow-md border p-6 mb-6">


                        <!-- Header -->

                        <div class="flex justify-between">


                            <div>

                                <h3 class="text-2xl font-semibold">

                                    <%= room.type %>

                                </h3>


                                <p class="text-gray-600 mt-2">

                                    <%= room.description %>

                                </p>


                            </div>


                            <div class="text-right">

                                <div class="text-3xl font-bold text-blue-600">

                                    ₹<%= room.price %>

                                </div>


                                <span class="text-gray-500">

                                    per night

                                </span>


                            </div>

                        </div>



                        <!-- Amenities -->


                        <div class="my-5">


                            <h4 class="font-semibold mb-2">

                                Amenities

                            </h4>


                            <div class="flex flex-wrap gap-2">


                                <% room.amenities.forEach(am=> { %>


                                    <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm">

                                        <i class="fas fa-check"></i>

                                        <%= am %>

                                    </span>


                                    <% }) %>


                            </div>


                        </div>



                        <!-- Room Details -->


                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 border-t pt-4">


                            <!-- Adults -->


                            <div>

                                <p class="text-gray-500 text-sm">

                                    Adults

                                </p>


                                <p class="font-semibold">

                                    <i class="fa-solid fa-users"></i>


                                    <span id="<%= room.type %>-adults-count">

                                        <%= room.max_adults %>

                                    </span>


                                </p>

                            </div>



                            <!-- Children -->


                            <div>

                                <p class="text-gray-500 text-sm">

                                    Children

                                </p>


                                <p class="font-semibold">

                                    <i class="fa-solid fa-children"></i>


                                    <span id="<%= room.type %>-children-count">

                                        <%= room.max_children %>

                                    </span>


                                </p>

                            </div>
                            <!-- Available Rooms -->

                            <div>

                                <p class="text-gray-500 text-sm">
                                    Available
                                </p>

                                <p class="font-semibold text-green-600">
                                    <%= room.available_rooms %> Rooms
                                </p>

                            </div>


                            <!-- Room Selection -->

                            <div>

                                <p class="text-gray-500 text-sm">
                                    Select
                                </p>


                                <select class="border rounded-lg px-2 py-1 w-full room-select"
                                    data-price="<%= room.price %>" data-room-id="<%= room.room_type_id %>"
                                    data-room-type="<%= room.type %>">

                                    <% for(let i=0; i <=room.available_rooms; i++){ %>

                                        <option value="<%= i %>">
                                            <%= i %>
                                        </option>

                                        <% } %>

                                </select>

                            </div>


                        </div> <!-- End Room Details -->


                    </div> <!-- End Room Card -->


                    <% }) %>


            </div> <!-- End Left Section -->


            <!-- ================= RIGHT SIDEBAR ================= -->


            <div class="w-full lg:w-1/4">


                <div class="bg-white rounded-2xl shadow-lg border p-6 sticky top-24">


                    <div class="mb-5">

                        <h3 class="text-2xl font-bold">

                            Booking Summary

                        </h3>

                        <p class="text-sm text-gray-600">

                            (Based on rooms you have selected)

                        </p>

                    </div>


                    <!-- Dates -->


                    <div class="space-y-4">


                        <div>

                            <label class="block text-sm font-medium mb-1">

                                <i class="fa-regular fa-calendar"></i>

                                Check-In

                            </label>


                            <strong>
                                <%= query.check_in %>
                            </strong>

                        </div>



                        <div>

                            <label class="block text-sm font-medium mb-1">

                                <i class="fa-regular fa-calendar"></i>

                                Check-Out

                            </label>


                            <strong>
                                <%= query.check_out %>
                            </strong>


                        </div>



                        <!-- Selected Capacity -->


                        <div>

                            <label class="block text-sm font-medium mb-1">

                                <i class="fa-solid fa-users"></i>

                                Adults

                            </label>


                            <strong id="show-adults">

                                0

                            </strong>


                        </div>



                        <div>

                            <label class="block text-sm font-medium mb-1">

                                <i class="fa-solid fa-children"></i>

                                Children

                            </label>


                            <strong id="show-children">

                                0

                            </strong>


                        </div>


                    </div>


                    <!-- Selected Rooms -->


                    <div class="mt-6 border-t pt-4">


                        <h4 class="font-semibold mb-3">

                            Selected Rooms

                        </h4>


                        <div id="selectedRooms" class="text-sm text-gray-600">

                            No rooms selected


                        </div>


                    </div>



                    <!-- Total -->


                    <div class="mt-6 border-t pt-4">


                        <div class="flex justify-between items-center">


                            <span class="text-lg font-semibold">

                                Total

                            </span>


                            <span id="totalPrice" class="text-2xl font-bold text-blue-600">

                                ₹0

                            </span>


                        </div>


                    </div>



                    <!-- Booking Button -->


                    <button id="continue-to-book-btn" onclick="createHold()"
                        class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold transition">

                        Continue To Book

                    </button>


                </div>


            </div>


        </div>


    </div>


    <!-- ================= SERVER DATA ================= -->


    <script type="application/json" id="server-payload">

<%- JSON.stringify({

    hotelId: hotel.hotel_id,

    checkIn: query.check_in,

    checkOut: query.check_out,

    adults: query.adults,

    children: query.children

}) %>

</script>


    <!-- External JavaScript -->


    <script src="/JS/rooms/hotelDetails.js"></script>


</body>

</html>