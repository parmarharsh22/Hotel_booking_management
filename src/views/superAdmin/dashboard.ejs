<%
  pageTitle  = "Dashboard — HBMS";
  activePage = "dashboard";
%>
<%- include('_layout_start') %>

<div class="px-8 py-5 border-b border-surface-border flex items-center justify-between">
  <div>
    <h1 class="text-lg font-semibold ">Dashboard</h1>
    <p class="text-xs text-muted mt-0.5">Platform overview</p>
  </div>
  <span class="text-xs font-mono text-muted bg-surface-2 border border-surface-border px-3 py-1 rounded-full" id="live-time"></span>
</div>

<div class="px-8 py-6 space-y-6" id="dashboard-root">
  <div class="text-center text-muted py-20 text-sm">Loading dashboard...</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Live clock
  setInterval(() => {
    const el = document.getElementById('live-time');
    if (el) el.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
  }, 1000);

  const bookingStatusColors = {
    PENDING:     '#f59e0b',
    CONFIRMED:   '#4f8ef7',
    CHECKED_IN:  '#22c55e',
    CHECKED_OUT: '#64748b',
    CANCELLED:   '#ef4444',
  };

  const roomStatusColors = {
    AVAILABLE:   '#22c55e',
    OCCUPIED:    '#4f8ef7',
    DIRTY:       '#f59e0b',
    MAINTENANCE: '#ef4444',
  };

  function fmt(n) {
    return Number(n || 0).toLocaleString();
  }

  function fmtMoney(n) {
    return '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });
  }

  function fmtDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
  }

  function bookingBadge(status) {
    const colors = {
      PENDING:     'bg-yellow-950 border-yellow-800 text-yellow-300',
      CONFIRMED:   'bg-blue-950 border-blue-800 text-blue-300',
      CHECKED_IN:  'bg-green-950 border-green-800 text-green-300',
      CHECKED_OUT: 'bg-slate-800 border-slate-700 text-slate-400',
      CANCELLED:   'bg-red-950 border-red-800 text-red-300',
    };
    const cls = colors[status] || colors.PENDING;
    return `<span class="text-xs font-mono px-2 py-0.5 rounded-md border ${cls}">${status}</span>`;
  }

  async function loadDashboard() {
    try {
      const res  = await fetch('/superadmin/dashboard/stats');
      const d    = await res.json();

      document.getElementById('dashboard-root').innerHTML = `

        <!-- Top stat cards -->
        <div class="grid grid-cols-4 gap-4">
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-3">Total Hotels</p>
            <p class="text-3xl font-semibold text-accent">${fmt(d.hotels.total)}</p>
            <div class="flex gap-3 mt-3 text-xs text-muted">
              <span class="text-success">● ${fmt(d.hotels.active)} active</span>
              <span class="text-warning">● ${fmt(d.hotels.pending)} pending</span>
            </div>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-3">Total Users</p>
            <p class="text-3xl font-semibold ">${fmt(d.users.total)}</p>
            <div class="flex gap-3 mt-3 text-xs text-muted">
              <span>Admins: ${fmt(d.users.hotel_admins)}</span>
              <span>Guests: ${fmt(d.users.guests)}</span>
            </div>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-3">Total Bookings</p>
            <p class="text-3xl font-semibold ">${fmt(d.bookings.total)}</p>
            <div class="flex gap-3 mt-3 text-xs">
              <span class="text-success">● ${fmt(d.bookings.checked_in)} in-house</span>
              <span class="text-danger">● ${fmt(d.bookings.cancelled)} cancelled</span>
            </div>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-3">Total Rooms</p>
            <p class="text-3xl font-semibold ">${fmt(d.rooms.total)}</p>
            <div class="flex gap-3 mt-3 text-xs">
              <span class="text-success">● ${fmt(d.rooms.available)} free</span>
              <span class="text-accent">● ${fmt(d.rooms.occupied)} occupied</span>
            </div>
          </div>
        </div>

        <!-- Revenue cards -->
        <div class="grid grid-cols-3 gap-4">
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-2">Today's Revenue</p>
            <p class="text-2xl font-semibold text-success">${fmtMoney(d.revenue.today)}</p>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-2">This Month</p>
            <p class="text-2xl font-semibold text-accent">${fmtMoney(d.revenue.this_month)}</p>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-2">Pending Payments</p>
            <p class="text-2xl font-semibold text-warning">${fmtMoney(d.revenue.pending_payments)}</p>
          </div>
        </div>

        <!-- Charts row -->
        <div class="grid grid-cols-3 gap-4">
          <div class="card p-5 col-span-2">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Revenue — Last 7 Days</p>
            <canvas id="revenueChart" height="100"></canvas>
          </div>
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Booking Status</p>
            <canvas id="bookingDonut" height="180"></canvas>
          </div>
        </div>

        <!-- Room status + bookings chart row -->
        <div class="grid grid-cols-3 gap-4">
          <div class="card p-5">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Room Status</p>
            <canvas id="roomDonut" height="180"></canvas>
          </div>
          <div class="card p-5 col-span-2">
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Bookings — Last 7 Days</p>
            <canvas id="bookingChart" height="100"></canvas>
          </div>
        </div>

        <!-- Recent bookings table -->
        <div class="card overflow-hidden">
          <div class="px-6 py-4 border-b border-surface-border flex items-center justify-between">
            <h2 class="text-sm font-semibold ">Recent Bookings</h2>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-surface-border bg-surface-2 text-left">
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Reference</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Guest</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Hotel</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Check-in</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Check-out</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody>
              ${d.recentBookings.length === 0
                ? `<tr><td colspan="7" class="px-6 py-8 text-center text-muted">No bookings yet</td></tr>`
                : d.recentBookings.map(b => `
                  <tr class="table-row border-b border-surface-border last:border-0">
                    <td class="px-6 py-3.5 font-mono text-xs text-accent">${b.booking_reference}</td>
                    <td class="px-6 py-3.5 ">${b.first_name} ${b.last_name}</td>
                    <td class="px-6 py-3.5 text-slate-400 text-xs">${b.hotel_name}</td>
                    <td class="px-6 py-3.5 text-slate-400 text-xs">${fmtDate(b.checkin_date)}</td>
                    <td class="px-6 py-3.5 text-slate-400 text-xs">${fmtDate(b.checkout_date)}</td>
                    <td class="px-6 py-3.5  text-xs font-mono">${fmtMoney(b.total_amount)}</td>
                    <td class="px-6 py-3.5">${bookingBadge(b.status_name)}</td>
                  </tr>
                `).join('')
              }
            </tbody>
          </table>
        </div>
      `;

      buildCharts(d);

    } catch (err) {
      document.getElementById('dashboard-root').innerHTML =
        `<div class="text-center text-danger py-20 text-sm">Failed to load dashboard</div>`;
    }
  }

  function buildCharts(d) {
    const gridColor = '#2a3449';
    const textColor = '#64748b';

    // Fill missing dates for last 7 days
    function fillDates(data, valueKey) {
      const map = {};
      data.forEach(r => { map[r.date?.slice(0,10)] = Number(r[valueKey] || 0); });
      const labels = [], values = [];
      for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const key = d.toISOString().slice(0, 10);
        labels.push(d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }));
        values.push(map[key] || 0);
      }
      return { labels, values };
    }

    // Revenue line chart
    const rev = fillDates(d.revenueChart, 'revenue');
    new Chart(document.getElementById('revenueChart'), {
      type: 'line',
      data: {
        labels: rev.labels,
        datasets: [{
          label: 'Revenue',
          data: rev.values,
          borderColor: '#4f8ef7',
          backgroundColor: 'rgba(79,142,247,0.08)',
          borderWidth: 2,
          pointBackgroundColor: '#4f8ef7',
          pointRadius: 4,
          fill: true,
          tension: 0.4,
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: gridColor }, ticks: { color: textColor, font: { family: 'DM Mono', size: 11 } } },
          y: { grid: { color: gridColor }, ticks: { color: textColor, font: { family: 'DM Mono', size: 11 } } },
        }
      }
    });

    // Bookings bar chart
    const book = fillDates(d.bookingChart, 'count');
    new Chart(document.getElementById('bookingChart'), {
      type: 'bar',
      data: {
        labels: book.labels,
        datasets: [{
          label: 'Bookings',
          data: book.values,
          backgroundColor: 'rgba(79,142,247,0.5)',
          borderColor: '#4f8ef7',
          borderWidth: 1,
          borderRadius: 4,
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: gridColor }, ticks: { color: textColor, font: { family: 'DM Mono', size: 11 } } },
          y: { grid: { color: gridColor }, ticks: { color: textColor, font: { family: 'DM Mono', size: 11 }, stepSize: 1 } },
        }
      }
    });

    // Booking status donut
    new Chart(document.getElementById('bookingDonut'), {
      type: 'doughnut',
      data: {
        labels: ['Pending','Confirmed','Checked In','Checked Out','Cancelled'],
        datasets: [{
          data: [
            d.bookings.pending, d.bookings.confirmed,
            d.bookings.checked_in, d.bookings.checked_out, d.bookings.cancelled
          ],
          backgroundColor: ['#f59e0b','#4f8ef7','#22c55e','#64748b','#ef4444'],
          borderWidth: 0,
          hoverOffset: 6,
        }]
      },
      options: {
        cutout: '70%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: textColor, font: { family: 'DM Mono', size: 10 }, padding: 12, boxWidth: 10 }
          }
        }
      }
    });

    // Room status donut
    new Chart(document.getElementById('roomDonut'), {
      type: 'doughnut',
      data: {
        labels: ['Available','Occupied','Dirty','Maintenance'],
        datasets: [{
          data: [d.rooms.available, d.rooms.occupied, d.rooms.dirty, d.rooms.maintenance],
          backgroundColor: ['#22c55e','#4f8ef7','#f59e0b','#ef4444'],
          borderWidth: 0,
          hoverOffset: 6,
        }]
      },
      options: {
        cutout: '70%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: textColor, font: { family: 'DM Mono', size: 10 }, padding: 12, boxWidth: 10 }
          }
        }
      }
    });
  }

  loadDashboard();
</script>

<%- include('_layout_end') %>
