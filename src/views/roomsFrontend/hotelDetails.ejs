<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStay - Search Results</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 px-6 py-3 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">

            <div class="flex items-center">
                <a href="/" class="text-2xl font-bold text-slate-900 tracking-tight">
                    LuxeStay
                </a>
            </div>

            <div
                class="hidden md:flex items-center bg-gray-100 border border-gray-200 rounded-full px-4 py-2 shadow-sm divide-x divide-gray-300 text-sm max-w-2xl text-gray-600">
                <div class="px-3 flex items-center gap-2">
                    <i class="fa-solid fa-location-dot text-amber-700"></i>
                    <span class="font-medium text-gray-900 capitalize">
                        <%= query.location || 'Anywhere' %>
                    </span>
                </div>
                <div class="px-3 flex items-center gap-2">
                    <i class="fa-regular fa-calendar text-gray-400"></i>
                    <span>In: <strong class="text-gray-900">
                            <%= query.check_in || '--/--/--' %>
                        </strong></span>
                </div>
                <div class="px-3 flex items-center gap-2">
                    <i class="fa-regular fa-calendar text-gray-400"></i>
                    <span>Out: <strong class="text-gray-900">
                            <%= query.check_out || '--/--/--' %>
                        </strong></span>
                </div>
                <div class="px-3 flex items-center gap-2">
                    <i class="fa-solid fa-users text-gray-400"></i>
                    <span>
                        <%= query.adults || 1 %> Adults, <%= query.children || 1 %> Children, <%= query.rooms || 1 %> Room
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <% if (locals.user) { %>
                    <div class="flex items-center gap-2 cursor-pointer">
                        <img class="h-9 w-9 rounded-full object-cover border-2 border-amber-700 ring-offset-2"
                            src="<%= user.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80' %>"
                            alt="User Profile">
                    </div>
                    <% } else { %>
                        <a href="/login"
                            class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2 rounded-lg text-sm font-medium transition duration-200">
                            Log In / Sign Up
                        </a>
                        <% } %>
            </div>
        </div>
    </nav>
    <!-- Navbar here -->

<div class="w-full">
    <!-- Hotel Cover -->
    <div class="relative h-[350px] overflow-hidden">
        <img
            src="<%= hotel.cover_url || 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQhqdlViIUkJ2bok1KrNh2jPWMmm-Rh70DfQQ&s' %>"
            alt="<%= hotel.name %>"
            class="w-full h-full object-cover"
        />

        <div class="absolute inset-0 bg-black/40"></div>

        <div class="absolute bottom-6 left-8 text-white">
            <h1 class="text-4xl font-bold">
                <%= hotel.name %>
            </h1>

            <p class="mt-2 text-lg flex items-center gap-2">
                <i class="fas fa-location-dot"></i>
                <%= hotel.address %>,
                <%= hotel.city %>,
                <%= hotel.state %>,
                <%= hotel.country %>
            </p>
        </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex flex-col lg:flex-row gap-8">

            <!-- Left Section -->
            <div class="w-full lg:w-3/4">

                <h2 class="text-3xl font-bold text-gray-800 mb-6">
                    Choose Your Room
                </h2>

                <% room_type.forEach(room => { %>

                    <div
                        class="bg-white rounded-2xl shadow-md border border-gray-200 p-6 mb-6 hover:shadow-lg transition"
                    >

                        <!-- Room Header -->
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-2xl font-semibold text-gray-800">
                                    <%= room.type %>
                                </h3>

                                <p class="text-gray-600 mt-2">
                                    <%= room.description %>
                                </p>
                            </div>

                            <div class="text-right">
                                <div class="text-3xl font-bold text-blue-600">
                                    ₹<%= room.price %>
                                </div>

                                <span class="text-sm text-gray-500">
                                    per night
                                </span>
                            </div>
                        </div>

                        <!-- Amenities -->  
                        <div class="mb-5">
                            <h4 class="font-semibold mb-2 text-gray-700">
                                Amenities
                            </h4>

                            <div class="flex flex-wrap gap-2">
                                <% room.amenities.forEach(am => { %>
                                    <span
                                        class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm"
                                    >
                                        <i class="fas fa-check mr-1"></i>
                                        <%= am %>
                                    </span>
                                <% }) %>
                            </div>
                        </div>

                        <!-- Room Details -->
                        <div
                            class="grid grid-cols-2 md:grid-cols-4 gap-4 border-t pt-4"
                        >
                            <div>
                                <p class="text-gray-500 text-sm">
                                    Adults
                                </p>
                                <p class="font-semibold">
                                    <i class="fa-solid fa-users text-gray-800"></i>
                                    <span id="<%=room.type%>-adults-count"><%= room.max_adults %></span>
                                </p>
                            </div>

                            <div>
                                <p class="text-gray-500 text-sm">
                                    Children
                                </p>
                                <p class="font-semibold">
                                    <i class="fa-solid fa-children text-gray-800"></i>
                                    <span id="<%=room.type%>-children-count"><%= room.max_children %></span>
                                </p>
                            </div>

                            <div>
                                <p class="text-gray-500 text-sm">
                                    Available
                                </p>
                                <p class="font-semibold text-green-600">
                                    <%= room.available_rooms %> Rooms
                                </p>
                            </div>

                            <div>
                                <p class="text-gray-500 text-sm">
                                    Select
                                </p>

                                <select
                                    class="border rounded-lg px-2 py-1 w-full room-select"
                                    data-price="<%= room.price %>"
                                    data-room-type-id="<%= room.room_type_id %>"
                                    data-room-type="<%=room.type%>"
                                >
                                    <% for(let i=0; i<=room.available_rooms; i++){ %>
                                        <option value="<%= i %>">
                                            <%= i %>
                                        </option>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                    </div>

                <% }) %>

            </div>

            <!-- Right Sidebar -->
            <div class="w-full lg:w-1/4">

                <div
                    class="bg-white rounded-2xl shadow-lg border p-6 sticky top-24"
                >
                <div class="mb-5">
                    <h3 class="text-2xl font-bold">
                        Booking Summary
                    </h3>
                    <p class="text-sm">(Based on rooms you have selected)</p>
                </div>

                    <!-- Dates -->
                    <div class="space-y-4">

                        <div>
                            <label class="block text-sm font-medium mb-1">
                                <i class="fa-regular fa-calendar text-gray-800"></i> Check-In
                            </label>

                           <span><strong class="text-gray-900">
                            <%= query.check_in || '--/--/--' %>
                            </strong></span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">
                               <i class="fa-regular fa-calendar text-gray-800"></i> Check-Out
                            </label>

                            <span><strong class="text-gray-900">
                            <%= query.check_out || '--/--/--' %>
                            </strong></span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">
                                <i class="fa-solid fa-users text-gray-800"></i> Adults
                            </label>

                            <span><strong id="show-adults"></strong></span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">
                                <i class="fa-solid fa-children text-gray-800"></i> Children
                            </label>

                            <span><strong id="show-children"></strong></span>
                        </div>
                    </div>

                    <!-- Selected Rooms -->
                    <div class="mt-6 border-t pt-4">
                        <h4 class="font-semibold mb-3">
                            Selected Rooms
                        </h4>

                        <div
                            id="selectedRooms"
                            class="text-sm text-gray-600"
                        >
                            No rooms selected
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="mt-6 border-t pt-4">
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-semibold">
                                Total
                            </span>

                            <span
                                id="totalPrice"
                                class="text-2xl font-bold text-blue-600"
                            >
                                ₹0
                            </span>
                        </div>
                    </div>

                    <!-- Button -->
                    <p
                        class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold transition flex justify-center"
                        id="continue-to-book-btn"
                    >
                        Continue To Book
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="application/json" id="server-payload">
    <%-
    JSON.stringify({
        hotel_name:hotel.name,
        address:hotel.address,
        city:hotel.city,
        state:hotel.state,
        country:hotel.country,
        hotelId:query.hotel_id,
        checkIn:query.check_in,
        checkOut:query.check_out,
        adults:query.adults,
        children:query.children,
        price_filter:query.price_filter,
        roomTypes:query.roomTypes,
        amenities:query.amenities
    })
    %>
</script>
<script src="/JS/rooms/hotelDetails.js"></script>
</body>
</html>