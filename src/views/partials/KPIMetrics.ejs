 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Rooms</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900"><%=rooms.length%></span>
                            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded"><%=rooms.filter(room => room.status_name === "AVAILABLE").length%> Available</span>
                        </div>
                    </div>



                    <%
const totalRooms = rooms.length;

const occupiedRooms = rooms.filter(
    room => room.status_name === "OCCUPIED"
).length;

const occupancyRate =
    totalRooms > 0
        ? Math.round((occupiedRooms / totalRooms) * 100)
        : 0;
%>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Occupancy Rate</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900"><%= occupancyRate %>%</span>
                            <span class="text-xs font-medium text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded"> <%= occupiedRooms %> of <%= totalRooms %> rooms occupied</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
        <div
            class="h-2 bg-amber-500 rounded-full"
            style="width:<%= occupancyRate %>%"
        ></div>
    </div>
                    </div>

<%
const potentialRevenue = rooms.reduce((total, room) => {
    return total + Number(room.base_price);
}, 0);
%>

                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Potenatial Revenue</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-slate-900"> ₹<%= potentialRevenue.toLocaleString('en-IN') %></span>
                            <span class="text-xs text-slate-500">Rooms Total</span>
                        </div>
                    </div>


<%
const currentRevenue = rooms.reduce((total, room) => {
    if (room.status_name === "OCCUPIED") {
        return total + Number(room.base_price);
    }

    return total;
}, 0);
%>

                    <div class="bg-[#0f172a] p-5 rounded-xl border border-slate-800 shadow-sm text-white">
                    
                    
                    
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider"> Current Revenue</p>
                        <div class="flex items-baseline space-x-2 mt-2">
                            <span class="text-2xl font-bold text-white"> ₹$<%= currentRevenue.toLocaleString('en-IN') %></span>
                            <span class="text-xs text-slate-400"><i class="fa-solid fa-chart-line"></i></span>
                        </div>
                    </div>
                </div>

