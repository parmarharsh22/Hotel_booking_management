<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxeStay - Search Results</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600&display=swap');

    body {
      font-family: 'Inter', sans-serif;
      background: #f8f7f4;
    }

    .heading {
      font-family: 'Playfair Display', serif;
    }

    /* Navbar */
    .nav-blur {
      backdrop-filter: blur(20px);
      background: rgba(255, 255, 255, 0.96);
    }

    /* Sidebar */
    .filter-sidebar {
      position: sticky;
      top: 82px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
    }

    .filter-sidebar::-webkit-scrollbar {
      width: 3px;
    }

    .filter-sidebar::-webkit-scrollbar-thumb {
      background: #e2e8f0;
      border-radius: 4px;
    }

    input[type="range"] {
      accent-color: #b45309;
    }

    input[type="checkbox"] {
      accent-color: #b45309;
    }

    .filter-btn {
      background: linear-gradient(135deg, #b45309, #92400e);
      transition: all 0.2s;
    }

    .filter-btn:hover {
      background: linear-gradient(135deg, #92400e, #78350f);
      box-shadow: 0 6px 20px rgba(180, 83, 9, 0.35);
    }

    /* Hotel card */
    .hotel-card {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      background: white;
    }

    .hotel-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.10);
    }

    .hotel-img {
      transition: transform 0.5s ease;
    }

    .hotel-card:hover .hotel-img {
      transform: scale(1.05);
    }

    /* Amenity tag in card */
    .amenity-tag {
      background: #fef3e2;
      color: #92400e;
      border: 1px solid #fde3b8;
    }

    /* Sort label */
    .sort-chip {
      transition: all 0.15s;
    }

    .sort-chip:hover {
      color: #b45309;
    }

    /* Book btn */
    .book-now-btn {
      background: linear-gradient(135deg, #b45309, #92400e);
      transition: all 0.2s ease;
    }

    .book-now-btn:hover {
      background: linear-gradient(135deg, #92400e, #78350f);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(180, 83, 9, 0.4);
    }

    /* User dropdown */
    .user-dropdown {
      opacity: 0;
      visibility: hidden;
      transition: all 0.15s ease;
    }

    .user-wrap:hover .user-dropdown {
      opacity: 1;
      visibility: visible;
    }

    /* Available pulse */
    @keyframes pulse-dot {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: .4
      }
    }

    .pulse-dot {
      animation: pulse-dot 1.8s ease-in-out infinite;
    }
  </style>
</head>

<body class="text-slate-800">

  <!-- ═══════════════ NAVBAR ═══════════════ -->
  <nav class="nav-blur border-b border-slate-200/80 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-6">

      <a href="/" class="text-2xl font-bold tracking-tight heading shrink-0">
        Luxe<span class="text-amber-700">Stay</span>
      </a>

      <!-- Search pill -->
      <div
        class="hidden lg:flex items-center rounded-full border border-slate-200 bg-white shadow-md hover:shadow-lg transition-shadow duration-200 divide-x divide-slate-200 text-sm">
        <div class="px-4 py-2.5 flex items-center gap-2">
          <i class="fa-solid fa-location-dot text-amber-700 text-xs"></i>
          <span class="font-semibold text-slate-900 capitalize">
            <%= query.location || "Anywhere" %>
          </span>
        </div>
        <div class="px-4 py-2.5 flex items-center gap-2 text-slate-600">
          <i class="fa-regular fa-calendar text-slate-400 text-xs"></i>
          <span><strong class="text-slate-900">
              <%= query.checkIn || "--" %>
            </strong></span>
          <i class="fa-solid fa-arrow-right text-slate-300 text-xs"></i>
          <strong class="text-slate-900">
            <%= query.checkOut || "--" %>
          </strong>
        </div>
        <div class="px-4 py-2.5 flex items-center gap-2 text-slate-600">
          <i class="fa-solid fa-users text-slate-400 text-xs"></i>
          <span>
            <%= query.adults || 1 %> Adult<%= (query.adults || 1)> 1 ? "s" : "" %>,
                <%= query.children || 0 %> Children,
                  <%= query.rooms || 1 %> Room<%= (query.rooms || 1)> 1 ? "s" : "" %>
          </span>
        </div>
      </div>

      <!-- User -->
      <div class="flex items-center shrink-0">
        <% if (locals.user) { %>
          <div class="user-wrap relative">
            <button
              class="flex items-center gap-2 rounded-full border border-slate-200 px-2 py-1.5 bg-white hover:shadow-md transition-shadow">
              <img id="user-profile-photo" class="h-8 w-8 rounded-full object-cover ring-2 ring-amber-700 ring-offset-1"
                src="/images/default-avatar.png" alt="User">
              <i class="fa-solid fa-chevron-down text-xs text-slate-400 mr-1"></i>
            </button>
            <div
            `  class="user-dropdown absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden z-50">
              <div class="px-4 py-3 bg-slate-50 border-b border-slate-100">
             <p id="user-name" class="font-semibold text-slate-900">
    <%= user.name || "Guest" %>
</p>

<p id="user-email" class="text-xs text-slate-500 truncate">
    <%= user.email || "" %>
</p>
              </div>
              <a href="/bookings/all"
                class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 text-sm text-slate-700 transition">
                <i class="fa-solid fa-bed text-slate-400 w-4 text-center"></i> My Bookings
              </a>
              <a href="/authen/logout"
                class="flex items-center gap-3 px-4 py-3 hover:bg-red-50 text-sm text-red-600 transition border-t border-slate-100">
                <i class="fa-solid fa-right-from-bracket w-4 text-center"></i> Logout
              </a>
            </div>
          </div>
          <% } else { %>
            <a href="/login"
              class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-full font-medium text-sm transition shadow-sm">
              Log In / Sign Up
            </a>
            <% } %>
      </div>

    </div>
  </nav>

  <!-- ═══════════════ MAIN ═══════════════ -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8">

    <!-- ════ SIDEBAR FILTERS ════ -->
    <aside class="filter-sidebar w-full lg:w-72 shrink-0">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
          <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-sliders text-amber-700 text-sm"></i>
            Filters
          </h2>
          <button class="text-xs text-amber-700 font-semibold hover:text-amber-900 transition">Clear All</button>
        </div>

        <form action="/rooms/searchHotels" method="POST" class="p-5 space-y-6">
          <input type="hidden" name="location" value="<%= query.location %>">
          <input type="hidden" name="checkIn" value="<%= query.checkIn %>">
          <input type="hidden" name="checkOut" value="<%= query.checkOut %>">
          <input type="hidden" name="adults" value="<%= query.adults %>">
          <input type="hidden" name="children" value="<%= query.children %>">
          <input type="hidden" name="rooms" value="<%= query.rooms %>">

          <!-- Price Range -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <label class="text-sm font-semibold text-slate-700">Price per Night</label>
              <span id="price-display"
                class="text-sm font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200">
                ₹7,750
              </span>
            </div>
            <input type="range" id="price-slider" name="priceFilter" min="500" max="15000"
              value="<%= query.priceFilter || 7750 %>" class="w-full h-1.5 rounded-full cursor-pointer"
              oninput="updatePrice(this.value)">
            <div class="flex justify-between text-xs text-slate-400 mt-2">
              <span>₹500</span><span>₹15,000+</span>
            </div>
          </div>

          <!-- Room Types -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-3">Room Type</label>
            <div class="space-y-2.5">
              <% const selectedRooms=query.roomTypesFilter || []; %>
                <% roomTypes.forEach(function(ele){ %>
                  <label class="flex items-center gap-3 text-sm text-slate-600 cursor-pointer group">
                    <input type="checkbox" name="roomTypesFilter[]" value="<%= ele.type_name %>"
                      class="rounded border-slate-300 h-4 w-4 cursor-pointer" <%=selectedRooms.includes(ele.type_name)
                      ? 'checked' : '' %>>
                    <span class="group-hover:text-slate-900 transition">
                      <%= ele.type_name %>
                    </span>
                  </label>
                  <% }) %>
            </div>
          </div>

          <!-- Amenities -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-3">Amenities</label>
            <div class="space-y-2.5">
              <% const selectedAmenities=query.amenitiesFilter || []; %>
                <% amenities.forEach(function(ele){ %>
                  <label class="flex items-center gap-3 text-sm text-slate-600 cursor-pointer group">
                    <input type="checkbox" name="amenitiesFilter[]" value="<%= ele.amenity_id %>"
                      class="rounded border-slate-300 h-4 w-4 cursor-pointer"
                      <%=selectedAmenities.includes(ele.amenity_id.toString()) ? 'checked' : '' %>>
                    <span class="group-hover:text-slate-900 transition">
                      <%= ele.amenity_name %>
                    </span>
                  </label>
                  <% }) %>
            </div>
          </div>

          <button type="submit" class="filter-btn w-full text-white py-3 rounded-xl text-sm font-semibold shadow-sm">
            Apply Filters
          </button>
        </form>
      </div>
    </aside>

    <!-- ════ RESULTS ════ -->
    <section class="flex-1 min-w-0">

      <!-- Results header -->
      <div
        class="bg-white rounded-2xl border border-slate-200 shadow-sm px-5 py-4 mb-6 flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold text-slate-900 heading">
            <%= hotels.length> 0 ? 'Available Stays' : 'No Results Found' %>
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            <span class="font-semibold text-slate-800">
              <%= hotels.length %>
            </span>
            properties in
            <span class="font-semibold text-slate-800">
              <%= query.location || 'your destination' %>
            </span>
          </p>
        </div>
        <div class="text-sm text-slate-500 flex items-center gap-2">
          Sort by:
          <span id="sortToggle" class="sort-chip font-semibold text-slate-800 cursor-pointer flex items-center gap-1">
            Price <i id="sortIcon" class="fa-solid fa-chevron-down text-xs"></i>
          </span>
        </div>
      </div>

      <!-- Empty state -->
      <% if (hotels.length===0) { %>
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-16 text-center shadow-sm">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-amber-50 text-amber-700 mb-5">
            <i class="fa-solid fa-hotel text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 heading">No accommodations found</h3>
          <p class="text-slate-500 text-sm max-w-md mx-auto leading-relaxed">
            We couldn't find available properties for
            <strong>
              <%= query.adults || 1 %> Adults, <%= query.children || 0 %> Children, <%= query.rooms || 1 %> Room
            </strong>
            in <strong>
              <%= query.location %>
            </strong>. Try adjusting your filters or dates.
          </p>
          <a href="/"
            class="mt-6 inline-block bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 rounded-full text-sm font-medium transition">
            Start a new search
          </a>
        </div>

        <% } else { %>
          <%hotels=hotels.sort((a,b)=>a.starting_price-b.starting_price)%>
            <div id="hotelContainer" class="space-y-5">
              <% hotels.forEach(function(hotel){ %>
                <div data-hotel-id="<%= hotel.hotel_id %>" data-hotel-name="<%= hotel.name %>"
                  data-price="<%= hotel.starting_price %>"
                  class="hotel-card view-hotel-details rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col md:flex-row cursor-pointer">

                  <!-- Image -->
                  <div class="w-full md:w-[38%] h-56 md:h-auto relative bg-slate-100 overflow-hidden shrink-0">
                    <img
                      src="<%= hotel.logo_url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80' %>"
                      alt="<%= hotel.name %>" class="hotel-img w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                    <span
                      class="absolute top-3 left-3 bg-slate-900/75 backdrop-blur-sm text-white text-xs uppercase font-bold tracking-wider px-2.5 py-1 rounded-lg">
                      Top Rated
                    </span>
                    <!-- Available rooms badge bottom -->
                    <div
                      class="absolute bottom-3 left-3 flex items-center gap-1.5 bg-emerald-950/80 backdrop-blur-sm text-emerald-400 text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-emerald-800/60">
                      <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-emerald-400 inline-block"></span>
                      <%= hotel.available_rooms %> Rooms Left
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="flex-1 p-6 flex flex-col justify-between">
                    <div>
                      <!-- Name + Rating -->
                      <div class="flex items-start justify-between gap-3 mb-1">
                        <h3
                          class="text-xl font-bold text-slate-900 hover:text-amber-700 transition heading leading-snug">
                          <%= hotel.name %>
                        </h3>
                        <span
                          class="flex items-center gap-1 shrink-0 bg-amber-50 text-slate-900 text-sm font-bold px-2.5 py-1 rounded-lg border border-amber-200">
                          4.8 <i class="fa-solid fa-star text-amber-600 text-xs"></i>
                        </span>
                      </div>

                      <!-- Location -->
                      <p class="text-sm text-slate-500 flex items-center gap-1.5 mb-4">
                        <i class="fa-solid fa-location-dot text-slate-400 text-xs"></i>
                        <%= hotel.city %>, <%= hotel.state %>, <%= hotel.country %>
                      </p>
                    </div>

                    <!-- Price + Actions -->
                    <div class="border-t border-slate-100 pt-4 flex items-end justify-between gap-4">
                      <div>
                        <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold mb-1">Starting From</p>
                        <p class="text-3xl font-black text-slate-900 heading">
                          ₹<%= Math.floor(hotel.starting_price).toLocaleString('en-IN') %>
                            <span class="text-base font-medium text-slate-500">/night</span>
                        </p>
                      </div>

                      <div class="flex items-center gap-2 shrink-0">
                        <div data-hotel-id="<%= hotel.hotel_id %>" data-hotel-name="<%= hotel.name %>"
                          class="view-hotel-details border border-slate-300 hover:border-slate-400 hover:bg-slate-50 text-slate-700 text-sm font-semibold px-4 py-2.5 rounded-xl transition cursor-pointer">
                          View Details
                        </div>
                        <a href="/checkout?hotel_id=<%= hotel.hotel_id %>"
                          class="book-now-btn text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm">
                          Book Now
                        </a>
                      </div>
                    </div>

                  </div>
                </div>
                <% }) %>
            </div>
            <% } %>

    </section>
  </main>

  <!-- Server payload (preserved) -->
  <script type="application/json" id="server-payload">
<%- JSON.stringify({
    location: query.location,
    checkIn: query.checkIn,
    checkOut: query.checkOut,
    rooms: query.rooms,
    adults: query.adults,
    children: query.children,
    priceFilter: query.priceFilter,
    roomTypesFilter: query.roomTypesFilter,
    amenitiesFilter: query.amenitiesFilter
}) %>
</script>

  <script>
    function updatePrice(value) {
      const display = document.getElementById('price-display');
      const formatted = new Intl.NumberFormat('en-IN', {
        style: 'currency', currency: 'INR', maximumFractionDigits: 0
      }).format(value);
      display.textContent = value === "15000" ? `${formatted}+` : formatted;
    }
    document.addEventListener("DOMContentLoaded", () => {
      const slider = document.getElementById('price-slider');
      if (slider) updatePrice(slider.value);
    });

    document.addEventListener("DOMContentLoaded", fetchUserDetails);

    async function fetchUserDetails() {
      try {

        const response = await fetch("/authen/fetchUserDetails", {
          credentials: "include"
        });

        if (!response.ok) return;

        const data = await response.json();

        const user = data.data || data.user || data;

        if (!user) return;

        const profilePhoto = document.getElementById("user-profile-photo");

        if (profilePhoto) {
          profilePhoto.src = `/uploads/profile-photos/${user.photo_url}`;
        }
        document.getElementById("user-name").textContent =
          `${user.first_name} ${user.last_name}`;

        document.getElementById("user-email").textContent =
          user.email;

      } catch (err) {
        console.error("Failed to fetch user:", err);
      }
    }

  </script>
  <script src="/JS/rooms/searchResults.js"></script>

</body>

</html>