<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Invoice History</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="/socket.io/socket.io.js"></script>

</head>

<body>

    <%- include("../partials/frontDesk/sidebar") %>

        <main class="ml-[260px] min-h-screen bg-slate-100">

            <%- include("../partials/frontDesk/header") %>

                <!-- hero -->

                <div class="px-8 py-6">

                    <div class="bg-gradient-to-r from-[#031632] via-[#0c234d] to-[#1a2b48]
                rounded-3xl shadow-xl p-8">

                        <h1 class="text-4xl font-bold text-white">

                            Invoice History

                        </h1>

                        <p class="text-yellow-300 mt-3 text-lg">

                            View all invoices generated for hotel bookings

                        </p>

                    </div>

                </div>

                <div class="p-8">

                    <!-- booking information -->

                    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 mb-6">

                        <div class="px-6 py-5 border-b">

                            <h2 class="font-semibold text-lg">

                                Booking Information

                            </h2>

                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 p-6">

                            <% invoices.forEach(invoice=> { %>

                                <div>

                                    <p class="text-sm text-slate-500">

                                        Booking Reference

                                    </p>

                                    <p class="font-semibold">

                                        <%= invoice.booking_reference %>

                                    </p>

                                </div>

                                <div>

                                    <p class="text-sm text-slate-500">

                                        Guest

                                    </p>

                                    <p class="font-semibold">

                                        <%= invoice.guest_name %>

                                    </p>

                                </div>

                                <div>

                                    <p class="text-sm text-slate-500">

                                        Room Number

                                    </p>

                                    <p class="font-semibold">

                                        <%= invoice.room_number %>

                                    </p>

                                </div>

                                <div>

                                    <p class="text-sm text-slate-500">

                                        Invoice ID

                                    </p>

                                    <p class="font-semibold">

                                        #<%= invoice.invoice_id %>

                                    </p>

                                </div>

                                <% }) %>

                        </div>

                    </div>

                    <!-- invoice history -->

                    <div class="bg-white rounded-2xl shadow-lg border border-slate-200">

                        <div class="px-6 py-5 border-b">

                            <h2 class="font-semibold text-lg">

                                Invoice Details

                            </h2>

                        </div>

                        <div class="overflow-x-auto">

                            <table class="min-w-full">

                                <thead class="bg-slate-100">

                                    <tr>

                                        <th class="px-6 py-4 text-left">

                                            Invoice ID

                                        </th>

                                        <th class="px-6 py-4 text-left">

                                            Room Charges

                                        </th>

                                        <th class="px-6 py-4 text-left">

                                            Incidentals

                                        </th>

                                        <th class="px-6 py-4 text-left">

                                            Tax

                                        </th>

                                        <th class="px-6 py-4 text-left">

                                            Total Amount

                                        </th>

                                        <th class="px-6 py-4 text-left">

                                            Generated On

                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% invoices.forEach(invoice=>{ %>

                                        <tr class="border-t hover:bg-slate-50">

                                            <td class="px-6 py-4">

                                                #<%= invoice.invoice_id %>

                                            </td>

                                            <td class="px-6 py-4">

                                                ₹ <%= invoice.room_charges %>

                                            </td>

                                            <td class="px-6 py-4">

                                                ₹ <%= invoice.incidentals %>

                                            </td>

                                            <td class="px-6 py-4">

                                                ₹ <%= invoice.tax_amount %>

                                            </td>

                                            <td class="px-6 py-4 font-semibold text-green-700">

                                                ₹ <%= invoice.total_amount %>

                                            </td>

                                            <td class="px-6 py-4">

                                                <%= new Date(invoice.generated_at).toLocaleString() %>

                                            </td>

                                        </tr>

                                        <% }) %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

        </main>

</body>

</html>