<!-- partials/incidental_form.ejs -->

<div class="bg-white rounded-2xl shadow-lg border border-slate-200">

    <div class="px-6 py-5 border-b bg-gradient-to-r from-[#031632] to-[#1a2b48]">

        <h2 class="text-lg font-semibold text-white">
            Add New Charge
        </h2>

    </div>

    <form
        action="/frontDesk/incidentals/add"
        method="POST"
        class="p-6">

        <input
            type="hidden"
            name="bookingId"
            value="<%= booking.booking_id %>">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="md:col-span-2">

                <label class="block text-sm font-medium mb-2">

                    Description

                </label>

                <input
                    type="text"
                    name="description"
                    required
                    placeholder="Laundry, Minibar, Room Service..."
                    class="w-full rounded-lg border border-slate-300 px-4 py-3">

            </div>

            <div>

                <label class="block text-sm font-medium mb-2">

                    Amount (₹)

                </label>

                <input
                    type="number"
                    step="0.01"
                    min="0"
                    required
                    name="amount"
                    class="w-full rounded-lg border border-slate-300 px-4 py-3">

            </div>

        </div>

        <div class="mt-6 flex justify-end">

            <button type="submit" class="inline-flex items-center gap-2 bg-[#775a19] hover:bg-[#5d4201] text-white px-6 py-3 rounded-lg">
                <span class="material-symbols-outlined">
                    add_card
                </span>
                Add Charge
            </button>

        </div>

    </form>

</div>