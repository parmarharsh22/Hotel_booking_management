<%
  pageTitle  = "Edit Hotel — HBMS";
  activePage = "hotels";
%>
<%- include('_layout_start') %>

<style>
  .glass-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 8px 32px rgba(0,0,0,0.24), inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .section-glow { position: relative; overflow: hidden; }
  .section-glow::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(79,142,247,0.10), transparent 70%);
    pointer-events: none;
  }
  .upload-zone { transition: all 0.2s ease; }
  .upload-zone:hover { border-color: rgba(79,142,247,0.4) !important; background: rgba(79,142,247,0.04); }
  .upload-zone.filled { border-color: rgba(34,197,94,0.4) !important; background: rgba(34,197,94,0.04); }

  .preview-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
  }
  .preview-wrap img {
    transition: transform 0.3s ease;
  }
  .preview-wrap:hover img { transform: scale(1.04); }
  .preview-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.5));
    opacity: 0;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: flex-end;
    padding: 8px;
  }
  .preview-wrap:hover .preview-overlay { opacity: 1; }

  .skeleton {
    background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.07) 37%, rgba(255,255,255,0.03) 63%);
    background-size: 400% 100%;
    animation: skeleton-loading 1.4s ease infinite;
  }
  @keyframes skeleton-loading {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }
</style>

<!-- Top bar -->
<div class="px-8 py-5 border-b border-surface-border flex items-center gap-4 sticky top-0 z-30 backdrop-blur-xl bg-surface-1/80">
  <a href="/superadmin/hotels" class="p-2 rounded-lg text-muted hover:text-white hover:bg-surface-2 transition-all hover:-translate-x-0.5">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
  </a>
  <div>
    <h1 class="text-lg font-semibold">Edit Hotel</h1>
    <p class="text-xs text-muted mt-0.5 font-mono" id="hotel-slug-display">Loading...</p>
  </div>
</div>

<div class="px-8 py-8 max-w-3xl">

  <div id="form-error" class="hidden mb-5 px-4 py-3 rounded-xl bg-red-950/60 border border-red-800/60 text-red-300 text-sm backdrop-blur-sm"></div>
  <div id="form-success" class="hidden mb-5 px-4 py-3 rounded-xl bg-green-950/60 border border-green-800/60 text-green-300 text-sm backdrop-blur-sm flex items-center gap-2">
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
    <span id="form-success-text"></span>
  </div>

  <!-- Loading skeleton -->
  <div id="loading-state" class="space-y-4">
    <div class="glass-card rounded-2xl p-6">
      <div class="skeleton h-4 w-32 rounded mb-6"></div>
      <div class="grid grid-cols-2 gap-5">
        <div class="col-span-2 skeleton h-10 rounded-lg"></div>
        <div class="skeleton h-10 rounded-lg"></div>
        <div class="skeleton h-10 rounded-lg"></div>
        <div class="col-span-2 skeleton h-10 rounded-lg"></div>
        <div class="skeleton h-10 rounded-lg"></div>
        <div class="skeleton h-10 rounded-lg"></div>
        <div class="skeleton h-10 rounded-lg"></div>
      </div>
    </div>
  </div>

  <!-- Form (hidden until data loaded) -->
  <div id="form-wrapper" class="hidden space-y-6">

    <div class="glass-card section-glow rounded-2xl p-6">
      <div class="flex items-center gap-2.5 mb-6">
        <div class="w-7 h-7 rounded-lg bg-accent-muted text-accent flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold tracking-tight">Hotel Details</h2>
      </div>

      <div class="grid grid-cols-2 gap-5">
        <div class="col-span-2">
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">
            Hotel Name <span class="text-danger">*</span>
          </label>
          <input type="text" id="name" placeholder="Hotel Name" class="input-field text-sm" />
        </div>

        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Email</label>
          <input type="email" id="email" placeholder="hotel@example.com" class="input-field text-sm" />
        </div>

        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Phone</label>
          <input type="text" id="phone" placeholder="+1 234 567 8900" class="input-field text-sm" />
        </div>

        <div class="col-span-2">
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Address</label>
          <input type="text" id="address" placeholder="Street address" class="input-field text-sm" />
        </div>

        <!-- Country -->
        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Country</label>
          <select id="country" class="input-field text-sm">
            <option value="">Select Country</option>
          </select>
        </div>

        <!-- State -->
        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">State</label>
          <select id="state" class="input-field text-sm" disabled>
            <option value="">Select State</option>
          </select>
        </div>

        <!-- City -->
        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">City</label>
          <select id="city" class="input-field text-sm" disabled>
            <option value="">Select City</option>
          </select>
        </div>

        <div></div>

        <!-- Logo -->
        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Logo</label>
          <label for="logo_url" class="upload-zone flex items-center gap-3 px-3.5 py-3 rounded-lg border border-dashed border-surface-border cursor-pointer">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="text-xs text-muted truncate" id="logo_label">Click to replace</span>
          </label>
          <input type="file" id="logo_url" accept="image/*" class="hidden" />
          <div class="preview-wrap mt-3 w-20 h-20 hidden" id="logo_preview_wrap">
            <img id="logo_preview" src="" class="w-20 h-20 object-cover" />
            <div class="preview-overlay">
              <span class="text-[10px] text-white font-medium">Current logo</span>
            </div>
          </div>
        </div>

        <!-- Cover -->
        <div>
          <label class="block text-xs text-muted font-mono uppercase tracking-wider mb-1.5">Cover Image</label>
          <label for="cover_url" class="upload-zone flex items-center gap-3 px-3.5 py-3 rounded-lg border border-dashed border-surface-border cursor-pointer">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="text-xs text-muted truncate" id="cover_label">Click to replace</span>
          </label>
          <input type="file" id="cover_url" accept="image/*" class="hidden" />
          <div class="preview-wrap mt-3 w-full h-24 hidden" id="cover_preview_wrap">
            <img id="cover_preview" src="" class="w-full h-24 object-cover" />
            <div class="preview-overlay">
              <span class="text-[10px] text-white font-medium">Current cover</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <button id="save-btn" onclick="saveHotel()" class="btn-primary px-6 py-2.5 rounded-lg text-sm font-medium flex items-center gap-2 transition-transform active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
        </svg>
        Save Changes
      </button>
      <a href="/superadmin/hotels" class="btn-ghost px-6 py-2.5 rounded-lg text-sm font-medium">Cancel</a>
    </div>

  </div>
</div>

<script>
  const hotelId = window.location.pathname.split('/')[3];

  const countrySelect = document.getElementById("country");
  const stateSelect   = document.getElementById("state");
  const citySelect    = document.getElementById("city");

  /* ── File preview / label wiring ─────────────────── */
  function wireFileInput(inputId, labelId) {
    const input = document.getElementById(inputId);
    const label = document.getElementById(labelId);
    input.addEventListener("change", () => {
      const zoneEl = document.querySelector(`label[for="${inputId}"]`);
      if (input.files[0]) {
        label.textContent = input.files[0].name;
        zoneEl.classList.add("filled");
      } else {
        label.textContent = "Click to replace";
        zoneEl.classList.remove("filled");
      }
    });
  }
  wireFileInput("logo_url", "logo_label");
  wireFileInput("cover_url", "cover_label");

  /* ===============================
     Country / State / City (cascading, like Add page)
  ================================= */
  async function loadCountries(selected) {
    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/positions");
      const result = await response.json();
      countrySelect.innerHTML = '<option value="">Select Country</option>';
      result.data
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach((country) => {
          const option = document.createElement("option");
          option.value = country.name;
          option.textContent = country.name;
          if (selected && country.name === selected) option.selected = true;
          countrySelect.appendChild(option);
        });
    } catch (err) {
      console.error("Failed to load countries", err);
    }
  }

  async function loadStates(country, selected) {
    stateSelect.disabled = true;
    citySelect.disabled = true;
    stateSelect.innerHTML = "<option>Loading states...</option>";

    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/states", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ country: country }),
      });
      const result = await response.json();

      stateSelect.innerHTML = '<option value="">Select State</option>';
      result.data.states
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach((state) => {
          const option = document.createElement("option");
          option.value = state.name;
          option.textContent = state.name;
          if (selected && state.name === selected) option.selected = true;
          stateSelect.appendChild(option);
        });
      stateSelect.disabled = false;
    } catch (err) {
      console.error("Failed loading states", err);
    }
  }

  async function loadCities(country, state, selected) {
    citySelect.disabled = true;
    citySelect.innerHTML = "<option>Loading cities...</option>";

    try {
      const response = await fetch("https://countriesnow.space/api/v0.1/countries/state/cities", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ country: country, state: state }),
      });
      const result = await response.json();

      citySelect.innerHTML = '<option value="">Select City</option>';
      result.data
        .sort((a, b) => a.localeCompare(b))
        .forEach((city) => {
          const option = document.createElement("option");
          option.value = city;
          option.textContent = city;
          if (selected && city === selected) option.selected = true;
          citySelect.appendChild(option);
        });
      citySelect.disabled = false;
    } catch (err) {
      console.error("Failed loading cities", err);
    }
  }

  countrySelect.addEventListener("change", function () {
    stateSelect.innerHTML = '<option value="">Select State</option>';
    citySelect.innerHTML = '<option value="">Select City</option>';
    stateSelect.disabled = true;
    citySelect.disabled = true;
    if (this.value) loadStates(this.value);
  });

  stateSelect.addEventListener("change", function () {
    citySelect.innerHTML = '<option value="">Select City</option>';
    citySelect.disabled = true;
    if (this.value) loadCities(countrySelect.value, this.value);
  });

  /* ===============================
     Load Hotel Data
  ================================= */
  async function loadHotel() {
    try {
      const res  = await fetch(`/superadmin/hotels/${hotelId}`, {
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      const h    = data.hotel;

      document.getElementById('hotel-slug-display').textContent = h.slug;
      document.getElementById('name').value    = h.name    || '';
      document.getElementById('email').value   = h.email   || '';
      document.getElementById('phone').value   = h.phone   || '';
      document.getElementById('address').value = h.address || '';

      if (h.logo_url) {
        const wrap = document.getElementById('logo_preview_wrap');
        document.getElementById('logo_preview').src = h.logo_url;
        wrap.classList.remove('hidden');
      }
      if (h.cover_url) {
        const wrap = document.getElementById('cover_preview_wrap');
        document.getElementById('cover_preview').src = h.cover_url;
        wrap.classList.remove('hidden');
      }

      // Cascading dropdowns, pre-selected with existing values
      await loadCountries(h.country);
      if (h.country) await loadStates(h.country, h.state);
      if (h.country && h.state) await loadCities(h.country, h.state, h.city);

      document.getElementById('loading-state').classList.add('hidden');
      document.getElementById('form-wrapper').classList.remove('hidden');
    } catch {
      document.getElementById('loading-state').innerHTML =
        '<div class="glass-card rounded-2xl p-8 text-center text-danger text-sm">Failed to load hotel data.</div>';
    }
  }

  /* ===============================
     Save Hotel
  ================================= */
  async function saveHotel() {
    const btn    = document.getElementById('save-btn');
    const errEl  = document.getElementById('form-error');
    const succEl = document.getElementById('form-success');

    errEl.classList.add('hidden');
    succEl.classList.add('hidden');

    const name = document.getElementById('name').value.trim();
    if (!name) {
      errEl.textContent = 'Hotel name is required.';
      errEl.classList.remove('hidden');
      return;
    }

    const formData = new FormData();
    ['name','email','phone','address'].forEach(f => {
      formData.append(f, document.getElementById(f).value.trim());
    });
    formData.append('country', countrySelect.value);
    formData.append('state', stateSelect.value);
    formData.append('city', citySelect.value);

    const logo  = document.getElementById('logo_url').files[0];
    const cover = document.getElementById('cover_url').files[0];
    if (logo)  formData.append('logo_url',  logo);
    if (cover) formData.append('cover_url', cover);

    btn.disabled = true;
    btn.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg> Saving...`;

    try {
      const res = await fetch(`/superadmin/hotels/${hotelId}`, {
        method: 'PUT',
        body: formData
      });

      if (res.ok) {
        document.getElementById('form-success-text').textContent = 'Hotel updated successfully.';
        succEl.classList.remove('hidden');
        setTimeout(() => succEl.classList.add('hidden'), 3000);
      } else {
        errEl.textContent = await res.text() || 'Failed to update hotel.';
        errEl.classList.remove('hidden');
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Save Changes`;
    }
  }

  loadHotel();
</script>

<%- include('_layout_end') %>