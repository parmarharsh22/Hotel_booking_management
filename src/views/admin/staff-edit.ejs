        >
            <i class="fa-regular fa-floppy-disk"></i>
            <span>Commit Updates</span>
        </button>

    </div>

</form><script>
// Image Preview Logic (Unchanged)
document
    .getElementById("staffPhotoInput")
    .addEventListener("change", function (e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(event) {
            document.getElementById("avatarPreview").src = event.target.result;
        };
        reader.readAsDataURL(file);
    });

// Form Submission Logic
async function submitStaffUpdate(event, userId) {
    event.preventDefault();

    const form = document.getElementById("editStaffForm");
    const formData = new FormData(form);

    // ✅ NEW: Show a loading alert while the request is processing
    Swal.fire({
        title: "Updating...",
        text: "Please wait while we update the staff details.",
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    try {
        const response = await fetch(`/hotelAdmin/staff/${userId}`, {
            method: "PUT",
            body: formData
        });

        const result = await response.json();

        // Check if the server returned an error status (400, 500, etc.)
        if (!response.ok) {
            throw new Error(result.message || "Failed to update staff");
        }

        // ✅ NEW: Show success alert
        await Swal.fire({
            icon: "success",
            title: "Success!",
            text: result.message || "Staff updated successfully.",
            confirmButtonText: "OK"
        });

        // ✅ OPTIONAL: Redirect or reload the page after the user clicks "OK"
        // window.location.href = "/admin/staff"; 
        // window.location.reload();

    } catch (err) {
        // ✅ IMPROVED: Show error alert with the specific error message
        Swal.fire({
            icon: "error",
            title: "Update Failed",
            text: err.message || "An unexpected error occurred."
        });
    }
}
</script>





</script>




