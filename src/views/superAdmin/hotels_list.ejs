
<%
 
  pageTitle  = "Hotels — HBMS";
 
  activePage = "hotels";
 
%>
  <%- include('_layout_start') %>

 
<!-- Top bar -->
 
<div class="px-8 py-5 border-b border-surface-border flex items-center justify-between">
 
  <div>
 
    <h1 class="text-lg font-semibold ">Hotels</h1>
 
    <p class="text-xs text-muted mt-0.5">Manage all tenant hotels</p>
 
  </div>
 
  <a href="/superadmin/hotels/new" class="btn-primary px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2">
 
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
 
    Add Hotel
 
  </a>
 
</div>
 
 
<div class="px-8 py-6 space-y-4">
 
 
  <!-- Search & filter bar -->
 
  <div class="flex items-center gap-3">
 
    <div class="relative flex-1 max-w-xs">
 
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
 
      <input id="search-input" type="text" placeholder="Search hotels..." class="input-field pl-9 text-sm" />
 
    </div>
 
    <select id="status-filter" class="input-field text-sm w-40">
 
      <option value="">All Statuses</option>
 
      <option value="1">Active</option>
 
      <option value="2">Suspended</option>
 
      <option value="3">Pending</option>
 
    </select>
 
    <span id="hotel-count" class="text-xs text-muted font-mono ml-auto"></span>
 
  </div>
 
 
  <!-- Table -->
 
  <div class="card overflow-hidden">
 
    <table class="w-full text-sm" id="hotels-table">
 
      <thead>
 
        <tr class="border-b border-surface-border text-left bg-surface-2">
          
           <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Logo</th>

          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Hotel</th>
 
          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Contact</th>
 
          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Location</th>
 
          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Status</th>
 
          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Created</th>
 
          <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider w-32">Actions</th>
 
        </tr>
 
      </thead>
 
      <tbody id="hotels-tbody">
 
        <tr><td colspan="6" class="px-6 py-10 text-center text-muted">Loading...</td></tr>
 
      </tbody>
 
    </table>
 
  </div>
 
 
</div>
 
 
<!-- Delete confirm modal -->
 
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
 
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
 
  <div class="card relative z-10 p-6 w-full max-w-sm mx-4">
 
    <h3 class="text-base font-semibold  mb-1">Delete Hotel</h3>
 
    <p class="text-sm text-muted mb-5">This action cannot be undone. The hotel and its data will be soft-deleted.</p>
 
    <div class="flex gap-3">
 
      <button onclick="closeDeleteModal()" class="btn-ghost flex-1 py-2 rounded-lg text-sm font-medium">Cancel</button>
 
      <button id="confirm-delete-btn" class="btn-danger flex-1 py-2 rounded-lg text-sm font-medium">Delete</button>
 
    </div>
 
  </div>
 
</div>
 
 
<script>
 
  let allHotels = [];
 
  let deleteTargetId = null;
 
 
  async function loadHotels() {
 
    try {
 
      const res = await fetch('/superadmin/hotels', {
        headers:{'Accept':'application/json'}
      });
 
      allHotels  = await res.json();
      console.log(allHotels);
      
 
      renderTable(allHotels);
 
    } catch (err) {
 
      document.getElementById('hotels-tbody').innerHTML =
 
        `<tr><td colspan="6" class="px-6 py-10 text-center text-danger">Failed to load hotels</td></tr>`;
 
    }
 
  }
 
 
  function renderTable(hotels) {
 
    document.getElementById('hotel-count').textContent = `${hotels.length} hotel${hotels.length !== 1 ? 's' : ''}`;
 
    if (hotels.length === 0) {
 
      document.getElementById('hotels-tbody').innerHTML =
 
        `<tr><td colspan="6" class="px-6 py-10 text-center text-muted">No hotels found</td></tr>`;
 
      return;
 
    }
 
 
    document.getElementById('hotels-tbody').innerHTML = hotels.map(h => `
 
      <tr class="table-row border-b border-surface-border last:border-0">
        <td class="px-6 py-3.5">
  <div class="flex items-center gap-3">
    ${h.logo_url 
      ? `<img src="${h.logo_url}" class="w-8 h-8 rounded-lg object-cover flex-shrink-0" />`
      : `<div class="w-8 h-8 rounded-lg bg-accent-muted text-accent text-xs font-bold flex items-center justify-center flex-shrink-0">${h.name[0].toUpperCase()}</div>`
    }
    <div>
      <div class="font-medium ">${h.name}</div>
      <div class="text-xs text-muted font-mono mt-0.5">${h.slug}</div>
    </div>
  </div>
</td>

 
        <td class="px-6 py-3.5">
 
          <div class="font-medium ">${h.name}</div>
 
          <div class="text-xs text-muted font-mono mt-0.5">${h.slug}</div>
 
        </td>
 
        <td class="px-6 py-3.5">
 
          <div class="text-slate-300 text-xs">${h.email || '—'}</div>
 
          <div class="text-muted text-xs">${h.phone || ''}</div>
 
        </td>
 
        <td class="px-6 py-3.5 text-slate-400 text-xs">${[h.city, h.state, h.country].filter(Boolean).join(', ') || '—'}</td>
 
        <td class="px-6 py-3.5">
 
          <select onchange="updateStatus(${h.hotel_id}, this.value)" class="input-field text-xs py-1 w-32">
 
            <option value="1" ${h.tenant_status_id == 1 ? 'selected' : ''}>Active</option>
 
            <option value="2" ${h.tenant_status_id == 2 ? 'selected' : ''}>Suspended</option>
 
            <option value="3" ${h.tenant_status_id == 3 ? 'selected' : ''}>Pending</option>
 
          </select>
 
        </td>
 
        <td class="px-6 py-3.5 text-slate-400 font-mono text-xs">${formatDate(h.created_at)}</td>
 
        <td class="px-6 py-3.5">
 
          <div class="flex items-center gap-2">
 
            <a href="/superadmin/hotels/${h.hotel_id}" title="View" class="p-1.5 rounded-md text-muted hover:text-accent hover:bg-accent-muted transition-colors">
 
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
 
            </a>
 
            <a href="/superadmin/hotels/${h.hotel_id}/edit" title="Edit" class="p-1.5 rounded-md text-muted hover:text-accent hover:bg-accent-muted transition-colors">
 
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
 
            </a>
 
            <button onclick="openDeleteModal(${h.hotel_id})" title="Delete" class="p-1.5 rounded-md text-muted hover:text-danger hover:bg-red-950 transition-colors">
 
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
 
            </button>
 
          </div>
 
        </td>
 
      </tr>
 
    `).join('');
 
  }
 
 
  async function updateStatus(hotelId, statusId) {
 
    try {
 
      const res = await fetch(`/superadmin/hotels/${hotelId}/status`, {
 
        method: 'PUT',
 
        headers: { 'Content-Type': 'application/json' },
 
        body: JSON.stringify({ tenant_status_id: statusId })
 
      });
 
      const data = await res.json();
 
      if (data.success) showToast('Status updated', 'success');
 
      else showToast('Failed to update status', 'error');
 
    } catch {
 
      showToast('Network error', 'error');
 
    }
 
  }
 
 
  function openDeleteModal(id) {
 
    deleteTargetId = id;
 
    document.getElementById('delete-modal').classList.remove('hidden');
 
  }
 
 
  function closeDeleteModal() {
 
    deleteTargetId = null;
 
    document.getElementById('delete-modal').classList.add('hidden');
 
  }
 
 
  document.getElementById('confirm-delete-btn').addEventListener('click', async () => {
 
    if (!deleteTargetId) return;
 
    try {
 
      const res  = await fetch(`/superadmin/hotels/${deleteTargetId}`, { method: 'DELETE' });
 
      const data = await res.json();
 
      if (data.success) {
 
        closeDeleteModal();
 
        showToast('Hotel deleted', 'success');
 
        loadHotels();
 
      } else {
 
        showToast('Delete failed', 'error');
 
      }
 
    } catch {
 
      showToast('Network error', 'error');
 
    }
 
  });
 
 
  // Search & filter
 
  function applyFilters() {
 
    const q      = document.getElementById('search-input').value.toLowerCase();
 
    const status = document.getElementById('status-filter').value;
 
    const filtered = allHotels.filter(h => {
 
      const matchQ = !q || h.name.toLowerCase().includes(q) || h.slug.includes(q) || (h.city || '').toLowerCase().includes(q);
 
      const matchS = !status || String(h.tenant_status_id) === status;
 
      return matchQ && matchS;
 
    });
 
    renderTable(filtered);
 
  }
 
 
  document.getElementById('search-input').addEventListener('input', applyFilters);
 
  document.getElementById('status-filter').addEventListener('change', applyFilters);
 
 
  function formatDate(ts) {
 
    if (!ts) return '—';
 
    return new Date(ts).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
 
  }
 
 
  function showToast(msg, type) {
 
    const toast = document.getElementById('toast');
 
    const inner = document.getElementById('toast-inner');
 
    const styles = {
 
      success: 'bg-green-950 border border-green-800 text-green-300',
 
      error:   'bg-red-950 border border-red-800 text-red-300',
 
    };
 
    inner.className = `flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl text-sm font-medium ${styles[type] || styles.success}`;
 
    inner.textContent = msg;
 
    toast.classList.remove('hidden');
 
    setTimeout(() => toast.classList.add('hidden'), 3000);
 
  }
 
 
  loadHotels();
 
</script>

 <%- include('_layout_end') %>
