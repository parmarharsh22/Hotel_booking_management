                            <div class="flex items-center justify-center w-full">
                                <label class="flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-slate-200 bg-slate-50 rounded-lg cursor-pointer hover:bg-slate-100/70 hover:border-slate-300 transition group">
                                    <div class="flex flex-col items-center justify-center pt-4 pb-4 text-center px-4">
