    <script>
      // Prevent e, +, -, etc.
function allowIntegerOnly(event) {
    const invalidKeys = ['e', 'E', '+', '-', '.'];

    if (invalidKeys.includes(event.key)) {
        event.preventDefault();
    }

    return true;
}

function allowDecimalOnly(event) {
    const invalidKeys = ['e', 'E', '+', '-'];

    if (invalidKeys.includes(event.key)) {
        event.preventDefault();
    }

    return true;
}
function validateHours(input) {

    let value = input.value.replace(/\D/g, '');

    if (value === '') {
        input.value = '';
        return;
    }

    value = parseInt(value, 10);

    if (value > 72) {
        value = 72;
    }

    input.value = value;
}

function validatePercentage(input) {

    let value = input.value;

    // Remove everything except digits and one decimal point
    value = value.replace(/[^0-9.]/g, '');

    // Allow only one decimal point
    const parts = value.split('.');

    if (parts.length > 2) {
        value = parts[0] + '.' + parts.slice(1).join('');
    }

    // Restrict to two decimal places
    if (value.includes('.')) {
        const [whole, decimal] = value.split('.');
        value = `${whole}.${decimal.slice(0, 2)}`;
    }

    // Restrict maximum value to 100
    if (parseFloat(value) > 100) {
        value = '100';
    }

    input.value = value;
}
        const policyForm = document.getElementById('createCancellationPolicyForm');
        const policySummary = document.getElementById('policySummary');
        const policyFeedback = document.getElementById('policyFeedback');
        const policySubmitBtn = document.getElementById('policySubmitBtn');
        const policySubmitText = document.getElementById('policySubmitText');
        const policiesContainer = document.getElementById('policiesContainer');
        const formTitle = document.getElementById('formTitle');
        const formBadge = document.getElementById('formBadge');

        // Edit Modal Elements
        const editModal = document.getElementById('editPolicyModal');
        const editForm = document.getElementById('editCancellationPolicyForm');
        const editFeedback = document.getElementById('edit_policy_feedback');
        const editSubmitBtn = document.getElementById('edit_policy_submit_btn');
        const editSubmitText = document.getElementById('edit_policy_submit_text');

        let cachedRoomTypes = [];

        document.addEventListener('DOMContentLoaded', () => {
            DynamicDropdown.load({
                elementId: 'policyRoomTypeDropdown',
                endpoint: '/hotelAdmin/room-list-types',
                valueKey: 'room_type_id',
                labelBuilder: (type) => `${type.type_name} (${type.room_count} Rooms) (${type.room_type_id})`,
                selectedValue: null
            }).then(() => {
                loadRoomTypesForCache();
            });

            const hoursInput = document.getElementById('create_free_cancellation_hours');
            const percentInput = document.getElementById('create_refund_percentage');
            const roomSelect = document.getElementById('policyRoomTypeDropdown');

            [hoursInput, percentInput, roomSelect].forEach(el => {
                if (el) {
                    el.addEventListener('input', updatePolicySummary);
                    el.addEventListener('change', updatePolicySummary);
                }
            });

            refreshPoliciesList();
        });

        async function loadRoomTypesForCache() {
            try {
                const response = await fetch('/hotelAdmin/room-list-types');
                const result = await response.json();
                if (result.data) cachedRoomTypes = result.data;
            } catch (e) {
                console.error(e);
            }
        }

        function getRoomTypeName(roomTypeId) {
            const found = cachedRoomTypes.find(t => Number(t.room_type_id) === Number(roomTypeId));
            return found ? found.type_name : `Room Type #${roomTypeId}`;
        }

        function formatDate(dateStr) {
            if (!dateStr) return '—';
            const d = new Date(dateStr);
            return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        async function refreshPoliciesList() {
            policiesContainer.innerHTML = `
                <div class="col-span-full flex items-center justify-center py-12 text-slate-400">
                    <i class="fa-solid fa-circle-notch fa-spin mr-2"></i>
                    <span class="text-sm">Loading policies...</span>
                </div>
            `;

            try {
                const response = await fetch('/hotelAdmin/policies');
                const result = await response.json();

                if (!response.ok) throw new Error(result.message || 'Failed to load policies');

                const policies = result.data || result.policies || [];

                if (!policies.length) {
                    policiesContainer.innerHTML = `
                        <div class="col-span-full bg-white rounded-xl border border-dashed border-slate-300 p-10 text-center">
                            <i class="fa-regular fa-file-lines text-3xl text-slate-300 mb-3"></i>
                            <p class="text-sm font-medium text-slate-600">No cancellation policies yet</p>
                            <p class="text-xs text-slate-400 mt-1">Create your first policy using the form below.</p>
                        </div>
                    `;
                    return;
                }

                policiesContainer.innerHTML = policies.map(p => `
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition duration-200">
                        <div>
                            <div class="flex justify-between items-start gap-2">
                                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider truncate" title="${getRoomTypeName(p.room_type_id)}">
                                    ${getRoomTypeName(p.room_type_id)}
                                </p>
                                <span class="text-[10px] px-1.5 py-0.5 font-bold bg-slate-100 text-slate-600 rounded border border-slate-200 whitespace-nowrap">
                                    ID: ${p.policy_id}
                                </span>
                            </div>

                            <div class="flex items-baseline space-x-2 mt-3">
                                <div class="flex-1">
                                    <p class="text-[10px] text-slate-400 uppercase font-semibold">Free Window</p>
                                    <p class="text-xl font-bold text-slate-900">${p.free_cancellation_hours}<span class="text-[11px] text-slate-400 font-medium ml-1">hrs</span></p>
                                </div>
                                <div class="flex-1">
                                    <p class="text-[10px] text-slate-400 uppercase font-semibold">Refund</p>
                                    <p class="text-xl font-bold text-emerald-600">${p.refund_percentage}<span class="text-[11px] text-slate-400 font-medium ml-1">%</span></p>
                                </div>
                            </div>

                            <div class="mt-3 space-y-1.5 border-t border-slate-100 pt-3">
                                <div class="flex items-center text-xs text-slate-600">
                                    <i class="fa-regular fa-calendar w-4 text-slate-400 text-[11px]"></i>
                                    <span class="font-medium">Created:</span>
                                    <span class="ml-1 text-slate-900 font-semibold">${formatDate(p.created_at)}</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-2 mt-4 pt-3 border-t border-slate-100">
                            <button onclick="openEditModal('${p.policy_id}', '${p.room_type_id}', '${p.free_cancellation_hours}', '${p.refund_percentage}')" class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 border border-transparent hover:border-blue-100 rounded-lg transition" title="Edit Policy">
                                <i class="fa-regular fa-pen-to-square text-sm"></i>
                            </button>
                            <button onclick="triggerPolicyDeletion('${p.policy_id}', '${getRoomTypeName(p.room_type_id).replace(/'/g, "\\'")}', this)" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 border border-transparent hover:border-rose-100 rounded-lg transition" title="Delete Policy">
                                <i class="fa-regular fa-trash-can text-sm"></i>
                            </button>
                        </div>
                    </div>
                `).join('');

            } catch (error) {
                console.error(error);
                policiesContainer.innerHTML = `
                    <div class="col-span-full bg-rose-50 border border-rose-200 rounded-xl p-6 text-center">
                        <i class="fa-solid fa-triangle-exclamation text-rose-500 text-xl mb-2"></i>
                        <p class="text-sm font-medium text-rose-700">Failed to load policies</p>
                        <p class="text-xs text-rose-500 mt-1">${error.message}</p>
                        <button onclick="refreshPoliciesList()" class="mt-3 text-xs bg-rose-600 text-white px-3 py-1.5 rounded hover:bg-rose-700 transition">Retry</button>
                    </div>
                `;
            }
        }

        function updatePolicySummary() {
            const hours = document.getElementById('create_free_cancellation_hours').value;
            const percent = document.getElementById('create_refund_percentage').value;
            const roomSelect = document.getElementById('policyRoomTypeDropdown');
            const roomText = roomSelect.options[roomSelect.selectedIndex]?.text || '—';

            if (hours === '' && percent === '') {
                policySummary.innerHTML = '<span class="text-slate-400 italic">Fill the fields to preview the policy summary...</span>';
                return;
            }

            const hoursDisplay = hours !== '' ? `${hours} hours` : '—';
            const percentDisplay = percent !== '' ? `${percent}%` : '—';

            policySummary.innerHTML = `
                <span class="font-semibold text-slate-800">${roomText}</span> —
                Free cancellation within <span class="font-semibold text-emerald-600">${hoursDisplay}</span> before check-in,
                with a <span class="font-semibold text-emerald-600">${percentDisplay}</span> refund thereafter.
            `;
        }

        function applyPolicyTemplate(hours, percent) {
            document.getElementById('create_free_cancellation_hours').value = hours;
            document.getElementById('create_refund_percentage').value = percent;
            updatePolicySummary();
            document.getElementById('create_free_cancellation_hours').focus();
        }

        function scrollToPolicyForm() {
            clearPolicyForm();
            document.getElementById('createCancellationPolicyForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function clearPolicyForm() {
            if (formTitle) formTitle.textContent = 'Establish Cancellation Policy';
            if (formBadge) {
                formBadge.textContent = 'Configuration Panel';
                formBadge.className = 'text-[10px] px-2 py-0.5 rounded bg-purple-50 text-purple-700 font-semibold border border-purple-200 uppercase tracking-wider';
            }
            
            if (policySubmitText) policySubmitText.textContent = 'Register Policy';
            const submitIcon = policySubmitBtn?.querySelector('i');
            if (submitIcon) submitIcon.className = 'fa-regular fa-square-plus text-[11px]';

            policyForm.reset();
            const roomSelect = document.getElementById('policyRoomTypeDropdown');
            if (roomSelect) {
                roomSelect.value = '';
                roomSelect.dispatchEvent(new Event('change', { bubbles: true }));
            }

            policySummary.innerHTML = '<span class="text-slate-400 italic">Fill the fields to preview the policy summary...</span>';
            if (policyFeedback) policyFeedback.classList.add('hidden');
        }

        function showFeedback(message, type = 'success') {
            policyFeedback.textContent = message;
            policyFeedback.classList.remove('hidden');
            if (type === 'success') {
                policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200';
            } else if (type === 'error') {
                policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-rose-50 text-rose-700 border border-rose-200';
            } else {
                policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-blue-50 text-blue-700 border border-blue-200';
            }
        }

        // --- Edit Modal Functions ---
        function openEditModal(policyId, roomTypeId, hours, percent) {
            document.getElementById('edit_policy_id').value = policyId;
            document.getElementById('edit_hotel_id').value = document.getElementById('create_hotel_id').value;
            
            const editRoomSelect = document.getElementById('edit_room_type_id');
            editRoomSelect.innerHTML = '<option value="">Select Room Category...</option>';
            cachedRoomTypes.forEach(type => {
                const option = document.createElement('option');
                option.value = type.room_type_id;
                option.textContent = `${type.type_name} (${type.room_count} Rooms)`;
                if (Number(type.room_type_id) === Number(roomTypeId)) {
                    option.selected = true;
                }
                editRoomSelect.appendChild(option);
            });

            document.getElementById('edit_free_cancellation_hours').value = hours;
            document.getElementById('edit_refund_percentage').value = percent;

            editModal.classList.remove('hidden');
            editModal.classList.add('flex');
        }

        function closeEditModal() {
            editModal.classList.add('hidden');
            editModal.classList.remove('flex');
            editFeedback.classList.add('hidden');
            editForm.reset();
        }

        function showEditFeedback(message, type = 'success') {
            editFeedback.textContent = message;
            editFeedback.classList.remove('hidden');
            if (type === 'success') {
                editFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200';
            } else {
                editFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-rose-50 text-rose-700 border border-rose-200';
            }
        }

        editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const policyId = document.getElementById('edit_policy_id').value;
            const hotelId = document.getElementById('edit_hotel_id').value;
            const roomTypeId = document.getElementById('edit_room_type_id').value;
            const hours = document.getElementById('edit_free_cancellation_hours').value;
            const percent = document.getElementById('edit_refund_percentage').value;

            if (!roomTypeId) {
                showEditFeedback('Please select a room category.', 'error');
                return;
            }

            editSubmitBtn.disabled = true;
            editSubmitText.textContent = 'Updating...';

            const payload = {
                hotel_id: Number(hotelId),
                room_type_id: Number(roomTypeId),
                free_cancellation_hours: Number(hours),
                refund_percentage: Number(percent)
            };

            try {
                const response = await fetch(`/hotelAdmin/policies/${policyId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Update failed');
            await Swal.fire({
                        icon: 'success',
                        title: 'Policy Updated Successfully!',
                        text: 'Operational staff account provisioned securely. Redirecting to index list...',
                        confirmButtonColor: '#0f172a',
                        timer: 2000,
                        timerProgressBar: true
                    });
               
                setTimeout(() => {
                    closeEditModal();
                    refreshPoliciesList();
                }, 1000);
            } catch (error) {
                console.error(error);
                showEditFeedback(error.message || 'Failed to update policy.', 'error');
            } finally {
                editSubmitBtn.disabled = false;
                editSubmitText.textContent = 'Update Policy';
            }
        });

        // --- Deletion Logic (Fixed to properly wait for SweetAlert confirmation) ---
        function triggerPolicyDeletion(policyId, roomTypeName, btn) {
            Swal.fire({
                title: "Are you sure?",
                text: `You won't be able to revert the policy for "${roomTypeName}"!`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#e11d48",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-sm"></i>';
                    btn.disabled = true;

                    fetch(`/hotelAdmin/policies/${policyId}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(async (res) => {
                        const result = await res.json();
                        if (!res.ok) throw new Error(result.message || 'Delete failed');
                        return result;
                    })
                    .then(() => {
                        Swal.fire("Deleted!", "The policy has been deleted.", "success");
                        refreshPoliciesList();
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire("Error!", err.message || "Failed to delete policy.", "error");
                    })
                    .finally(() => {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    });
                }
            });
        }

        // --- Main Form Submission (Create Only) ---
        policyForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const roomSelect = document.getElementById('policyRoomTypeDropdown');
            const roomTypeId = roomSelect?.value;
            const hotelId = document.getElementById('create_hotel_id').value;
            const freeCancellationHours = document.getElementById('create_free_cancellation_hours').value;
            const refundPercentage = document.getElementById('create_refund_percentage').value;

            if (!roomTypeId) {
                showFeedback('Please select a room category before submitting.', 'error');
                return;
            }

            if (freeCancellationHours === '' || refundPercentage === '') {
                showFeedback('Please fill all required fields.', 'error');
                return;
            }

            policySubmitBtn.disabled = true;
            const originalBtnContent = policySubmitBtn.innerHTML;
            policySubmitBtn.innerHTML = `
                <i class="fa-solid fa-circle-notch fa-spin text-[11px]"></i>
                <span>Registering...</span>
            `;

            const payload = {
                hotel_id: Number(hotelId),
                room_type_id: Number(roomTypeId),
                free_cancellation_hours: Number(freeCancellationHours),
                refund_percentage: Number(refundPercentage)
            };

            try {
                const response = await fetch('/hotelAdmin/policies', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Failed to save policy');

                 await Swal.fire({
            icon: "success",
            title: "Provision Success!",
            text: result.message || "Policy Provision successfully.",
            confirmButtonText: "OK"
        });
                clearPolicyForm();
                refreshPoliciesList();

            } catch (error) {
                console.error(error);
                showFeedback(error.message || 'Something went wrong. Please try again.', 'error');
            } finally {
                policySubmitBtn.disabled = false;
                policySubmitBtn.innerHTML = originalBtnContent;
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>