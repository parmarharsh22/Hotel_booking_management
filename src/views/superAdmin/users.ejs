<script>
  let allUsers = [];
  let filteredUsers = [];
  let currentPage = 1;
  const pageSize = 10;
  let selectedIds = new Set();
  let sortState = { key: null, dir: "asc" };

  const roleStyles = {
    SUPER_ADMIN: "bg-purple-500/10 border border-purple-500/30 text-purple-300",
    HOTEL_ADMIN: "bg-blue-500/10 border border-blue-500/30 text-blue-300",
    FRONT_DESK: "bg-cyan-500/10 border border-cyan-500/30 text-cyan-300",
    GUEST: "bg-slate-500/10 border border-slate-500/30 ",
  };
  const roleIcons = {
    SUPER_ADMIN:
      '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
    HOTEL_ADMIN:
      '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    FRONT_DESK:
      '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
    GUEST:
      '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  };

  const avatarGradients = [
    "avatar-gradient",
    "avatar-gradient-2",
    "avatar-gradient-3",
    "avatar-gradient-4",
    "avatar-gradient-5",
  ];
  function getAvatarClass(id) {
    return avatarGradients[(id || 0) % avatarGradients.length];
  }

  async function loadUsers() {
    try {
      const res = await fetch("/superadmin/auth/getAllUser", {
        headers: { Accept: "application/json" },
      });
      allUsers = await res.json();
      populateHotelFilter();
      updateStats();
      applyFilters();
    } catch {
      document.getElementById("users-tbody").innerHTML =
        `<tr><td colspan="7" class="px-6 py-16 text-center">
          <div class="flex flex-col items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <div class="text-black text-sm font-medium">Failed to load users</div>
              <div class="text-muted text-xs mt-1">Please check your connection and try again</div>
            </div>
            <button onclick="loadUsers()" class="btn-secondary text-xs mt-2">Retry</button>
          </div>
        </td></tr>`;
    }
  }

  function populateHotelFilter() {
    const hotels = [
      ...new Map(
        allUsers
          .filter((u) => u.hotel_id && u.hotel_name)
          .map((u) => [u.hotel_id, u]),
      ).values(),
    ].sort((a, b) => a.hotel_name.localeCompare(b.hotel_name));
    const sel = document.getElementById("hotel-filter");
    hotels.forEach((h) => {
      const opt = document.createElement("option");
      opt.value = h.hotel_id;
      opt.textContent = h.hotel_name;
      sel.appendChild(opt);
    });
  }

  function updateStats() {
    document.getElementById("stat-total").textContent = allUsers.length;
    document.getElementById("stat-admins").textContent = allUsers.filter(
      (u) => u.role_name === "SUPER_ADMIN",
    ).length;
    document.getElementById("stat-hotels").textContent = new Set(
      allUsers.map((u) => u.hotel_id).filter(Boolean),
    ).size;
    document.getElementById("stat-guests").textContent = allUsers.filter(
      (u) => u.role_name === "GUEST",
    ).length;
  }

  function applyFilters() {
    const q = document.getElementById("user-search").value.toLowerCase();
    const role = document.getElementById("role-filter").value;
    const hotel = document.getElementById("hotel-filter").value;

    filteredUsers = allUsers.filter((u) => {
      const fullName = `${u.first_name} ${u.last_name}`.toLowerCase();
      const matchQ =
        !q || fullName.includes(q) || u.email.toLowerCase().includes(q);
      const matchR = !role || u.role_name === role;
      const matchH = !hotel || String(u.hotel_id) === String(hotel);
      return matchQ && matchR && matchH;
    });

    if (sortState.key) {
      filteredUsers.sort((a, b) => {
        let va, vb;
        if (sortState.key === "name") {
          va = `${a.first_name} ${a.last_name}`.toLowerCase();
          vb = `${b.first_name} ${b.last_name}`.toLowerCase();
        } else if (sortState.key === "role") {
          va = a.role_name || "";
          vb = b.role_name || "";
        } else if (sortState.key === "hotel") {
          va = a.hotel_name || "";
          vb = b.hotel_name || "";
        } else if (sortState.key === "joined") {
          va = new Date(a.created_at || 0).getTime();
          vb = new Date(b.created_at || 0).getTime();
        }
        if (va < vb) return sortState.dir === "asc" ? -1 : 1;
        if (va > vb) return sortState.dir === "asc" ? 1 : -1;
        return 0;
      });
    }

    currentPage = 1;
    renderPage();
  }

  function renderPage() {
    const total = filteredUsers.length;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * pageSize;
    const pageUsers = filteredUsers.slice(start, start + pageSize);

    document.getElementById("user-count").textContent =
      `${total} user${total !== 1 ? "s" : ""}`;
    document.getElementById("clear-search").style.display =
      document.getElementById("user-search").value ? "flex" : "none";

    if (total === 0) {
      document.getElementById("users-tbody").innerHTML =
        `<tr><td colspan="7" class="px-6 py-16 text-center">
