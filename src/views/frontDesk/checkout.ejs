<!DOCTYPE html>
<html lang="en">

<head>
    <title>Checkout Management | LuxeStay</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-slate-100">

    <!-- Sidebar -->
    <%- include("../partials/frontDesk/sidebar") %>

        <main class="ml-[260px] min-h-screen">

            <!-- Top Section -->
            <!-- Header -->
            <%- include("../partials/frontDesk/header.ejs") %>

                <!-- Page Hero -->
                <div class="px-8 py-6">

                    <div class="bg-gradient-to-r from-[#031632] via-[#0c234d] to-[#1a2b48]
                rounded-3xl shadow-xl p-8">

                        <div class="flex justify-between items-center">

                            <div>

                                <h1 class="text-4xl font-bold text-white">
                                    Checkout Management
                                </h1>

                                <p class="text-yellow-300 mt-3 text-lg">
                                    Manage guest departures, invoices and room turnover
                                </p>

                            </div>

                            <div class="hidden md:flex items-center gap-3">

                                <div class="w-16 h-16 rounded-2xl
                            bg-gradient-to-br
                            from-[#b38728]
                            to-[#775a19]
                            flex items-center justify-center">

                                    <span class="material-symbols-outlined text-white text-3xl">
                                        logout
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Content -->
                <div class="p-8">

                    <!-- Search -->
                    <div class="bg-white rounded-xl shadow-md border border-slate-200 p-5 mb-6">

                        <div class="flex items-center gap-3">

                            <span class="material-symbols-outlined text-slate-500">
                                search
                            </span>

                            <input type="text" id="searchInput"
                                placeholder="Search by booking reference or guest name..."
                                class="w-full outline-none text-sm">

                        </div>

                    </div>

                    <!-- Checkout Table -->
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-slate-200">

                        <div class="px-6 py-5 border-b bg-gradient-to-r from-[#031632] to-[#1a2b48]">

                            <h2 class="text-lg font-semibold text-white">
                                Checked-In Guests
                            </h2>

                        </div>

                        <% if(checkedInGuests.length===0){ %>

                            <div class="p-16 text-center">

                                <span class="material-symbols-outlined text-6xl text-slate-300">
                                    hotel
                                </span>

                                <h3 class="text-xl font-semibold text-slate-700 mt-4">
                                    No Checked-In Guests
                                </h3>

                                <p class="text-slate-500 mt-2">
                                    There are currently no guests eligible for checkout.
                                </p>

                            </div>

                            <% } else { %>

                                <div class="overflow-x-auto">

                                    <table class="w-full">

                                        <thead>

                                            <tr
                                                class="bg-slate-50 border-b text-slate-700 text-sm uppercase tracking-wider">

                                                <th class="text-left px-6 py-4">
                                                    Booking Ref
                                                </th>

                                                <th class="text-left px-6 py-4">
                                                    Guest
                                                </th>

                                                <th class="text-center px-6 py-4">
                                                    Rooms
                                                </th>

                                                <th class="text-center px-6 py-4">
                                                    Check-In
                                                </th>

                                                <th class="text-center px-6 py-4">
                                                    Check-Out
                                                </th>

                                                <th class="text-center px-6 py-4">
                                                    Status
                                                </th>

                                                <th class="text-center px-6 py-4">
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody id="guestTable">

                                            <% checkedInGuests.forEach(guest=> { %>

                                                <tr class="border-b hover:bg-slate-50 transition duration-200">

                                                    <td class="px-6 py-5">

                                                        <span class="font-semibold text-[#031632]">

                                                            <%= guest.booking_reference %>

                                                        </span>

                                                    </td>

                                                    <td class="px-6 py-5">

                                                        <div class="font-medium text-slate-800">

                                                            <%= guest.first_name %>
                                                                <%= guest.last_name %>

                                                        </div>

                                                    </td>

                                                    <td class="px-6 py-5 text-center">

                                                        <span
                                                            class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-medium">

                                                            <%= guest.total_rooms %>

                                                        </span>

                                                    </td>

                                                    <td class="px-6 py-5 text-center text-slate-600">

                                                        <%= new Date(guest.checkin_date) .toLocaleDateString("en-IN") %>

                                                    </td>

                                                    <td class="px-6 py-5 text-center">

                                                        <% const checkoutDate=new Date(guest.checkout_date); %>

                                                            <% const today=new Date(); %>

                                                                <% const
                                                                    dueToday=checkoutDate.toDateString()===today.toDateString();
                                                                    %>

                                                                    <span class="<%= dueToday
                                        ? 'text-red-600 font-semibold'
                                        : 'text-slate-600' %>">

                                                                        <%= checkoutDate.toLocaleDateString("en-IN") %>

                                                                    </span>

                                                    </td>

                                                    <td class="px-6 py-5 text-center">

                                                        <span
                                                            class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold">

                                                            CHECKED IN

                                                        </span>

                                                    </td>

                                                    <td class="px-6 py-5 text-center">

                                                        <a href="/frontDesk/checkout/<%= guest.booking_reference %>"
                                                            class="inline-flex items-center gap-2 bg-[#775a19] hover:bg-[#5d4201] text-white px-4 py-2 rounded-lg transition">

                                                            <span class="material-symbols-outlined text-[18px]">
                                                                logout
                                                            </span>

                                                            Checkout

                                                        </a>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                                <% } %>

                    </div>

                </div>

        </main>

        <script>

            const searchInput =
                document.getElementById("searchInput");

            const tableRows =
                document.querySelectorAll("#guestTable tr");

            searchInput?.addEventListener("keyup", function () {

                const value =
                    this.value.toLowerCase();

                tableRows.forEach(row => {

                    const text =
                        row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(value)
                            ? ""
                            : "none";

                });

            });

        </script>

</body>

</html>