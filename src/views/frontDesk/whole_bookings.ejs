<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<title>Booking Management</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"/>

</head>

<body class="bg-gray-50">

<%- include('../partials/frontDesk/sidebar') %>

<div class="lg:ml-[260px] min-h-screen">

<!-- Header -->
<%- include("../partials/frontDesk/header.ejs") %>

<!-- Hero Section -->
<div class="px-8 py-6">

    <div class="bg-gradient-to-r from-[#031632] via-[#0c234d] to-[#1a2b48]
                rounded-3xl shadow-xl p-8">

        <div class="flex justify-between items-center">

            <div>

                <div class="flex items-center gap-3 mb-2">

                    <span class="material-symbols-outlined text-yellow-300 text-4xl">
                        event_note
                    </span>

                    <h1 class="text-4xl font-bold text-white">
                        Booking Management
                    </h1>

                </div>

                <p class="text-yellow-300 text-lg">
                    View, manage and monitor all guest reservations across the property.
                </p>
            </div>

            <div class="hidden lg:flex">

                <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-6 text-center">

                    <p class="text-blue-200 text-sm">
                        Total Bookings
                    </p>

                    <h2 class="text-3xl font-bold text-white mt-1">
                        <%= totalRecords %>
                    </h2>

                </div>

            </div>

        </div>

    </div>

</div>

<main class="p-8">

    <!-- Header -->

    <div class="flex justify-between items-center mb-8">

        <div>

            <h1 class="text-3xl font-bold text-[#031632]">
                Booking Management
            </h1>

            <p class="text-gray-500">
                Search and manage all hotel bookings
            </p>

        </div>

    </div>

    <!-- Filters -->

    <form method="GET" action="/frontDesk/bookings" class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <div class="grid md:grid-cols-4 gap-4">
            <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Booking Ref / Guest Name"
                class="border rounded-lg px-4 py-3">

            <select
                name="status"
                class="border rounded-lg px-4 py-3">

                <option value="">
                    All Statuses
                </option>

                <option value="CONFIRMED">
                    Confirmed
                </option>

                <option value="CHECKED_IN">
                    Checked In
                </option>

                <option value="CHECKED_OUT">
                    Checked Out
                </option>

                <option value="CANCELLED">
                    Cancelled
                </option>

            </select>

            <input
                type="date"
                name="fromDate"
                class="border rounded-lg px-4 py-3">

            <button
                type="submit"
                class="bg-[#031632] text-white rounded-lg">

                Search

            </button>

        </div>

    </form>

    <!-- Stats -->

    <div class="mb-4 text-sm text-gray-600">

        Showing
        <strong>
            <%= bookings.length %>
        </strong>

        of

        <strong>
            <%= totalRecords %>
        </strong>

        bookings

    </div>

    <!-- Table -->

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">

        <table class="w-full">

            <thead class="bg-gray-100">

                <tr>

                    <th class="text-left p-4">
                        Ref No
                    </th>

                    <th class="text-left p-4">
                        Guest
                    </th>

                    <th class="text-left p-4">
                        Rooms
                    </th>

                    <th class="text-left p-4">
                        Check-In
                    </th>

                    <th class="text-left p-4">
                        Check-Out
                    </th>

                    <th class="text-left p-4">
                        Status
                    </th>

                    <th class="text-left p-4">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                <% bookings.forEach(booking => { %>

                <tr class="border-b hover:bg-gray-50">

                    <td class="p-4 font-semibold">

                        <%= booking.booking_reference %>

                    </td>

                    <td class="p-4">

                        <div>

                            <div class="font-medium">

                                <%= booking.first_name %>
                                <%= booking.last_name %>

                            </div>

                        </div>

                    </td>

                    <td class="p-4">

                        <%= booking.room_numbers %>

                    </td>

                    <td class="p-4">

                        <%= new Date(
                            booking.checkin_date
                        ).toLocaleDateString() %>

                    </td>

                    <td class="p-4">

                        <%= new Date(
                            booking.checkout_date
                        ).toLocaleDateString() %>

                    </td>

                    <td class="p-4">

                        <span
                        class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs">

                            <%= booking.booking_status %>

                        </span>

                    </td>

                    <td class="p-4">

                        <a
                        href="/frontDesk/checkIn/<%= booking.booking_reference %>?source=past"
                        class="text-[#031632] font-medium">
                        
                            View

                        </a>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <!-- Pagination -->

    <div class="flex justify-center gap-2 mt-8">

        <% for(let i=1;i<=totalPages;i++){ %>

            <a
            href="?page=<%= i %>"
            class="
                px-4 py-2 rounded-lg border
                <%= currentPage === i
                    ? 'bg-[#031632] text-white'
                    : 'bg-white'
                %>
            ">

                <%= i %>

            </a>

        <% } %>

    </div>

</main>

</div>

</body>

</html>