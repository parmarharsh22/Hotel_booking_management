<%
  const inr = n => "₹" + Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2 });
  const fmtDate = d => {
    if (!d) return "—";
    return new Date(d).toLocaleDateString("en-IN", { day:"2-digit", month:"short", year:"numeric" });
  };
  const nightCount = (cin, cout) => Math.max(1, Math.round((new Date(cout) - new Date(cin)) / 86400000));
  const statusCfg = s => ({
    CONFIRMED:   { cls:"sc",  label:"Confirmed",   icon:"✓" },
    CHECKED_IN:  { cls:"sci", label:"Checked In",  icon:"🏠" },
    CHECKED_OUT: { cls:"sco", label:"Checked Out", icon:"✔" },
    CANCELLED:   { cls:"sx",  label:"Cancelled",   icon:"✕" },
    PENDING:     { cls:"sp",  label:"Pending",     icon:"⏳" },
  }[s] || { cls:"sd", label: s, icon:"•" });
  const isHttp = u => u && u.startsWith("http");
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>My Bookings</title>
  <style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600;700;800&display=swap');

:root{
  --bg:#f8fafc;
  --card:#ffffff;

  --ink:#0f172a;
  --ink2:#475569;
  --muted:#64748b;
  --line:#e2e8f0;

  --accent:#b45309;
  --accent-dark:#92400e;
  --accent-light:#fef3e2;

  --green:#065f46;
  --green-bg:#d1fae5;

  --red:#b91c1c;
  --red-bg:#fee2e2;

  --orange:#b45309;
  --orange-bg:#fef3c7;

  --radius:16px;

  --shadow:
    0 1px 3px rgba(0,0,0,.06),
    0 8px 24px rgba(0,0,0,.08);

  --shadow-hover:
    0 20px 50px rgba(0,0,0,.10);
}

/* Global */
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:'Inter', -apple-system, sans-serif;
  background:var(--bg);
  color:var(--ink);
  min-height:100vh;
}


/* ========= Banner ========= */

.banner{
  background:linear-gradient(135deg,#b45309 0%, #92400e 50%, #78350f 100%);
  padding:40px 24px 80px;
  position:relative;
  overflow:hidden;
}

.banner::before{
  content:"";
  position:absolute;
  top:-60px;
  right:-60px;
  width:300px;
  height:300px;
  border-radius:50%;
  background:rgba(255,255,255,.06);
}

.banner::after{
  content:"";
  position:absolute;
  bottom:-80px;
  left:30%;
  width:200px;
  height:200px;
  border-radius:50%;
  background:rgba(255,255,255,.04);
}

.banner-inner{
  max-width:900px;
  margin:0 auto;
  position:relative;
  z-index:1;
}

.banner h1{
  font-family:'Playfair Display', serif;
  font-size:32px;
  font-weight:700;
  color:#fff;
  margin-bottom:8px;
}

.banner p{
  font-size:15px;
  color:rgba(255,255,255,.75);
}


.banner-stats{
  display:flex;
  gap:24px;
  margin-top:24px;
  flex-wrap:wrap;
}


.bstat{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);
  border-radius:12px;
  padding:12px 20px;
  backdrop-filter:blur(10px);
}

.bstat-val{
  font-size:22px;
  font-weight:700;
  color:#fff;
}

.bstat-lbl{
  font-size:12px;
  color:rgba(255,255,255,.7);
}


/* ========= Content ========= */

.content{
  max-width:900px;
  margin:-48px auto 40px;
  padding:0 16px;
  position:relative;
  z-index:2;
}


/* ========= Filter ========= */

.filter-bar{
  display:flex;
  gap:8px;
  margin-bottom:20px;
  flex-wrap:wrap;
}

.filter-btn{
  padding:8px 18px;
  border-radius:999px;
  font-size:13px;
  font-weight:600;
  border:1.5px solid var(--line);
  background:var(--card);
  color:var(--ink2);
  cursor:pointer;
  transition:all .2s;
}

.filter-btn:hover,
.filter-btn.active{
  background:var(--accent);
  color:#fff;
  border-color:var(--accent);
}


/* ========= Empty ========= */

.empty{
  background:var(--card);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:72px 32px;
  text-align:center;
}

.empty-icon{
  font-size:64px;
  margin-bottom:20px;
}

.empty h2{
  font-family:'Playfair Display', serif;
  font-size:24px;
  margin-bottom:8px;
}

.empty p{
  color:var(--muted);
}


/* ========= Booking Card ========= */

.bcard{
  background:var(--card);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  margin-bottom:16px;
  overflow:hidden;
  border:1px solid var(--line);
  transition:all .25s ease;
}

.bcard:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow-hover);
}


/* Card Hero */

.bcard-hero{
  height:140px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#1e293b,#0f172a);
}


.bcard-hero img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .5s ease;
}


.bcard:hover .bcard-hero img{
  transform:scale(1.04);
}


.bcard-hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.1),
      rgba(0,0,0,.55)
    );
}


.bcard-hero-fallback{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42px;
  color:rgba(255,255,255,.35);
}


/* Hotel Info */

.bcard-logo-wrap{
  position:absolute;
  bottom:14px;
  left:16px;
  display:flex;
  align-items:center;
  gap:10px;
}


.bcard-logo{
  width:44px;
  height:44px;
  border-radius:10px;
  background:#fff;
  border:2px solid rgba(255,255,255,.8);
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}


.bcard-logo img{
  width:100%;
  height:100%;
  object-fit:cover;
}


.logo-init{
  color:var(--accent);
  font-size:18px;
  font-weight:700;
}


.bcard-logo-text{
  color:#fff;
}


.bcard-logo-text h3{
  font-size:15px;
  font-weight:700;
}


.bcard-logo-text p{
  font-size:12px;
  opacity:.8;
}


/* Status */

.bcard-status-wrap{
  position:absolute;
  top:14px;
  right:14px;
}

.sbadge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:5px 12px;
  border-radius:999px;
  font-size:11px;
  font-weight:600;
}

.sc{
  background:#065f46;
  color:#fff;
}

.sci{
  background:#2563eb;
  color:#fff;
}

.sco{
  background:#475569;
  color:#fff;
}

.sx{
  background:#b91c1c;
  color:#fff;
}

.sp{
  background:var(--accent);
  color:#fff;
}

.sd{
  background:#64748b;
  color:#fff;
}


/* Card Body */

.bcard-body{
  padding:18px 20px;
}


.bcard-top{
  margin-bottom:14px;
}


.bcard-ref{
  font-size:11px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.05em;
}


/* Dates */

.dates-row{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:14px;
}


.date-pill{
  flex:1;
  text-align:center;
  padding:10px 14px;
  border-radius:12px;
  background:linear-gradient(135deg,#fef3e2,#fff8f0);
  border:1px solid #fde3b8;
}


.date-pill label{
  display:block;
  margin-bottom:3px;
  font-size:10px;
  color:var(--accent);
  text-transform:uppercase;
  letter-spacing:.08em;
}


.date-pill p{
  font-size:14px;
  font-weight:600;
}


.nights-pill{
  text-align:center;
}


.nights-pill .arr{
  font-size:18px;
  color:var(--muted);
}


.nights-pill .n{
  font-size:12px;
  font-weight:600;
  color:var(--ink2);
}


/* Meta */

.meta-row{
  display:flex;
  gap:16px;
  flex-wrap:wrap;
  margin-bottom:16px;
}


.meta-chip{
  font-size:13px;
  color:var(--ink2);
}


/* Bottom */

.bcard-bottom{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding-top:14px;
  border-top:1px solid var(--line);
}


.bcard-amount-wrap .lbl{
  font-size:11px;
  color:var(--muted);
}


.bcard-amount{
  font-family:'Playfair Display', serif;
  font-size:22px;
  font-weight:700;
  color:var(--accent-dark);
}


/* Button */

.btn-view{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:10px 20px;
  background:linear-gradient(135deg,#b45309,#92400e);
  color:#fff;
  border:none;
  border-radius:10px;
  font-size:13px;
  font-weight:600;
  text-decoration:none;
  transition:all .2s ease;
}


.btn-view:hover{
  background:linear-gradient(135deg,#92400e,#78350f);
  transform:translateY(-2px);
  box-shadow:0 8px 24px rgba(180,83,9,.35);
}


.btn-view .arr{
  transition:transform .15s;
}


.btn-view:hover .arr{
  transform:translateX(3px);
}
  </style>
</head>
<body>
  <a href="/" style="
  position:fixed; top:20px; left:20px; z-index:999;
  display:inline-flex; align-items:center; gap:6px;
  background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.25);
  color:#fff; text-decoration:none; font-size:13px; font-weight:500;
  padding:8px 14px; border-radius:999px; backdrop-filter:blur(10px);
  transition:.2s;
" onmouseover="this.style.background='rgba(255,255,255,.25)'"
   onmouseout="this.style.background='rgba(255,255,255,.15)'">
  ← Back to Home
</a>
<!-- banner -->
<div class="banner">
  <div class="banner-inner">
    <h1>My Bookings</h1>
    <p>All your hotel stays in one place</p>
    <div class="banner-stats">
      <div class="bstat">
        <div class="bstat-val"><%= bookings.length %></div>
        <div class="bstat-lbl">Total Bookings</div>
      </div>
      <div class="bstat">
        <div class="bstat-val"><%= bookings.filter(b => b.status_name === "CONFIRMED").length %></div>
        <div class="bstat-lbl">Confirmed</div>
      </div>
      <div class="bstat">
        <div class="bstat-val"><%= bookings.filter(b => b.status_name === "CHECKED_OUT").length %></div>
        <div class="bstat-lbl">Completed</div>
      </div>
    </div>
  </div>
</div>

<!-- content -->
<div class="content">

  <% if (bookings.length === 0) { %>
    <div class="empty">
      <div class="empty-icon">🏨</div>
      <h2>No bookings yet</h2>
      <p>Your upcoming and past stays will appear here.</p>
    </div>
  <% } else { %>

    <% bookings.forEach(b => {
         const n  = nightCount(b.checkin_date, b.checkout_date);
         const sc = statusCfg(b.status_name);
         const init = (b.hotel_name || "H")[0].toUpperCase();
    %>
      <div class="bcard">

        <!-- hero -->
        <div class="bcard-hero">
          <% if (isHttp(b.hotel_logo)) { %>
            <img src="<%= b.hotel_logo %>" alt="<%= b.hotel_name %>"
                 onerror="this.style.display='none'"/>
          <% } else { %>
            <div class="bcard-hero-fallback">🏨</div>
          <% } %>
          <div class="bcard-hero-overlay"></div>

          <!-- logo + name over hero -->
          <div class="bcard-logo-wrap">
            <div class="bcard-logo">
              <% if (isHttp(b.hotel_logo)) { %>
                <img src="<%= b.hotel_logo %>" alt=""
                     onerror="this.style.display='none';this.nextElementSibling.style.display='block'"/>
                <span class="logo-init" style="display:none"><%= init %></span>
              <% } else { %>
                <span class="logo-init"><%= init %></span>
              <% } %>
            </div>
            <div class="bcard-logo-text">
              <h3><%= b.hotel_name %></h3>
              <p>📍 <%= b.hotel_city %></p>
            </div>
          </div>

          <!-- status badge -->
          <div class="bcard-status-wrap">
            <span class="sbadge <%= sc.cls %>"><%= sc.icon %> <%= sc.label %></span>
          </div>
        </div>

        <!-- body -->
        <div class="bcard-body">

          <div class="bcard-top">
            <div class="bcard-ref">Ref · <%= b.booking_reference %></div>
          </div>

          <!-- dates -->
          <div class="dates-row">
            <div class="date-pill">
              <label>Check-in</label>
              <p><%= fmtDate(b.checkin_date) %></p>
            </div>
            <div class="nights-pill">
              <span class="arr">→</span>
              <span class="n"><%= n %>N</span>
            </div>
            <div class="date-pill">
              <label>Check-out</label>
              <p><%= fmtDate(b.checkout_date) %></p>
            </div>
          </div>

          <!-- meta -->
          <div class="meta-row">
            <span class="meta-chip"><span class="icon">👤</span> <%= b.adults %> Adult<%= b.adults > 1 ? "s" : "" %><% if (b.children > 0) { %> · <%= b.children %> Child<%= b.children > 1 ? "ren" : "" %><% } %></span>
            <span class="meta-chip"><span class="icon">🗓</span> Booked <%= fmtDate(b.created_at) %></span>
          </div>

          <!-- bottom -->
          <div class="bcard-bottom">
            <div class="bcard-amount-wrap">
              <div class="lbl">Total Amount</div>
              <div class="bcard-amount"><%= inr(b.total_amount) %></div>
            </div>
            <a href="/bookings/<%= b.booking_id %>" class="btn-view">
              View Details <span class="arr">→</span>
            </a>
          </div>

        </div>
      </div>
    <% }) %>

  <% } %>
</div>

</body>
</html>