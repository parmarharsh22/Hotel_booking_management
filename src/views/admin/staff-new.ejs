                            <div class="relative">
                                <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input type="password" name="password" id="password" required placeholder="Min 8 characters" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2.5 outline-none focus:bg-white focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition">
