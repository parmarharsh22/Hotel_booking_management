<div class="space-y-6 flex  p-10 w-full gap-2 ">
<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 p-5">
        <div>
            <h2 class="text-lg font-bold text-slate-900">Cancellation Policies Overview</h2>
            <p class="text-sm text-slate-500">Manage flexible cancellation windows and refund percentages per room category.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="refreshPoliciesList()" class="text-xs text-slate-500 hover:text-slate-800 font-medium px-3 py-2 rounded border border-slate-200 hover:bg-slate-50 transition">
                <i class="fa-solid fa-rotate-right mr-1.5"></i>Refresh
            </button>
            <button onclick="scrollToPolicyForm()" class="flex items-center space-x-1.5 bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-semibold px-3 py-2 rounded-lg shadow-sm transition">
                <i class="fa-regular fa-square-plus text-[11px]"></i>
                <span>New Policy</span>
            </button>
        </div>
    </div>

    <!-- Policies Grid -->
    <div id="policiesContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 px-5 py-2">
        <div class="col-span-full flex items-center justify-center py-12 text-slate-400">
            <i class="fa-solid fa-circle-notch fa-spin mr-2"></i>
            <span class="text-sm">Loading policies...</span>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden ">
        <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ">
            <div>
                <h3 id="formTitle" class="font-bold text-slate-900">Establish Cancellation Policy</h3>
                <p class="text-xs text-slate-500">Define flexible cancellation windows and refund percentages per room category.</p>
            </div>
            <span id="formBadge" class="text-[10px] px-2 py-0.5 rounded bg-purple-50 text-purple-700 font-semibold border border-purple-200 uppercase tracking-wider">
                Configuration Panel
            </span>
        </div>

        <form id="createCancellationPolicyForm" class="p-6 md:p-8 space-y-6 " novalidate >
            <input type="hidden" name="hotel_id" value="<%= hotel_id || '' %>">
            <input type="hidden" name="policy_id" id="policyIdField" value="">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 ">

                <div class="space-y-4">

                    <%- include('../partials/components/TypeDropDown', {
                        id: 'policyRoomTypeDropdown',
                        name: 'room_type_id',
                        label: 'Room Category Allocation',
                        required: true,
                        selectedValue: ''
                    }) %>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">
                                Free Cancellation Hours
                            </label>
                            <div class="relative">
                                <input
                                    type="number"
                                    name="free_cancellation_hours"
                                    min="0"
                                    step="1"
                                    placeholder="e.g. 24"
                                    required
                                    class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition"
                                >
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-medium pointer-events-none">hrs</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">
                                Refund Percentage
                            </label>
                            <div class="relative">
                                <input
                                    type="number"
                                    name="refund_percentage"
                                    min="0"
                                    max="100"
                                    step="0.01"
                                    placeholder="e.g. 100"
                                    required
                                    class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5 outline-none focus:bg-white focus:border-slate-400 font-medium text-slate-800 transition"
                                >
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-medium pointer-events-none">%</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">
                            Policy Summary Preview
                        </label>
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-md min-h-[68px] flex items-center">
                            <p id="policySummary" class="text-xs text-slate-600 leading-relaxed">
                                <span class="text-slate-400 italic">Fill the fields to preview the policy summary...</span>
                            </p>
                        </div>
                    </div>

                </div>

                <div class="space-y-4 flex flex-col justify-between">

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                            Policy Guidelines
                        </label>
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-2">
                            <div class="flex items-start space-x-2.5">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-[11px] mt-0.5"></i>
                                <p class="text-xs font-medium text-slate-700">Free cancellation is allowed within the specified hours before check-in.</p>
                            </div>
                            <div class="flex items-start space-x-2.5">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-[11px] mt-0.5"></i>
                                <p class="text-xs font-medium text-slate-700">Refund percentage applies to the total booking amount after the free window.</p>
                            </div>
                            <div class="flex items-start space-x-2.5">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-[11px] mt-0.5"></i>
                                <p class="text-xs font-medium text-slate-700">Each room category can have its own independent cancellation policy.</p>
                            </div>
                            <div class="flex items-start space-x-2.5">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-[11px] mt-0.5"></i>
                                <p class="text-xs font-medium text-slate-700">Values are stored with timestamps for audit tracking.</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">
                            Quick Templates
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <button
                                type="button"
                                onclick="applyPolicyTemplate(24, 100)"
                                class="text-xs bg-slate-50 hover:bg-white text-slate-700 font-medium px-3 py-2 rounded border border-slate-200 shadow-sm transition"
                            >
                                <i class="fa-regular fa-clock mr-1 text-slate-400"></i>24h / 100%
                            </button>
                            <button
                                type="button"
                                onclick="applyPolicyTemplate(48, 75)"
                                class="text-xs bg-slate-50 hover:bg-white text-slate-700 font-medium px-3 py-2 rounded border border-slate-200 shadow-sm transition"
                            >
                                <i class="fa-regular fa-clock mr-1 text-slate-400"></i>48h / 75%
                            </button>
                            <button
                                type="button"
                                onclick="applyPolicyTemplate(72, 50)"
                                class="text-xs bg-slate-50 hover:bg-white text-slate-700 font-medium px-3 py-2 rounded border border-slate-200 shadow-sm transition"
                            >
                                <i class="fa-regular fa-clock mr-1 text-slate-400"></i>72h / 50%
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div id="policyFeedback" class="hidden text-xs font-medium px-3 py-2 rounded-md"></div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button
                    type="button"
                    onclick="clearPolicyForm()"
                    class="flex items-center space-x-2 text-xs text-slate-500 hover:text-slate-800 font-medium px-4 py-2.5 rounded transition"
                >
                    <i class="fa-solid fa-arrow-rotate-left text-[10px]"></i>
                    <span>Clear Parameters</span>
                </button>
                <button
                    type="submit"
                    id="policySubmitBtn"
                    class="flex items-center space-x-2 bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium px-5 py-2.5 rounded-md shadow-sm transition disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <i class="fa-regular fa-square-plus text-[11px]"></i>
                    <span id="policySubmitText">Register Policy</span>
                </button>
            </div>
        </form>


    </div>

    </div>
<!-- <div class="w-full h-[900px] border rounded "></div> -->
</div>

<script>
    const policyForm = document.getElementById('createCancellationPolicyForm');
    const policySummary = document.getElementById('policySummary');
    const policyFeedback = document.getElementById('policyFeedback');
    const policySubmitBtn = document.getElementById('policySubmitBtn');
    const policySubmitText = document.getElementById('policySubmitText');
    const policiesContainer = document.getElementById('policiesContainer');
    const formTitle = document.getElementById('formTitle');
    const formBadge = document.getElementById('formBadge');
    const policyIdField = document.getElementById('policyIdField');

    let currentEditId = null;
    let cachedRoomTypes = [];

    document.addEventListener('DOMContentLoaded', () => {
        DynamicDropdown.load({
            elementId: 'policyRoomTypeDropdown',
            endpoint: '/hotelAdmin/room-list-types',
            valueKey: 'room_type_id',
            labelBuilder: (type) => `${type.type_name} (${type.room_count} Rooms) (${type.room_type_id})`,
            selectedValue: null
        }).then(() => {
            loadRoomTypesForCache();
        });

        const hoursInput = policyForm.querySelector('input[name="free_cancellation_hours"]');
        const percentInput = policyForm.querySelector('input[name="refund_percentage"]');
        const roomSelect = document.getElementById('policyRoomTypeDropdown');

        [hoursInput, percentInput, roomSelect].forEach(el => {
            el.addEventListener('input', updatePolicySummary);
            el.addEventListener('change', updatePolicySummary);
        });

        refreshPoliciesList();
    });

    async function loadRoomTypesForCache() {
        try {
            const response = await fetch('/hotelAdmin/room-list-types');
            const result = await response.json();
            if (result.data) cachedRoomTypes = result.data;
        } catch (e) {
            console.error(e);
        }
    }

    function getRoomTypeName(roomTypeId) {
        const found = cachedRoomTypes.find(t => Number(t.room_type_id) === Number(roomTypeId));
        return found ? found.type_name : `Room Type #${roomTypeId}`;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    async function refreshPoliciesList() {
        policiesContainer.innerHTML = `
            <div class="col-span-full flex items-center justify-center py-12 text-slate-400">
                <i class="fa-solid fa-circle-notch fa-spin mr-2"></i>
                <span class="text-sm">Loading policies...</span>
            </div>
        `;

        try {
            const response = await fetch('/hotelAdmin/policies');
            const result = await response.json();

            if (!response.ok) throw new Error(result.message || 'Failed to load policies');

            const policies = result.data || result.policies || [];

            if (!policies.length) {
                policiesContainer.innerHTML = `
                    <div class="col-span-full bg-white rounded-xl border border-dashed border-slate-300 p-10 text-center">
                        <i class="fa-regular fa-file-lines text-3xl text-slate-300 mb-3"></i>
                        <p class="text-sm font-medium text-slate-600">No cancellation policies yet</p>
                        <p class="text-xs text-slate-400 mt-1">Create your first policy using the form below.</p>
                    </div>
                `;
                return;
            }

            policiesContainer.innerHTML = policies.map(p => `
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition duration-200">
                    <div>
                        <div class="flex justify-between items-start gap-2">
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider truncate" title="${getRoomTypeName(p.room_type_id)}">
                                ${getRoomTypeName(p.room_type_id)}
                            </p>
                            <span class="text-[10px] px-1.5 py-0.5 font-bold bg-slate-100 text-slate-600 rounded border border-slate-200 whitespace-nowrap">
                                ID: ${p.policy_id} ${p.type_name}
                            </span>
                        </div>

                        <div class="flex items-baseline space-x-2 mt-3">
                            <div class="flex-1">
                                <p class="text-[10px] text-slate-400 uppercase font-semibold">Free Window</p>
                                <p class="text-xl font-bold text-slate-900">${p.free_cancellation_hours}<span class="text-[11px] text-slate-400 font-medium ml-1">hrs</span></p>
                            </div>
                            <div class="flex-1">
                                <p class="text-[10px] text-slate-400 uppercase font-semibold">Refund</p>
                                <p class="text-xl font-bold text-emerald-600">${p.refund_percentage}<span class="text-[11px] text-slate-400 font-medium ml-1">%</span></p>
                            </div>
                        </div>

                        <div class="mt-3 space-y-1.5 border-t border-slate-100 pt-3">
                            <div class="flex items-center text-xs text-slate-600">
                                <i class="fa-regular fa-calendar w-4 text-slate-400 text-[11px]"></i>
                                <span class="font-medium">Created:</span>
                                <span class="ml-1 text-slate-900 font-semibold">${formatDate(p.created_at)}</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-2 mt-4 pt-3 border-t border-slate-100">
                        <button onclick="triggerPolicyDeletion('${p.policy_id}', '${getRoomTypeName(p.room_type_id).replace(/'/g, "\\'")}')" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 border border-transparent hover:border-rose-100 rounded-lg transition" title="Delete Policy">
                            <i class="fa-regular fa-trash-can text-sm"></i>
                        </button>
                       
                    </div>
                </div>
            `).join('');

        } catch (error) {
            console.error(error);
            policiesContainer.innerHTML = `
                <div class="col-span-full bg-rose-50 border border-rose-200 rounded-xl p-6 text-center">
                    <i class="fa-solid fa-triangle-exclamation text-rose-500 text-xl mb-2"></i>
                    <p class="text-sm font-medium text-rose-700">Failed to load policies</p>
                    <p class="text-xs text-rose-500 mt-1">${error.message}</p>
                    <button onclick="refreshPoliciesList()" class="mt-3 text-xs bg-rose-600 text-white px-3 py-1.5 rounded hover:bg-rose-700 transition">Retry</button>
                </div>
            `;
        }
    }

    function updatePolicySummary() {
        const hours = policyForm.querySelector('input[name="free_cancellation_hours"]').value;
        const percent = policyForm.querySelector('input[name="refund_percentage"]').value;
        const roomSelect = document.getElementById('policyRoomTypeDropdown');
        const roomText = roomSelect.options[roomSelect.selectedIndex]?.text || '—';

        if (hours === '' && percent === '') {
            policySummary.innerHTML = '<span class="text-slate-400 italic">Fill the fields to preview the policy summary...</span>';
            return;
        }

        const hoursDisplay = hours !== '' ? `${hours} hours` : '—';
        const percentDisplay = percent !== '' ? `${percent}%` : '—';

        policySummary.innerHTML = `
            <span class="font-semibold text-slate-800">${roomText}</span> —
            Free cancellation within <span class="font-semibold text-emerald-600">${hoursDisplay}</span> before check-in,
            with a <span class="font-semibold text-emerald-600">${percentDisplay}</span> refund thereafter.
        `;
    }

    function applyPolicyTemplate(hours, percent) {
        policyForm.querySelector('input[name="free_cancellation_hours"]').value = hours;
        policyForm.querySelector('input[name="refund_percentage"]').value = percent;
        updatePolicySummary();
        policyForm.querySelector('input[name="free_cancellation_hours"]').focus();
    }

    function scrollToPolicyForm() {
        clearPolicyForm();
        document.getElementById('createCancellationPolicyForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

  function launchEditPolicyView(policyId, roomTypeId, hours, percent) {
    console.log('Launching edit for:', policyId, roomTypeId, hours, percent);
    
    currentEditId = policyId;
    
    // 1. Safely update hidden ID field
    const idField = document.getElementById('policyIdField');
    if (idField) idField.value = policyId;

    // 2. Update form title and badge (using direct document selection to be safe)
    const formTitleEl = document.getElementById('formTitle');
    if (formTitleEl) formTitleEl.innerText = 'Modify Cancellation Policy';
    
    const formBadgeEl = document.getElementById('formBadge');
    if (formBadgeEl) {
        formBadgeEl.textContent = 'Edit Mode';
        formBadgeEl.className = 'text-[10px] px-2 py-0.5 rounded bg-amber-500 text-amber-700 font-semibold border border-amber-200 uppercase tracking-wider';
    }
    
    // 3. Update submit button text and icon
    const submitTextEl = document.getElementById('policySubmitText');
    if (submitTextEl) submitTextEl.textContent = 'Update Policy';
    
    const submitBtnEl = document.getElementById('policySubmitBtn');
    const submitIcon = submitBtnEl?.querySelector('i');
    if (submitIcon) submitIcon.className = 'fa-regular fa-floppy-disk text-[11px]';

    // 4. Update Room Type Dropdown
    const roomSelect = document.getElementById('policyRoomTypeDropdown');
    if (roomSelect) {
        roomSelect.value = roomTypeId;
        // Trigger change event to force custom dropdown UI to update
        roomSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }
    
    // 5. FIXED: Grab inputs directly via document instead of the potentially null policyForm variable
    const hoursInput = document.querySelector('input[name="free_cancellation_hours"]');
    const percentInput = document.querySelector('input[name="refund_percentage"]');
    
    if (hoursInput) hoursInput.value = hours;
    if (percentInput) percentInput.value = percent;

    // 6. Update summary and show feedback
    updatePolicySummary();
    scrollToPolicyForm();
    showFeedback(`Editing policy #${policyId} . Make changes and click Update.`, 'info');
}

    function clearPolicyForm() {
    currentEditId = null;
    if (policyIdField) policyIdField.value = '';

    if (formTitle) formTitle.textContent = 'Establish Cancellation Policy';
    if (formBadge) {
        formBadge.textContent = 'Configuration Panel';
        formBadge.className = 'text-[10px] px-2 py-0.5 rounded bg-purple-50 text-purple-700 font-semibold border border-purple-200 uppercase tracking-wider';
    }
    
    if (policySubmitText) policySubmitText.textContent = 'Register Policy';
    const submitIcon = policySubmitBtn?.querySelector('i');
    if (submitIcon) submitIcon.className = 'fa-regular fa-square-plus text-[11px]';

    policyForm.reset();
    const roomSelect = document.getElementById('policyRoomTypeDropdown');
    if (roomSelect) {
        roomSelect.value = '';
        // Trigger change event to reset custom dropdown UI
        roomSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    policySummary.innerHTML = '<span class="text-slate-400 italic">Fill the fields to preview the policy summary...</span>';
    if (policyFeedback) policyFeedback.classList.add('hidden');
}

    function showFeedback(message, type = 'success') {
        policyFeedback.textContent = message;
        policyFeedback.classList.remove('hidden');
        if (type === 'success') {
            policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200';
        } else if (type === 'error') {
            policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-rose-50 text-rose-700 border border-rose-200';
        } else {
            policyFeedback.className = 'text-xs font-medium px-3 py-2 rounded-md bg-blue-50 text-blue-700 border border-blue-200';
        }
    }

    function triggerPolicyDeletion(policyId, roomTypeName) {
        // if (!confirm(`Are you sure you want to delete the cancellation policy for "${roomTypeName}" (ID: ${policyId})? This action cannot be undone.`)) {
        //     return;
        // }
Swal.fire({
  title: "Are you sure?",
  text: "You won't be able to revert this!",
  icon: "warning",
  showCancelButton: true,
  confirmButtonColor: "#3085d6",
  cancelButtonColor: "#d33",
  confirmButtonText: "Yes, delete it!"
}).then((result) => {
  if (result.isConfirmed) Swal.fire({
    title: "Deleted!",
    text: "Your file has been deleted.",
    icon: "success"
  });
});
        const btn = event.currentTarget;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-sm"></i>';
        btn.disabled = true;

        fetch(`/hotelAdmin/policies/${policyId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.json())
        .then(result => {
            if (res && !res.ok) throw new Error(result.message || 'Delete failed');
            showFeedback(`Policy #${policyId} deleted successfully.`, 'success');
            refreshPoliciesList();
            if (currentEditId === policyId) clearPolicyForm();
        })
        .catch(err => {
            console.error(err);
            showFeedback(err.message || 'Failed to delete policy.', 'error');
        })
        .finally(() => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        });
    }

    policyForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const roomSelect = document.getElementById('policyRoomTypeDropdown');
        const roomTypeId = roomSelect?.value;
        const hotelId = policyForm.querySelector('input[name="hotel_id"]').value;
        const freeCancellationHours = policyForm.querySelector('input[name="free_cancellation_hours"]').value;
        const refundPercentage = policyForm.querySelector('input[name="refund_percentage"]').value;

        if (!roomTypeId) {
            showFeedback('Please select a room category before submitting.', 'error');
            return;
        }

        if (freeCancellationHours === '' || refundPercentage === '') {
            showFeedback('Please fill all required fields.', 'error');
            return;
        }

        policySubmitBtn.disabled = true;
        const originalBtnContent = policySubmitBtn.innerHTML;
        policySubmitBtn.innerHTML = `
            <i class="fa-solid fa-circle-notch fa-spin text-[11px]"></i>
            <span>${currentEditId ? 'Updating...' : 'Registering...'}</span>
        `;

        const payload = {
            hotel_id: Number(hotelId),
            room_type_id: Number(roomTypeId),
            free_cancellation_hours: Number(freeCancellationHours),
            refund_percentage: Number(refundPercentage)
        };

        try {
            let response;
            if (currentEditId) {
                response = await fetch(`/hotelAdmin/policies/${currentEditId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            } else {
                response = await fetch('/hotelAdmin/policies', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.message || 'Failed to save policy');
            }

            showFeedback(currentEditId ? 'Policy updated successfully.' : 'Policy registered successfully.', 'success');
            clearPolicyForm();
            refreshPoliciesList();

        } catch (error) {
            console.error(error);
            showFeedback(error.message || 'Something went wrong. Please try again.', 'error');
        } finally {
            policySubmitBtn.disabled = false;
            policySubmitBtn.innerHTML = originalBtnContent;
        }
    });
</script>

