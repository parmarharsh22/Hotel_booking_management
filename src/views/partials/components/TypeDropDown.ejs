                <div>
                    <button onclick=""></button>
    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">
        <%= label || "Room Type" %>
    </label>

   <select
    id="<%= id %>"
    name="<%= name %>"
   
    class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2.5"
    <%= required ? 'required' : '' %>
>
    <option value="">Loading...</option>
</select>

    <p
        id="<%= id %>-feedback"
        class="text-xs text-slate-400 mt-1"
    ></p>
</div>
<script>

    
    
class DynamicDropdown {

    static async load({
    elementId,
    endpoint,
    valueKey,
    labelBuilder,
    selectedValue = null
}) {

    const select = document.getElementById(elementId);

    if (!select) return;

    if (!selectedValue) {
        selectedValue =
            select.dataset.selectedValue || null;
    }

        try {

            select.innerHTML =
                `<option value="">Loading...</option>`;

            const response = await fetch(endpoint);

            if (!response.ok) {
                throw new Error("Failed to fetch");
            }

            const result = await response.json();
console.log(result.data);


            select.innerHTML =
                `<option value="">Select Option</option>`;

            result.data.forEach(item => {

                const option =
                    document.createElement("option");

                option.value = item[valueKey];

                option.textContent =
                    labelBuilder(item);

                if (
                    selectedValue &&
                    Number(selectedValue) ===
                    Number(item[valueKey])
                ) {
                    option.selected = true;
                }

                select.appendChild(option);
            });

        } catch (error) {

            console.error(error);

            select.innerHTML =
                `<option value="">Unable to load data</option>`;
        }
    }
}

</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

    DynamicDropdown.load({
        elementId: 'roomTypeDropdown',
        endpoint: '/hotelAdmin/room-list-types',
        valueKey: 'room_type_id',

        labelBuilder: (type) =>
            `${type.type_name} (${type.room_count} Rooms) (${type.room_type_id})`
    });

});
</script>