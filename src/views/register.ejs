<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Register - LuxeStay Manager</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@500&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@100..900&amp;family=JetBrains+Mono:wght@100..900&amp;display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Hanken Grotesk', sans-serif;
            background-color: #f7f9fc;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed-dim": "#b0c6ff",
                        "on-primary": "#ffffff",
                        "on-secondary": "#ffffff",
                        "text-muted": "#64748B",
                        "on-surface": "#191c1e",
                        "inverse-surface": "#2d3133",
                        "status-success": "#008009",
                        "outline-variant": "#c4c6d3",
                        "on-surface-variant": "#434651",
                        "border-subtle": "#E0E6ED",
                        "tertiary-container": "#00377a",
                        "inverse-primary": "#b0c6ff",
                        "status-error": "#D4111E",
                        "secondary-fixed-dim": "#ffba26",
                        "on-tertiary": "#ffffff",
                        "on-error": "#ffffff",
                        "tertiary": "#002251",
                        "surface-container-highest": "#e0e3e6",
                        "tertiary-fixed": "#d8e2ff",
                        "on-tertiary-fixed-variant": "#004494",
                        "secondary": "#7d5800",
                        "on-primary-fixed": "#001945",
                        "on-primary-container": "#7fa1f2",
                        "primary-container": "#003580",
                        "surface-dim": "#d8dadd",
                        "primary": "#002155",
                        "surface-container": "#eceef1",
                        "background": "#f7f9fc",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#191c1e",
                        "surface-container-high": "#e6e8eb",
                        "outline": "#747782",
                        "on-secondary-fixed": "#271900",
                        "secondary-fixed": "#ffdea9",
                        "border-strong": "#CBD5E1",
                        "surface-bright": "#f7f9fc",
                        "inverse-on-surface": "#eff1f4",
                        "on-error-container": "#93000a",
                        "primary-fixed": "#d9e2ff",
                        "on-tertiary-container": "#72a2ff",
                        "tertiary-fixed-dim": "#adc6ff",
                        "on-tertiary-fixed": "#001a41",
                        "error": "#ba1a1a",
                        "on-secondary-container": "#6b4b00",
                        "surface-container-low": "#f2f4f7",
                        "on-secondary-fixed-variant": "#5e4100",
                        "secondary-container": "#ffb700",
                        "surface-tint": "#375ca8",
                        "surface": "#FFFFFF",
                        "on-primary-fixed-variant": "#1a438e",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e0e3e6",
                        "text-main": "#1A202C"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "sidebar-width": "260px",
                        "margin-desktop": "32px",
                        "container-max": "1440px",
                        "margin-mobile": "16px",
                        "gutter": "24px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "label-md": ["JetBrains Mono"],
                        "headline-sm": ["Hanken Grotesk"],
                        "display-lg": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"],
                        "headline-md": ["Hanken Grotesk"],
                        "body-md": ["Hanken Grotesk"],
                        "body-sm": ["Hanken Grotesk"],
                        "button": ["Hanken Grotesk"]
                    },
                    "fontSize": {
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                        "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "display-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "button": ["14px", { "lineHeight": "20px", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
</head>

<body class="bg-background min-h-screen flex items-center justify-center p-4">
    <!-- Suppressed Nav Shells for Transactional Page -->
    <div
        class="w-full max-w-2xl bg-surface border border-border-subtle rounded-lg shadow-sm overflow-hidden flex flex-col md:flex-row">
        <!-- Brand/Visual Side (Web) -->
        <div
            class="hidden md:flex md:w-1/3 bg-primary p-margin-desktop flex-col justify-between relative overflow-hidden">
            <div class="z-10">
                <h1 class="text-on-primary font-headline-md text-headline-md font-extrabold tracking-tight">LuxeStay
                    Manager</h1>
                <p class="text-on-primary opacity-70 font-body-sm text-body-sm mt-base">Property Management System for
                    Luxury Hospitality Groups.</p>
            </div>
            <!-- Abstract Graphic Pattern -->
            <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-secondary rounded-full opacity-20 blur-3xl"></div>
            <div class="absolute top-1/2 left-0 w-32 h-32 bg-primary-container rounded-full opacity-30 blur-2xl"></div>
            <div class="z-10 mt-auto">
                <div class="flex items-center gap-2 text-on-primary opacity-80">
                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                    <span class="font-label-md text-label-md">Secure Staff Portal</span>
                </div>
            </div>
        </div>
        <!-- Form Content -->
        <div class="flex-1 p-margin-desktop md:p-12 bg-surface">
            <div class="mb-8">
                <h2 class="text-on-surface font-headline-md text-headline-md">Create Account</h2>
                <p class="text-text-muted font-body-md text-body-md">Register to access the management dashboard.</p>
            </div>
            <form action="#" class="space-y-6" onsubmit="event.preventDefault();">
                <!-- Name Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-gutter">
                    <div class="space-y-1.5">
                        <label class="block font-label-md text-label-md text-on-surface-variant" for="first_name">First
                            Name</label>
                        <input
                            class="w-full px-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                            id="first_name" placeholder="John" type="text" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-md text-label-md text-on-surface-variant" for="last_name">Last
                            Name</label>
                        <input
                            class="w-full px-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                            id="last_name" placeholder="Doe" type="text" />
                    </div>
                </div>
                <!-- Contact Details -->
                <div class="space-y-1.5">
                    <label class="block font-label-md text-label-md text-on-surface-variant" for="email">Email</label>
                    <div class="relative">
                        <span
                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">mail</span>
                        <input
                            class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                            id="email" placeholder="john.doe@hospitality.com" type="email" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="block font-label-md text-label-md text-on-surface-variant" for="phone">Phone</label>
                    <div class="relative">
                        <span
                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">phone</span>
                        <input
                            class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                            id="phone" placeholder="+1 (555) 000-0000" type="tel" />
                    </div>
                </div>
                <!-- Passwords Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-gutter">
                    <div class="space-y-1.5">
                        <label class="block font-label-md text-label-md text-on-surface-variant"
                            for="password">Password</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                            <input
                                class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                                id="password" placeholder="••••••••" type="password" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-md text-label-md text-on-surface-variant"
                            for="confirm_password">Confirm Password</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock_reset</span>
                            <input
                                class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-border-strong rounded font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                                id="confirm_password" placeholder="••••••••" type="password" />
                        </div>
                    </div>
                </div>
                <!-- Terms -->
                <div class="flex items-start gap-3">
                    <input
                        class="mt-1 w-4 h-4 text-secondary border-outline rounded focus:ring-secondary cursor-pointer"
                        id="terms" type="checkbox" />
                    <label class="font-body-sm text-body-sm text-on-surface-variant" for="terms">
                        I agree to the <a class="text-primary font-semibold hover:underline" href="#">Terms of
                            Service</a> and <a class="text-primary font-semibold hover:underline" href="#">Privacy
                            Policy</a>.
                    </label>
                </div>
                <!-- Action -->
                <div class="pt-2 space-y-4">
                    <button
                        class="w-full bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container font-button text-button py-3 rounded shadow-sm transition-all active:scale-[0.98] uppercase tracking-wider"
                        type="submit">
                        Register
                    </button>
                    <p class="text-center font-body-md text-body-md text-on-surface-variant">
                        Already have an account?
                        <a class="text-primary font-bold hover:underline" href="#">Login</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
    <!-- Background Decorative Elements -->
    <div class="fixed inset-0 -z-10 opacity-30 pointer-events-none overflow-hidden">
        <div class="absolute -top-[10%] -left-[5%] w-[40%] h-[40%] bg-primary-container rounded-full blur-[120px]">
        </div>
        <div class="absolute top-[60%] -right-[10%] w-[50%] h-[50%] bg-secondary-container rounded-full blur-[150px]">
        </div>
    </div>
    <script>
        // Simple interactivity for the password toggle or validation (UX polish)
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.classList.add('scale-[1.01]');
                input.parentElement.style.transition = 'transform 0.2s ease';
            });
            input.addEventListener('blur', () => {
                input.parentElement.classList.remove('scale-[1.01]');
            });
        });
    </script>
</body>

</html>