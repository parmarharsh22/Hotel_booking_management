        <div class="md:col-span-2 bg-slate-50 border border-slate-200 rounded-lg p-3.5 flex items-start space-x-3 mt-2">

            <i class="fa-solid fa-shield-halved text-slate-500 text-sm mt-0.5"></i>

            <div>
                <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wide">
                    Functional Security Role Assignment
                </h4>

                <p class="text-[11px] text-slate-500 mt-0.5">
                    This profile is locked to the global group:
                    <span class="font-mono bg-white px-1 py-0.5 border border-slate-200 rounded font-bold text-slate-700">
                        <%= staff.role_name %>
                    </span>
                </p>
            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="p-4 border-t border-slate-200 bg-slate-50/50 flex items-center justify-end space-x-3">

