  tbody tr {
    transition: background-color 0.15s ease;
  }
  tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }
  tbody tr.selected {
    background-color: rgba(99, 102, 241, 0.08);
  }

  .checkbox-custom {
    appearance: none;
    width: 16px;
    height: 16px;
    border: 1.5px solid #475569;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
    flex-shrink: 0;
  }
  .checkbox-custom:hover {
    border-color: #6366f1;
  }
  .checkbox-custom:checked {
    background: #6366f1;
    border-color: #6366f1;
  }
  .checkbox-custom:checked::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 5px;
    height: 9px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .checkbox-custom:indeterminate {
    background: #6366f1;
    border-color: #6366f1;
  }
  .checkbox-custom:indeterminate::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 6px;
    width: 8px;
    height: 2px;
    background: white;
  }

  .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    user-select: none;
  }
  .sort-btn:hover {
    color: #e2e8f0;
  }
  .sort-icon {
    opacity: 0.3;
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  .sort-btn.active .sort-icon {
    opacity: 1;
    color: #818cf8;
  }

  .action-btn {
    opacity: 0;
    transition:
      opacity 0.15s,
      background-color 0.15s,
      color 0.15s;
  }
  tbody tr:hover .action-btn {
    opacity: 1;
  }
  tbody tr:focus-within .action-btn {
    opacity: 1;
  }

  .stat-card {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.02) 0%,
      rgba(255, 255, 255, 0) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.15s ease;
  }
  .stat-card:hover {
    border-color: rgba(99, 102, 241, 0.3);
  }

  /* Status badge dropdown */
  .status-dropdown {
    position: relative;
    display: inline-block;
  }
  .status-badge {
    display: inline-flex;
