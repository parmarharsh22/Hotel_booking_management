 <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 md:px-8">
                <div>
                    <h1 class="text-xl font-bold text-slate-900">Room Categories</h1>
                    <p class="text-xs text-slate-500 hidden sm:block">Global Management System</p>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 cursor-pointer hover:bg-slate-100 transition">
                        <div class="w-7 h-7 bg-slate-800 rounded-md flex items-center justify-center text-white text-xs font-bold" id="logoContainer">


                        </div>
                        <div class="text-left hidden sm:block">
                            <p class="text-xs font-semibold text-slate-800 leading-tight" id="hotelName"></p>
                            <p class="text-[10px] text-slate-500 leading-none" id="hotelCity"></p>
                        </div>
                        <!-- <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i> -->
                    </div>
                    <button class="p-2 text-slate-400 hover:text-slate-600 relative">
                        <i class="fa-regular fa-bell text-lg"></i>
                    </button>
                    <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-white text-sm font-medium cursor-pointer">
                        A
                    </div>
                </div>
            </header>


<script>


const fetchHotelDetails=async()=>{

    const response = await fetch("/hotelAdmin/hotel",{
        method:"GET"
        
    });
    const data= await response.json()

    console.log(data);
    const hotelName = document.getElementById("hotelName");
    const hotelCity = document.getElementById("hotelCity")
    const logoContainer = document.getElementById("logoContainer")
    if(data.hotel!==undefined || data.hotel.length>0){
        
        hotelName.innerText = data.hotel.name;
        hotelCity.innerText = `${data.hotel.address} , ${data.hotel.city}` ;
        logoContainer.style.backgroundImage = `url(${data.hotel.logo_url})`;
        logoContainer.style.backgroundRepeat = 'no-repeat';
        logoContainer.style.backgroundPosition = 'center';
        logoContainer.style.backgroundSize = 'cover';
    }




}
fetchHotelDetails()



</script>
