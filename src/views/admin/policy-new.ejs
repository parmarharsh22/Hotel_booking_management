    <!-- Edit Policy Modal -->
    <div id="editPolicyModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4" onclick="if(event.target === this) closeEditModal()">
