<script>
    let isRoomNumberValid = false;

    /**
     * Triggers asynchronous pipeline check to avoid database level composite duplicate constraint rejections
     */
    async function validateRoomNumberUniqueness(roomNumber) {
       
        if (!roomNumber.trim()) return;
       
        const textFeedback = document.getElementById('validationFeedbackText');
        const iconFeedback = document.getElementById('validationFeedbackIcon');
        const submitBtn = document.getElementById('submitButton');
            // Matches our input architecture configuration context

        // Setup loading state indicators
        iconFeedback.className = "absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 animate-spin";
        iconFeedback.innerHTML = `<i class="fa-solid fa-spinner"></i>`;
        iconFeedback.classList.remove('hidden');

        try {
            // Adjust this API string path to perfectly match your verification endpoint
            const checkUrl = `/hotelAdmin/rooms/verifyRoomExists?room_number=${encodeURIComponent(roomNumber)}`;
            const response = await fetch(checkUrl);
            const data = await response.json();

            textFeedback.classList.remove('hidden');

            if (data.exists) {
                // Duplicate identity conflict matches found
                isRoomNumberValid = false;
                submitBtn.disabled = true;
                textFeedback.className = "text-[11px] mt-1 text-rose-600 font-medium";
                textFeedback.innerText = "✕ Identification mismatch: This room identifier actively exists in this property asset.";
                iconFeedback.className = "absolute right-3 top-1/2 -translate-y-1/2 text-rose-500";
                iconFeedback.innerHTML = `<i class="fa-solid fa-circle-xmark"></i>`;
            } else {
                // Identity clean to proceed
                isRoomNumberValid = true;
                submitBtn.disabled = false;
                textFeedback.className = "text-[11px] mt-1 text-emerald-600 font-medium";
                textFeedback.innerText = "✓ Room configuration identifier code verified unique.";
                iconFeedback.className = "absolute right-3 top-1/2 -translate-y-1/2 text-emerald-500";
                iconFeedback.innerHTML = `<i class="fa-solid fa-circle-check"></i>`;
            }
        } catch (err) {
            console.error("Uniqueness engine connection interruption context: ", err);
            // Graceful fallback to avoid locking administration interface due to temporary server lag
            iconFeedback.classList.add('hidden');
            textFeedback.classList.add('hidden');
            submitBtn.disabled = false;
            isRoomNumberValid = true;
        }
    }

    /**
     * File Reader Stream mapping to construct instantaneous UI presentation frame references
     */
    function previewCreationPhoto(input) {
        const previewElement = document.getElementById('creationPhotoPreview');
        const placeholderIcon = document.getElementById('previewPlaceholderIcon');
        const file = input.files[0];

        if (file) {
            const streamUrl = URL.createObjectURL(file);
            previewElement.src = streamUrl;
            previewElement.classList.remove('hidden');
            placeholderIcon.classList.add('hidden');

            previewElement.onload = () => URL.revokeObjectURL(streamUrl);
        }
    }

    /**
     * Drops data states back to base default arrays
     */
    function resetCreationForm() {
        const creationForm = document.getElementById('createRoomForm');
        const previewElement = document.getElementById('creationPhotoPreview');
        const placeholderIcon = document.getElementById('previewPlaceholderIcon');
        const textFeedback = document.getElementById('validationFeedbackText');
        const iconFeedback = document.getElementById('validationFeedbackIcon');
        
        creationForm.reset();
        previewElement.src = "";
        previewElement.classList.add('hidden');
        placeholderIcon.classList.remove('hidden');
        textFeedback.classList.add('hidden');
        iconFeedback.classList.add('hidden');
        document.getElementById('submitButton').disabled = false;
        isRoomNumberValid = false;
    }

    /**
     * Form pipeline package delivery interception route mapping
     */
    async function handleCreationSubmission(event) {
        event.preventDefault();
        
        // Final sanity verification check
        if (!isRoomNumberValid) {
            alert("Rectify duplicate unit identification parameters before execution.");
            return;
        }

        const activeForm = event.target;
        const packedPayload = new FormData(activeForm);

        try {
            // Adjust endpoint string mapping configuration contextual parameters to match your generic POST route setups
            const actionResponse = await fetch('/hotelAdmin/rooms', {
                method: 'POST',
                body: packedPayload
            });

            if (actionResponse.ok) {
                alert('Property units structural configuration asset appended.');
                resetCreationForm();
                window.location.reload(); 
            } else {
                const failureDetails = await actionResponse.json();
                alert(`Asset Provision Exception: ${failureDetails.message || 'Validation layer anomaly.'}`);
            }
        } catch (networkAnomaly) {
            console.error('Asset creation endpoint failure context: ', networkAnomaly);
            alert('A data serialization connection pipeline termination fault was caught.');
        }
    }
</script>



