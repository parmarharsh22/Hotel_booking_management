




<%
  const inr = n => "₹" + Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2 });
  const fmtDate = d => {
    if (!d) return "—";
    return new Date(d).toLocaleDateString("en-IN", { day:"2-digit", month:"short", year:"numeric" });
  };
  const nights = Math.max(1, Math.round(
    (new Date(booking.checkout_date) - new Date(booking.checkin_date)) / 86400000
  ));
  const statusCfg = s => ({
    CONFIRMED:   { cls:"sc",  label:"Confirmed",   color:"#0d9f6e", bg:"#e6f9f3" },
    CHECKED_IN:  { cls:"sci", label:"Checked In",  color:"#1c64f2", bg:"#e1effe" },
    CHECKED_OUT: { cls:"sco", label:"Checked Out", color:"#4b5563", bg:"#f3f4f6" },
    CANCELLED:   { cls:"sx",  label:"Cancelled",   color:"#e02424", bg:"#fde8e8" },
    PENDING:     { cls:"sp",  label:"Pending",     color:"#c27803", bg:"#fdf6b2" },
  }[s] || { cls:"sd", label: s, color:"#6b7280", bg:"#f3f4f6" });
  const sc = statusCfg(booking.status_name);
  const isHttp = u => u && u.startsWith("http");
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= booking.booking_reference %></title>
  <style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600;700;800&display=swap');

:root{
  --bg:#f8fafc;
  --card:#ffffff;

  --ink:#0f172a;
  --ink2:#475569;
  --muted:#64748b;
  --line:#e2e8f0;

  --accent:#b45309;
  --accent-dark:#92400e;
  --accent-light:#fef3e2;

  --radius:16px;

  --shadow:
    0 2px 8px rgba(0,0,0,.06),
    0 8px 24px rgba(0,0,0,.08);

  --shadow-hover:
    0 20px 50px rgba(0,0,0,.10);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:'Inter',-apple-system,sans-serif;
  background:var(--bg);
  color:var(--ink);
  min-height:100vh;
}


/* ================= HERO ================= */

.hero{
  height:320px;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(135deg,#1e293b,#0f172a);
}

.hero-img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .5s ease;
}

.hero:hover .hero-img{
  transform:scale(1.03);
}

.hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.15),
      rgba(0,0,0,.65)
    );
}


/* Back button */

.hero-back{
  position:absolute;
  top:20px;
  left:20px;
  z-index:10;

  display:inline-flex;
  align-items:center;
  gap:6px;

  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.25);

  color:#fff;
  text-decoration:none;
  font-size:13px;
  font-weight:500;

  padding:8px 14px;
  border-radius:999px;

  backdrop-filter:blur(10px);
  transition:.2s;
}

.hero-back:hover{
  background:rgba(255,255,255,.25);
}


/* Hotel Info */

.hero-bottom{
  position:absolute;
  bottom:0;
  left:0;
  right:0;

  z-index:5;

  padding:24px 28px;

  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:16px;
}


.hero-hotel{
  display:flex;
  align-items:flex-end;
  gap:14px;
}


.hero-logo{
  width:60px;
  height:60px;

  border-radius:12px;
  overflow:hidden;

  background:#fff;
  border:2px solid rgba(255,255,255,.7);

  flex-shrink:0;

  display:flex;
  align-items:center;
  justify-content:center;
}


.hero-logo img{
  width:100%;
  height:100%;
  object-fit:cover;
}


.hero-logo .logo-init{
  font-size:24px;
  font-weight:700;
  color:var(--accent);
}


.hero-text h1{
  font-family:'Playfair Display',serif;
  font-size:30px;
  font-weight:700;
  color:#fff;
  line-height:1.2;
}


.hero-text p{
  font-size:13px;
  color:rgba(255,255,255,.75);
  margin-top:4px;
}


/* Status */

.hero-status{
  display:inline-flex;
  align-items:center;
  gap:6px;

  padding:6px 14px;

  border-radius:999px;

  font-size:12px;
  font-weight:700;
  letter-spacing:.04em;

  flex-shrink:0;

  background:
    linear-gradient(
      135deg,
      #b45309,
      #92400e
    );

  color:#fff;
}


/* ================= LAYOUT ================= */

.layout{
  max-width:900px;

  margin:-56px auto 40px;

  padding:0 16px;

  position:relative;
  z-index:10;

  display:grid;

  grid-template-columns:1fr 340px;

  gap:20px;

  align-items:start;
}


/* ================= CARDS ================= */

.dcard{
  background:var(--card);

  border-radius:var(--radius);

  box-shadow:var(--shadow);

  border:1px solid var(--line);

  overflow:hidden;

  margin-bottom:16px;

  transition:.25s ease;
}


.dcard:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow-hover);
}


.dcard-header{
  padding:16px 20px;

  border-bottom:1px solid var(--line);

  display:flex;

  align-items:center;

  gap:10px;
}


.dcard-header h2{
  font-size:14px;
  font-weight:700;
}


.dcard-icon{
  width:32px;
  height:32px;

  border-radius:8px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  color:var(--accent);

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:16px;
}


.dcard-body{
  padding:20px;
}/* ================= BOOKING REFERENCE ================= */

.ref-block{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 20px;
  border-bottom:1px solid var(--line);
}

.ref-lbl{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}

.ref-val{
  font-family:'Playfair Display', serif;
  font-size:20px;
  font-weight:700;
  letter-spacing:.04em;
  color:var(--accent-dark);
}

.booked-on{
  text-align:right;
}

.booked-on .lbl{
  font-size:11px;
  color:var(--muted);
}

.booked-on .val{
  font-size:14px;
  font-weight:600;
  margin-top:2px;
}


/* ================= DATE TIMELINE ================= */

.dates-timeline{
  display:flex;
  align-items:center;
  gap:0;
  margin-bottom:20px;
}


.dt-cell{
  flex:1;
  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  border:1px solid #fde3b8;

  border-radius:12px;

  padding:14px 16px;

  text-align:center;
}


.dt-label{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--accent);
  margin-bottom:4px;
}


.dt-date{
  font-size:16px;
  font-weight:700;
  color:var(--ink);
}


.dt-day{
  font-size:11px;
  color:var(--muted);
  margin-top:2px;
}


.dt-mid{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:0 12px;
}


.dt-mid .nights-bubble{
  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-dark)
    );

  color:#fff;

  font-size:11px;
  font-weight:700;

  padding:5px 12px;

  border-radius:999px;
  white-space:nowrap;
}


.dt-mid .arr{
  font-size:20px;
  color:var(--accent);
  margin:4px 0;
}


/* ================= INFO ROWS ================= */

.info-row{
  display:flex;
  align-items:center;
  padding:14px 0;
  border-bottom:1px solid var(--line);
}


.info-row:last-child{
  border-bottom:none;
}


.info-icon{
  width:36px;
  font-size:18px;
  flex-shrink:0;
  color:var(--accent);
}


.info-lbl{
  font-size:12px;
  color:var(--muted);
}


.info-val{
  font-size:14px;
  font-weight:600;
  margin-top:2px;
  color:var(--ink);
}


/* ================= NOTE BOX ================= */

.note-box{
  margin-top:16px;

  display:flex;
  gap:10px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  border:1px solid #fde3b8;

  border-radius:12px;

  padding:14px 16px;
}


.note-box .note-icon{
  font-size:18px;
  flex-shrink:0;
  color:var(--accent);
}


.note-box p{
  color:var(--accent-dark);
  line-height:1.5;
  font-size:13px;
}


/* ================= ROOM CARDS ================= */

.rcard{
  display:flex;

  border:1px solid var(--line);

  border-radius:12px;

  overflow:hidden;

  margin-bottom:12px;

  transition:.25s ease;
}


.rcard:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 24px rgba(0,0,0,.08);
}


.rcard:last-child{
  margin-bottom:0;
}


.rcard-img{
  width:90px;
  min-width:90px;

  overflow:hidden;

  background:#f1f5f9;
}


.rcard-img img{
  width:100%;
  height:100%;
  object-fit:cover;
}


.rcard-fallback{
  width:100%;
  height:100%;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:30px;
  color:#94a3b8;
}


.rcard-info{
  flex:1;

  padding:14px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:8px;
}


.rcard-num{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}


.rcard-type{
  font-size:15px;
  font-weight:700;
  margin-top:2px;
}


.rcard-right{
  text-align:right;
}


.rcard-rate{
  font-family:'Playfair Display', serif;
  font-size:18px;
  font-weight:700;
  color:var(--accent-dark);
}


.rcard-per{
  font-size:11px;
  color:var(--muted);
}


.rcard-sub{
  margin-top:6px;

  display:inline-block;

  background:#fef3e2;

  color:var(--accent-dark);

  padding:4px 9px;

  border-radius:8px;

  font-size:12px;

  font-weight:600;
}


/* ================= PRICE SIDEBAR ================= */

.price-card{
  background:
    linear-gradient(
      160deg,
      #0f172a,
      #1e293b
    );

  border:1px solid #334155;

  border-radius:var(--radius);

  padding:24px;

  color:#fff;

  box-shadow:
    0 12px 32px rgba(15,23,42,.35);

  margin-bottom:16px;
}


.price-card h3{
  font-size:12px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:rgba(255,255,255,.6);
  margin-bottom:12px;
}


.price-main{
  font-family:'Playfair Display', serif;
  font-size:40px;
  font-weight:700;
  margin-bottom:6px;
}


.price-note{
  font-size:13px;
  color:rgba(255,255,255,.65);
}


.price-divider{
  border:none;
  border-top:1px solid rgba(255,255,255,.15);
  margin:18px 0;
}


.price-row{
  display:flex;
  justify-content:space-between;
  font-size:13px;
  margin-bottom:10px;
}


.price-row .pl{
  color:rgba(255,255,255,.65);
}


.price-row .pr{
  font-weight:600;
}


/* ================= BUTTONS ================= */

.action-btns{
  display:flex;
  flex-direction:column;
  gap:10px;
}


.btn-primary{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  width:100%;

  padding:13px;

  background:
    linear-gradient(
      135deg,
      #b45309,
      #92400e
    );

  color:#fff;

  border:none;

  border-radius:10px;

  font-size:14px;

  font-weight:600;

  text-decoration:none;

  cursor:pointer;

  transition:.2s ease;
}


.btn-primary:hover{
  background:
    linear-gradient(
      135deg,
      #92400e,
      #78350f
    );

  transform:translateY(-2px);

  box-shadow:
    0 8px 24px rgba(180,83,9,.35);
}


.btn-ghost{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  width:100%;

  padding:13px;

  background:#fff;

  color:var(--ink);

  border:1.5px solid var(--line);

  border-radius:10px;

  font-size:14px;

  font-weight:600;

  text-decoration:none;

  transition:.2s ease;
}


.btn-ghost:hover{
  border-color:var(--accent);

  background:#fff8f0;

  color:var(--accent);
}


/* ================= STATUS BADGE ================= */

.status-badge-lg{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  padding:12px;

  border-radius:12px;

  background:
    linear-gradient(
      135deg,
      #fef3e2,
      #fff8f0
    );

  color:var(--accent-dark);

  font-size:14px;

  font-weight:700;

  margin-bottom:16px;

  border:1px solid #fde3b8;
}


/* ================= RESPONSIVE ================= */

@media(max-width:700px){

  .layout{
    grid-template-columns:1fr;
    margin-top:-20px;
  }


  .hero{
    height:250px;
  }


  .hero-bottom{
    padding:18px;
    flex-direction:column;
    align-items:flex-start;
  }


  .hero-text h1{
    font-size:22px;
  }


  .dates-timeline{
    flex-direction:column;
    gap:10px;
  }


  .dt-mid{
    transform:rotate(90deg);
    margin:8px 0;
  }


  .rcard-info{
    flex-direction:column;
    align-items:flex-start;
  }


  .rcard-right{
    text-align:left;
  }
}
  </style>



<!-- Beautiful Embedded Styling based on image_a33779.png -->
<style>
  :root {
    --primary-accent: #a36224;
    --primary-bg-light: #fffdf9;
    --border-light: #f3ece2;
    --text-main: #1f2937;
    --text-muted: #8c9ba5;
    --text-blue: #1d70b8;
  }

  .booking-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    max-width: 550px;
    margin: 20px auto;
    overflow: hidden;
    color: var(--text-main);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 28px 16px 28px;
  }

  .lbl-caps {
    display: block;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .ref-id {
    color: var(--primary-accent);
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    font-family: serif; /* Elegant look matching reference photo */
  }

  .val-date {
    font-weight: 700;
    font-size: 15px;
  }

  .divider {
    border: 0;
    border-top: 1px solid #f1f1f1;
    margin: 0 28px;
  }

  .card-body {
    padding: 28px;
  }

  /* Dates Timeline layout */
  .dates-timeline-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .date-box {
    background: var(--primary-bg-light);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 14px 20px;
    width: 42%;
    position: relative;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .date-box:hover {
    border-color: var(--primary-accent);
    box-shadow: 0 4px 12px rgba(163, 98, 36, 0.06);
  }

  .date-box-lbl {
    display: block;
    text-transform: uppercase;
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.8px;
    color: var(--primary-accent);
    font-weight: 700;
    margin-bottom: 6px;
    cursor: pointer;
  }

  .date-input-hidden {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 100%;
    left: 0;
    bottom: 10px;
  }

  .date-display-trigger {
    text-align: center;
  }

  .display-date-str {
    font-size: 16px;
    font-weight: 700;
    color: #111;
  }

  .display-day-name {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .timeline-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 16%;
  }

  .nights-pill {
    background: var(--primary-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 3px 6px rgba(163, 98, 36, 0.2);
  }

  .arrow-indicator {
    color: var(--text-muted);
    font-size: 14px;
    margin-top: 6px;
  }

  /* Information Lists */
  .details-section {
    border-top: 1px solid #f5f5f5;
    padding-top: 15px;
  }

  .info-row {
    display: flex;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f9f9f9;
  }

  .info-row:last-of-type {
    border-bottom: none;
  }

  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    margin-right: 14px;
  }

  .blue-icon { color: #3b82f6; }
  .global-icon { color: #10b981; }

  .info-content {
    flex-grow: 1;
  }

  .info-lbl {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .info-val-highlight {
    font-weight: 700;
    font-size: 14px;
    color: #111;
  }

  .input-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .styled-number-input {
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 3px 6px;
    font-size: 14px;
    font-weight: 700;
    width: 45px;
    color: #111;
  }

  .input-suffix {
    font-size: 14px;
    font-weight: 700;
  }

  /* Special notes styled alert box */
  .special-notes-box {
    display: flex;
    background: #fdfaf6;
    border-left: 4px solid var(--primary-accent);
    padding: 12px 16px;
    border-radius: 4px 12px 12px 4px;
    margin-top: 20px;
  }

  .note-emoji {
    margin-right: 10px;
    font-size: 16px;
  }

  .note-body {
    font-size: 13px;
    color: #555;
  }
  .note-body p { margin: 4px 0 0 0; }
</style>
</head>
<body>

<!-- hero -->
<div class="hero">
  <% if (isHttp(booking.hotel_cover)) { %>
    <img class="hero-img" src="<%= booking.hotel_cover %>" alt="<%= booking.hotel_name %>"
         onerror="this.style.display='none'"/>
  <% } %>
  <div class="hero-overlay"></div>

  <a href="/bookings/all" class="hero-back">← My Bookings</a>

  <div class="hero-bottom">
    <div class="hero-hotel">
      <div class="hero-logo">
        <% if (isHttp(booking.hotel_logo)) { %>
          <img src="<%= booking.hotel_logo %>" alt=""
               onerror="this.style.display='none';this.nextElementSibling.style.display='block'"/>
          <span class="logo-init" style="display:none"><%= (booking.hotel_name||"H")[0] %></span>
        <% } else { %>
          <span class="logo-init"><%= (booking.hotel_name||"H")[0] %></span>
        <% } %>
      </div>
      <div class="hero-text">
        <h1><%= booking.hotel_name %></h1>
        <p>📍 <%= booking.hotel_city %><% if (booking.hotel_address) { %> &nbsp;·&nbsp; <%= booking.hotel_address %><% } %></p>
      </div>
    </div>
    <span class="hero-status" style="background:<%= sc.bg %>;color:<%= sc.color %>">
      <%= sc.label %>
    </span>
  </div>
</div>

<!-- main layout -->
<div class="layout">

  <!-- LEFT column -->
  <div>

   <!-- Booking Card Container -->
<div class="booking-card">
  
  <!-- Header: Booking Reference & Booked On Date -->
  <div class="card-header">
    <div class="header-left">
      <span class="lbl-caps">Booking Reference</span>
      <h2 class="ref-id"># <%= booking.booking_reference %></h2>
    </div>
    <div class="header-right">
      <span class="lbl-caps">Booked on</span>
      <span class="val-date"><%= fmtDate(booking.created_at) %></span>
    </div>
  </div>

  <hr class="divider" />

  <!-- Form Fields & Interactive Timeline -->
  <form id="bookingUpdateForm" class="card-body">
    
    <!-- Dates Interactive Timeline -->
    <div class="dates-timeline-container">
      
      <!-- Check-In Box -->
      <div class="date-box">
        <label class="date-box-lbl" for="checkin_date">Check-In</label>
        <input 
          type="date" 
          id="checkin_date"
          name="checkin_date" 
          class="date-input-hidden"
          value="<%= booking.checkin_date.toISOString().split('T')[0] %>"
        />
        <div class="date-display-trigger" onclick="document.getElementById('checkin_date').showPicker()">
          <div class="display-date-str" id="checkin_display_date">-- --- ----</div>
          <div class="display-day-name" id="checkin_display_day">Monday</div>
        </div>
      </div>

      <!-- Nights Bubble Indicator -->
      <div class="timeline-connector">
        <div class="nights-pill" id="nights_bubble"><%= nights %> Night<%= nights > 1 ? "s" : "" %></div>
        <span class="arrow-indicator">→</span>
      </div>

      <!-- Check-Out Box -->
      <div class="date-box">
        <label class="date-box-lbl" for="checkout_date">Check-Out</label>
        <input 
          type="date" 
          id="checkout_date"
          name="checkout_date" 
          class="date-input-hidden"
          value="<%= booking.checkout_date.toISOString().split('T')[0] %>"
        />
        <div class="date-display-trigger" onclick="document.getElementById('checkout_date').showPicker()">
          <div class="display-date-str" id="checkout_display_date">-- --- ----</div>
          <div class="display-day-name" id="checkout_display_day">Wednesday</div>
        </div>
      </div>

    </div>

    <!-- Info Detail Rows -->
    <div class="details-section">
      
      <!-- Guests Input Row -->
      <div class="info-row">
        <div class="info-icon blue-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5-3-8-3z"/>
          </svg>
        </div>
        <div class="info-content">
          <label class="info-lbl" for="adults">Guests</label>
          <div class="input-wrapper">
            <input 
              type="number" 
              id="adults"
              name="adults" 
              min="1" 
              max="10" 
              class="styled-number-input"
              value="<%= booking.adults %>"
            >
            
            <span class="input-suffix">Adults</span>
          </div>
        </div>
      </div>

      <!-- Booking Source Row -->
      <div class="info-row">
        <div class="info-icon global-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95a15.65 15.65 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.92 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.31.79 2.51 1.38 3.56A8.03 8.03 0 0 1 5.08 16zm2.95-8H5.08a8.03 8.03 0 0 1 3.33-3.56A15.65 15.65 0 0 0 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.34.16-2h4.68c.09.66.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.59-1.05 1.06-2.25 1.38-3.56h2.95a8.03 8.03 0 0 1-3.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
          </svg>
        </div>
        <div class="info-content">
          <label class="info-lbl">Booking Source</label>
          <div class="info-val-highlight">ONLINE</div>
        </div>
      </div>

    </div>

    <!-- Special Requests -->
    <% if (booking.special_requests) { %>
      <div class="special-notes-box">
        <span class="note-emoji">📝</span>
        <div class="note-body">
          <strong>Special Requests:</strong> 
          <p><%= booking.special_requests %></p>
        </div>
      </div>
    <% } %>

  </form>
</div>



    <!-- rooms -->
   

  <!-- RIGHT sidebar -->
  <div>

   
<form id="bookingEditForm">

<input
type="date"
name="checkin_date"
value="<%= booking.checkin_date.toISOString().split('T')[0] %>">
<input
type="date"
name="checkout_date"
value="<%= booking.checkout_date.toISOString().split('T')[0] %>">
<input
type="number"
name="adults"
min="1"
max="10"
value="<%= booking.adults %>">
<input
type="number"
name="children"
min="0"
max="10"
value="<%= booking.children %>">
<select name="room_id">

<% rooms.forEach(room=>{ %>

<option
value="<%= room.room_id %>"
<%= room.room_id===booking.room_id ? "selected":"" %>>

Room <%= room.room_number %>
(<%= room.type_name %>)

</option>

<% }) %>

</select>

</form>

   
    

  </div>

</div>


<!-- Dynamic Reactive Interface JavaScript Logic -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const checkinInput = document.getElementById("checkin_date");
    const checkoutInput = document.getElementById("checkout_date");
    
    const checkinDateStr = document.getElementById("checkin_display_date");
    const checkinDayStr = document.getElementById("checkin_display_day");
    
    const checkoutDateStr = document.getElementById("checkout_display_date");
    const checkoutDayStr = document.getElementById("checkout_display_day");
    
    const nightsBubble = document.getElementById("nights_bubble");

    // Formatter configurations
    const dayFormatter = new Intl.DateTimeFormat("en-IN", { weekday: "long" });
    const dateFormatter = new Intl.DateTimeFormat("en-IN", { day: "2-digit", month: "short", year: "numeric" });

    function updateTimelineMetrics() {
      if (!checkinInput.value || !checkoutInput.value) return;

      const checkinDate = new Date(checkinInput.value);
      const checkoutDate = new Date(checkoutInput.value);

      // 1. Update text formats visually
      checkinDateStr.textContent = dateFormatter.format(checkinDate);
      checkinDayStr.textContent = dayFormatter.format(checkinDate);

      checkoutDateStr.textContent = dateFormatter.format(checkoutDate);
      checkoutDayStr.textContent = dayFormatter.format(checkoutDate);

      // 2. Compute dynamic time difference
      const timeDifference = checkoutDate.getTime() - checkinDate.getTime();
      const calculatedNights = Math.ceil(timeDifference / (1000 * 3600 * 24));

      // 3. Keep nights validation intact & update bubble representation
      if (calculatedNights > 0) {
        nightsBubble.textContent = `${calculatedNights} Night${calculatedNights > 1 ? 's' : ''}`;
        nightsBubble.style.background = "var(--primary-accent)";
      } else {
        nightsBubble.textContent = "Invalid Dates";
        nightsBubble.style.background = "#ef4444";
      }
    }

    // Attach reactive input event listeners
    checkinInput.addEventListener("change", function() {
      // Set minimum threshold for checkout to prevent logic issues
      checkoutInput.min = checkinInput.value;
      updateTimelineMetrics();
    });

    checkoutInput.addEventListener("change", updateTimelineMetrics);

    // Bootstrap values on initial load context setup
    updateTimelineMetrics();
  });
</script>


</body>
</html>


















