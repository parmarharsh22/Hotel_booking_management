        </tr>
      `;
      })
      .join("");

    renderPagination(total, totalPages);
    bindRowEvents();
  }

  function renderPagination(total, totalPages) {
    const pag = document.getElementById("pagination");
    if (total <= pageSize) {
      pag.classList.add("hidden");
      return;
    }
    pag.classList.remove("hidden");

    const start = (currentPage - 1) * pageSize + 1;
    const end = Math.min(currentPage * pageSize, total);
    document.getElementById("page-start").textContent = start;
    document.getElementById("page-end").textContent = end;
    document.getElementById("page-total").textContent = total;

    document.getElementById("prev-page").disabled = currentPage === 1;
    document.getElementById("next-page").disabled = currentPage === totalPages;

    const nums = document.getElementById("page-numbers");
    let pages = [];
    if (totalPages <= 5) {
      pages = Array.from({ length: totalPages }, (_, i) => i + 1);
    } else {
      if (currentPage <= 3) pages = [1, 2, 3, 4, "...", totalPages];
      else if (currentPage >= totalPages - 2)
        pages = [
          1,
          "...",
          totalPages - 3,
          totalPages - 2,
          totalPages - 1,
          totalPages,
        ];
      else
        pages = [
          1,
          "...",
          currentPage - 1,
          currentPage,
          currentPage + 1,
          "...",
          totalPages,
        ];
    }
    nums.innerHTML = pages
      .map((p) => {
        if (p === "...")
          return `<span class="text-xs text-muted px-1">…</span>`;
        return `<button class="page-num w-7 h-7 rounded text-xs font-mono transition-colors ${p === currentPage ? "bg-indigo-500 " : "text-muted hover:bg-white/5 hover:text-black"}" data-page="${p}">${p}</button>`;
      })
      .join("");

    nums.querySelectorAll(".page-num").forEach((btn) => {
      btn.addEventListener("click", () => {
        currentPage = parseInt(btn.dataset.page);
        renderPage();
      });
    });
  }

  function bindRowEvents() {
    document.querySelectorAll(".row-check").forEach((cb) => {
      cb.addEventListener("change", (e) => {
        const id = parseInt(e.target.dataset.id);
        if (e.target.checked) selectedIds.add(id);
        else selectedIds.delete(id);
        e.target.closest("tr").classList.toggle("selected", e.target.checked);
        updateBulkUI();
      });
    });
  }

  function updateBulkUI() {
    const bulk = document.getElementById("bulk-actions");
    if (selectedIds.size > 0) {
      bulk.classList.remove("hidden");
      bulk.classList.add("flex");
      document.getElementById("selected-count").textContent = selectedIds.size;
    } else {
      bulk.classList.add("hidden");
      bulk.classList.remove("flex");
    }
    const allChecks = document.querySelectorAll(".row-check");
    const selectAll = document.getElementById("select-all");
    if (allChecks.length === 0) {
      selectAll.checked = false;
      selectAll.indeterminate = false;
      return;
    }
    const checkedCount = [...allChecks].filter((c) => c.checked).length;
    selectAll.checked = checkedCount === allChecks.length;
    selectAll.indeterminate =
      checkedCount > 0 && checkedCount < allChecks.length;
  }

  // Sorting
  document.querySelectorAll(".sort-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.sort;
      if (sortState.key === key) {
        sortState.dir = sortState.dir === "asc" ? "desc" : "asc";
      } else {
        sortState.key = key;
        sortState.dir = "asc";
      }
      document.querySelectorAll(".sort-btn").forEach((b) => {
        b.classList.toggle("active", b.dataset.sort === sortState.key);
        const icon = b.querySelector(".sort-icon");
        if (b.dataset.sort === sortState.key) {
          icon.style.transform =
            sortState.dir === "asc" ? "" : "rotate(180deg)";
        } else {
          icon.style.transform = "";
        }
      });
      applyFilters();
    });
  });

  // Select all
  document.getElementById("select-all").addEventListener("change", (e) => {
    const checked = e.target.checked;
    document.querySelectorAll(".row-check").forEach((cb) => {
      cb.checked = checked;
      const id = parseInt(cb.dataset.id);
      if (checked) selectedIds.add(id);
      else selectedIds.delete(id);
      cb.closest("tr").classList.toggle("selected", checked);
    });
    updateBulkUI();
  });

  // Pagination buttons
  document.getElementById("prev-page").addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      renderPage();
    }
  });
  document.getElementById("next-page").addEventListener("click", () => {
    currentPage++;
    renderPage();
  });

  // Search & filters
  document
    .getElementById("user-search")
    .addEventListener("input", applyFilters);
  document
    .getElementById("role-filter")
    .addEventListener("change", applyFilters);
  document
    .getElementById("hotel-filter")
    .addEventListener("change", applyFilters);
  document.getElementById("clear-search").addEventListener("click", () => {
    document.getElementById("user-search").value = "";
    applyFilters();
  });

  // Drawer
  function openDrawer(user) {
    const drawer = document.getElementById("user-drawer");
    const panel = document.getElementById("drawer-panel");
    const content = document.getElementById("drawer-content");
    const initials =
      `${(user.first_name || "")[0] || ""}${(user.last_name || "")[0] || ""}`.toUpperCase() ||
      "?";
    const avatarCls = getAvatarClass(user.user_id);
    const roleCls = roleStyles[user.role_name] || roleStyles.GUEST;
    const roleName = (user.role_name || "GUEST").replace(/_/g, " ");

    content.innerHTML = `
      <div class="flex flex-col items-center text-center pb-5 border-b border-surface-border">
        <div class="w-20 h-20 rounded-full ${avatarCls}  font-mono text-2xl font-bold flex items-center justify-center shadow-xl shadow-black/30 mb-3">${initials}</div>
        <h2 class="text-lg font-semibold ">${user.first_name} ${user.last_name}</h2>
        <p class="text-xs text-muted font-mono mt-0.5">#${user.user_id}</p>
        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono px-2.5 py-1 rounded-md mt-3 ${roleCls}">${roleName}</span>
      </div>

      <div class="space-y-4">
        <div>
          <div class="text-[10px] text-muted font-mono uppercase tracking-wider mb-2">Contact Information</div>
          <div class="space-y-2">
            <div class="flex items-center gap-3 p-2.5 rounded-lg bg-surface-2/50 border border-surface-border/50">
              <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span class="text-xs  font-mono">${user.email}</span>
            </div>
            ${
              user.phone
                ? `<div class="flex items-center gap-3 p-2.5 rounded-lg bg-surface-2/50 border border-surface-border/50">
              <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span class="text-xs  font-mono">${user.phone}</span>
            </div>`
                : ""
            }
          </div>
        </div>

        ${
          user.hotel_name
            ? `<div>
          <div class="text-[10px] text-muted font-mono uppercase tracking-wider mb-2">Hotel</div>
          <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-2/50 border border-surface-border/50">
            <div class="w-9 h-9 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div>
              <div class="text-sm text-black">${user.hotel_name}</div>
              <div class="text-[10px] text-muted font-mono">#${user.hotel_id}</div>
            </div>
          </div>
        </div>`
            : ""
        }

        <div>
          <div class="text-[10px] text-muted font-mono uppercase tracking-wider mb-2">Account</div>
          <div class="grid grid-cols-2 gap-2">
            <div class="p-2.5 rounded-lg bg-surface-2/50 border border-surface-border/50">
              <div class="text-[10px] text-muted font-mono">Role ID</div>
              <div class="text-xs text-black font-mono mt-0.5">#${user.user_role_id || "—"}</div>
            </div>
            <div class="p-2.5 rounded-lg bg-surface-2/50 border border-surface-border/50">
              <div class="text-[10px] text-muted font-mono">Joined</div>
              <div class="text-xs text-black font-mono mt-0.5">${formatDate(user.created_at)}</div>
            </div>
          </div>
        </div>
      </div>


    `;

    drawer.classList.remove("hidden");
    requestAnimationFrame(() => panel.classList.remove("translate-x-full"));
  }

  function closeDrawer() {
    const panel = document.getElementById("drawer-panel");
    panel.classList.add("translate-x-full");
    setTimeout(
      () => document.getElementById("user-drawer").classList.add("hidden"),
      300,
    );
  }

  document
    .getElementById("close-drawer")
    .addEventListener("click", closeDrawer);
  document
    .getElementById("drawer-backdrop")
    .addEventListener("click", closeDrawer);

  window.viewUser = (id) => {
    const u = allUsers.find((x) => x.user_id === id);
    if (u) openDrawer(u);
  };
  window.editUser = (id) => {
    console.log("Edit user", id);
    // TODO: open edit modal
  };
  window.deleteUser = (id) => {
    if (confirm("Are you sure you want to delete this user?")) {
      console.log("Delete user", id);
      // TODO: call delete API
    }
  };

  // Export
  document.getElementById("export-btn").addEventListener("click", () => {
    const headers = [
      "ID",
      "First Name",
      "Last Name",
      "Email",
      "Phone",
      "Role",
      "Hotel",
      "Joined",
    ];
    const rows = filteredUsers.map((u) => [
      u.user_id,
      u.first_name,
      u.last_name,
      u.email,
      u.phone || "",
      u.role_name || "",
      u.hotel_name || "",
      u.created_at || "",
    ]);
    const csv = [headers, ...rows]
      .map((r) => r.map((c) => `"${String(c).replace(/"/g, '""')}"`).join(","))
      .join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `users-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Bulk delete
  document.getElementById("bulk-delete").addEventListener("click", () => {
    if (confirm(`Delete ${selectedIds.size} selected user(s)?`)) {
      console.log("Bulk delete", [...selectedIds]);
      // TODO: call bulk delete API
    }
  });

  function formatDate(ts) {
    if (!ts) return "—";
    return new Date(ts).toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }

  function timeAgo(ts) {
    if (!ts) return "";
    const diff = (Date.now() - new Date(ts).getTime()) / 1000;
    if (diff < 60) return "just now";
    if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
    if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
    if (diff < 31536000) return `${Math.floor(diff / 2592000)}mo ago`;
    return `${Math.floor(diff / 31536000)}y ago`;
  }

  loadUsers();
</script>

