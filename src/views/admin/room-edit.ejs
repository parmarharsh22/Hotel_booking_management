    <!-- Interface Event Control Scripts -->
    <script>
        // Safely parse the EJS variables directly into a client-side database matrix 
        // to keep search/filter features working completely without extra API hits!
        // let mockRoomsDatabase = <%- JSON.stringify(room) %>;
        // console.log(mockRoomsDatabase);
        
        // Toggle Filter UI Popup Card
        function toggleFilterDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside components boundary
        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('filterDropdown');
            if (!dropdown.contains(e.target) && !e.target.closest('button')?.innerText.includes('Filter')) {
                dropdown.classList.add('hidden');
            }
        });

        // Dynamic table structural redraw client side for sorting/filtering mechanisms
        function renderRoomCards(dataset) {
            const container = document.getElementById('roomContainer');
            container.innerHTML = '';

            if (dataset.length === 0) {
                container.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400 font-medium">
                            No active entries match current filter rules.
                        </td>
                    </tr>`;
                updateCounters(0);
                return;
            }

            dataset.forEach(room => {
                let statusBadge = room.room_status_id === 1 
                    ? '<span class="text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">Available</span>'
                    : '<span class="text-[10px] px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold border border-amber-200">Occupied</span>';

                let amenitiesHtml = (room.amenities || []).map(icon => 
                    `<i class="fa-solid ${icon} text-xs text-slate-400 bg-slate-100 p-1 rounded"></i>`
                ).join(' ');

                let imgUrl = room.photo_url || 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=200&q=80';

                let rowHtml = `
                    <tr class="hover:bg-slate-50/70 transition">
                        <td class="py-4 px-6 flex items-center space-x-4">
                            <img src="${imgUrl}" alt="Room Thumbnail" class="w-12 h-12 object-cover rounded-lg bg-slate-100 shrink-0 border border-slate-200">
                            <div>
                                <div class="font-semibold text-slate-900">${room.category_name}</div>
                                <div class="text-[10px] tracking-wide font-bold text-slate-400 uppercase mt-0.5">${room.tag || ''}</div>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="text-xs font-semibold text-slate-700">Room ${room.room_number}</div>
                            <div class="text-[11px] text-slate-400">Floor Layout: ${room.floor}</div>
                        </td>
                        <td class="py-4 px-6 max-w-xs">
                            <div class="flex items-center space-x-2 mb-1.5">
                                ${amenitiesHtml}
                                ${statusBadge}
                            </div>
                            <p class="text-[11px] text-slate-500 italic truncate" title="${room.notes || ''}">"${room.notes || 'No extra notes.'}"</p>
                        </td>
                        <td class="py-4 px-6 font-bold text-slate-900 text-base">
                            ${room}
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="flex items-center justify-end space-x-2 text-slate-400">
                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-eye"></i></button>
                                <button class="p-1.5 hover:text-slate-600 hover:bg-slate-100 rounded transition"><i class="fa-regular fa-pen-to-square"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });

            updateCounters(dataset.length);
        }

        // Reactive UI text adjustments for table metrics counters
        function updateCounters(count) {
            document.getElementById('visibleCounter').innerText = `${count} type${count !== 1 ? 's' : ''} visible`;
            document.getElementById('showingIndicator').innerText = `Showing 1-${count} of ${count} items`;
        }

        // Filter Evaluation Engine 
        function applyFilters() {
            const typeValue = document.getElementById('filterRoomType').value;
            const statusValue = document.getElementById('filterStatus').value;
            const floorValue = document.getElementById('filterFloor').value;

            let filteredResult = mockRoomsDatabase.filter(room => {
                let matchesType = typeValue === "" || room.room_type_id == typeValue;
                let matchesStatus = statusValue === "" || room.room_status_id == statusValue;
                let matchesFloor = floorValue === "" || room.floor == floorValue;
                return matchesType && matchesStatus && matchesFloor;
            });

            renderRoomCards(filteredResult);
            toggleFilterDropdown(); 
        }

        // Clear filter panel state triggers
        function resetFilters() {
            document.getElementById('filterRoomType').value = "";
            document.getElementById('filterStatus').value = "";
            document.getElementById('filterFloor').value = "";
            renderRoomCards(mockRoomsDatabase);
            toggleFilterDropdown();
        }

        // Live client-side interactive search engine
        function searchTable() {
            const searchVal = document.getElementById('tableSearch').value.toLowerCase();
            let queryMatch = mockRoomsDatabase.filter(room => {
                return (room.category_name || '').toLowerCase().includes(searchVal) || 
                       (room.notes || '').toLowerCase().includes(searchVal) ||
                       (room.room_number || '').toString().toLowerCase().includes(searchVal);
            });
            renderRoomCards(queryMatch);
        }
    </script>
