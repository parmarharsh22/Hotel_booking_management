<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Guest Registration | LuxeStay</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fc;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed-dim": "#b6c7eb",
                        "tertiary": "#211400",
                        "surface-container-high": "#e6e8eb",
                        "status-available": "#2D8A56",
                        "outline": "#75777e",
                        "error": "#ba1a1a",
                        "surface-container": "#eceef1",
                        "on-primary-fixed": "#081b38",
                        "status-dirty": "#64748B",
                        "on-tertiary-fixed-variant": "#5b4217",
                        "on-background": "#191c1e",
                        "inverse-surface": "#2d3133",
                        "tertiary-container": "#3c2700",
                        "tertiary-fixed-dim": "#e5c18a",
                        "on-secondary-fixed-variant": "#5d4201",
                        "status-maintenance": "#D97706",
                        "inverse-primary": "#b6c7eb",
                        "surface-white": "#FFFFFF",
                        "primary": "#031632",
                        "inverse-on-surface": "#eff1f4",
                        "surface-container-lowest": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-tertiary-container": "#ad8d5b",
                        "on-primary": "#ffffff",
                        "on-surface": "#191c1e",
                        "primary-container": "#1a2b48",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "secondary-fixed-dim": "#e9c176",
                        "surface-dim": "#d8dadd",
                        "surface": "#f7f9fc",
                        "surface-variant": "#e0e3e6",
                        "secondary-container": "#fed488",
                        "tertiary-fixed": "#ffdead",
                        "on-primary-container": "#8293b5",
                        "secondary-fixed": "#ffdea5",
                        "on-tertiary": "#ffffff",
                        "primary-fixed": "#d7e2ff",
                        "on-tertiary-fixed": "#281900",
                        "surface-container-highest": "#e0e3e6",
                        "surface-container-low": "#f2f4f7",
                        "outline-variant": "#c5c6ce",
                        "on-surface-variant": "#44474d",
                        "surface-bright": "#f7f9fc",
                        "on-primary-fixed-variant": "#374765",
                        "on-secondary-fixed": "#261900",
                        "on-secondary-container": "#785a1a",
                        "on-error": "#ffffff",
                        "status-booked": "#1A2B48",
                        "background": "#f7f9fc",
                        "secondary": "#775a19",
                        "surface-tint": "#4e5f7e"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "sidebar-width": "260px",
                        "container-margin-desktop": "32px",
                        "container-margin-mobile": "16px",
                        "unit": "4px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "title-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "data-mono": ["Inter"],
                        "display-lg-mobile": ["Inter"],
                        "label-caps": ["Inter"],
                        "display-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "title-sm": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "data-mono": ["14px", { "lineHeight": "20px", "letterSpacing": "-0.01em", "fontWeight": "500" }],
                        "display-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }],
                        "display-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
</head>

<body
    class="bg-surface text-on-surface min-h-screen flex items-center justify-center relative overflow-x-hidden p-4 md:p-8">
    <!-- Decorative Background -->
    <div class="absolute inset-0 z-0">
        <img class="w-full h-full object-cover opacity-20 filter grayscale"
            data-alt="A cinematic, wide-angle shot of a luxurious hotel lobby with polished marble floors reflecting warm ambient light from grand crystal chandeliers. The scene is characterized by a sophisticated navy and gold color palette, featuring plush velvet seating and minimalist architectural lines. High-key lighting creates a serene, premium atmosphere that feels both modern and authoritative, perfectly capturing the essence of a world-class hospitality experience."
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhtpHNICXO5lYNAJZRvcAXMy-GHWvIJOwFcRjkDfTYjv4mlhME-LRX3LY9EytEi0Tho67lutxgSWDU-_MC6K91MC6c0A7cKDJWhnbBI0xV9j85nQJ0ItuOiQ0V6sefKHlPcxKcwgvCW7HPi72qee5n5gJWAnjdbYijMeW2_8nDAGYC1PJThEzz1JXvLJh2dh6GmLfy4APxDvJpTi4KS1AKBkaTAnHwOXVCWyGwFjpTJFFqT6f3zHcs0WyXk8AYO229UwKOOG6BtkZx" />
        <div class="absolute inset-0 bg-gradient-to-br from-surface via-surface/90 to-primary-container/20"></div>
    </div>
    <!-- Auth Container -->
    <main
        class="relative z-10 w-full max-w-[1100px] flex flex-col md:flex-row bg-white shadow-xl overflow-hidden rounded-lg min-h-fit md:min-h-[700px]">
        <!-- Left Side: Branding & Experience -->
        <section class="flex flex-col justify-between p-8 md:p-12 w-full md:w-1/2 bg-primary text-on-primary relative">
            <div class="z-10 mb-8 md:mb-0">
                <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg tracking-tight mb-2">LuxeStay</h1>
                <p class="font-body-md text-body-md text-primary-fixed-dim opacity-80">Experience the gold standard of
                    hospitality management.</p>
            </div>
            <div class="z-10 space-y-6 md:space-y-8 mb-8 md:mb-0">
                <div class="flex items-start gap-4">
                    <span class="material-symbols-outlined text-secondary text-2xl md:text-3xl">verified_user</span>
                    <div>
                        <h3 class="font-title-sm text-title-sm text-white">Seamless Security</h3>
                        <p class="font-body-sm text-body-sm text-primary-fixed-dim">Industry-leading encryption
                            protecting your personal and folio data.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="material-symbols-outlined text-secondary text-2xl md:text-3xl">loyalty</span>
                    <div>
                        <h3 class="font-title-sm text-title-sm text-white">Elite Rewards</h3>
                        <p class="font-body-sm text-body-sm text-primary-fixed-dim">Join our global network for
                            exclusive room rates and priority upgrades.</p>
                    </div>
                </div>
            </div>
            <div class="z-10 hidden md:block">
                <p class="font-label-caps text-label-caps text-primary-fixed-dim uppercase tracking-widest opacity-60">
                    Hospitality Reimagined</p>
            </div>
            <!-- Subtle pattern overlay -->
            <div class="absolute inset-0 opacity-10 pointer-events-none"
                style="background-image: radial-gradient(circle at 2px 2px, #ffffff 1px, transparent 0); background-size: 40px 40px;">
            </div>
        </section>
        <!-- Right Side: Registration Form -->
        <section class="w-full md:w-1/2 p-8 md:p-12 bg-white flex flex-col">
            <div class="mb-8">
                <h2 class="font-headline-md text-headline-md text-primary mb-2">Guest Registration</h2>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Complete your profile to unlock premium
                    stays.</p>
            </div>
            <form class="space-y-5 flex-grow" id="registrationForm">
                <!-- Row: Name -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-label-caps text-label-caps text-on-surface-variant" for="firstName">First
                            Name</label>
                        <div class="relative">
                            <input
                                class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none"
                                id="firstName" name="firstName" placeholder="Alexander" required="" type="text" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="font-label-caps text-label-caps text-on-surface-variant" for="lastName">Last
                            Name</label>
                        <div class="relative">
                            <input
                                class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none"
                                id="lastName" name="lastName" placeholder="Vanderbilt" required="" type="text" />
                        </div>
                    </div>
                </div>
                <!-- Email -->
                <div class="space-y-1.5">
                    <label class="font-label-caps text-label-caps text-on-surface-variant" for="email">Email
                        Address</label>
                    <div class="relative">
                        <input
                            class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none"
                            id="email" name="email" placeholder="a.vanderbilt@domain.com" required="" type="email" />
                    </div>
                </div>
                <!-- Phone -->
                <div class="space-y-1.5">
                    <label class="font-label-caps text-label-caps text-on-surface-variant" for="phone">Phone
                        Number</label>
                    <div class="relative">
                        <input
                            class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none"
                            id="phone" name="phone" placeholder="+1 (555) 000-0000" required="" type="tel" />
                    </div>
                </div>
                <!-- Password Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5 relative">
                        <label class="font-label-caps text-label-caps text-on-surface-variant"
                            for="password">Password</label>
                        <div class="relative">
                            <input
                                class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none pr-10"
                                id="password" name="password" placeholder="••••••••" required="" type="password" />
                            <span
                                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant cursor-pointer text-xl hover:text-primary"
                                onclick="togglePassword('password')">visibility</span>
                        </div>
                    </div>
                    <div class="space-y-1.5 relative">
                        <label class="font-label-caps text-label-caps text-on-surface-variant"
                            for="confirmPassword">Confirm Password</label>
                        <div class="relative">
                            <input
                                class="w-full px-4 py-3 bg-surface-bright border border-outline-variant rounded-lg focus:ring-0 focus:border-primary transition-all text-body-md font-body-md outline-none pr-10"
                                id="confirmPassword" name="confirmPassword" placeholder="••••••••" required=""
                                type="password" />
                            <span
                                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant cursor-pointer text-xl hover:text-primary"
                                onclick="togglePassword('confirmPassword')">visibility</span>
                        </div>
                    </div>
                </div>
                <!-- Terms -->
                <div class="flex items-start gap-3 py-2">
                    <input class="mt-1 w-4 h-4 text-primary border-outline-variant rounded focus:ring-0 cursor-pointer"
                        id="terms" required="" type="checkbox" />
                    <label class="font-body-sm text-body-sm text-on-surface-variant leading-tight" for="terms">
                        I agree to the <a class="text-secondary hover:underline underline-offset-4" href="#">Privacy
                            Policy</a> and <a class="text-secondary hover:underline underline-offset-4" href="#">Terms
                            of Service</a>.
                    </label>
                </div>
                <!-- Submit Action -->
                <button
                    class="w-full py-4 bg-secondary text-on-secondary font-label-caps text-label-caps uppercase tracking-widest rounded-lg hover:bg-secondary/90 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-4"
                    type="submit">
                    Create Account
                    <span class="material-symbols-outlined text-xl">arrow_forward</span>
                </button>
            </form>
            <!-- Login Link -->
            <div class="mt-8 text-center border-t border-outline-variant pt-6">
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Already a registered guest?
                    <a class="font-title-sm text-primary hover:underline underline-offset-4 ml-1" href="#">Sign In</a>
                </p>
            </div>
        </section>
    </main>
    <!-- Micro-interaction JS -->
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            const icon = input.nextElementSibling;
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                input.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        // Form Submission visual feedback
        document.getElementById('registrationForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            const originalContent = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Processing...';

            setTimeout(() => {
                btn.innerHTML = '<span class="material-symbols-outlined">check_circle</span> Welcome to LuxeStay';
                btn.classList.replace('bg-secondary', 'bg-status-available');

                // Reset for demo purposes after 2 seconds
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                    btn.classList.replace('bg-status-available', 'bg-secondary');
                }, 2000);
            }, 1500);
        });

        // Add subtle focus animation to inputs
        const inputs = document.querySelectorAll('input:not([type="checkbox"])');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.classList.add('scale-[1.01]');
            });
            input.addEventListener('blur', () => {
                input.parentElement.classList.remove('scale-[1.01]');
            });
        });
    </script>
    <!-- Footer -->
    <footer class="absolute bottom-4 w-full text-center z-10 px-4">
        <p class="font-body-sm text-body-sm text-on-surface-variant opacity-60">
            © 2024 LuxeStay Hospitality Group. All rights reserved.
        </p>
    </footer>
</body>

</html>