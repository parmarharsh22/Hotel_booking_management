<script>

let revenueChart = null;
let currentRevenuePeriod = "daily";

document.addEventListener("DOMContentLoaded", () => {

    initializeRevenueTrend();

    document
        .querySelectorAll(".revenue-period-btn")
        .forEach(button => {

            button.addEventListener("click", async () => {

                const period = button.dataset.period;

                if (period === currentRevenuePeriod) return;

                currentRevenuePeriod = period;

                updateRevenuePeriodUI(period);

                await loadRevenueTrend(period);
            });

        });
});

async function initializeRevenueTrend() {

    updateRevenuePeriodUI("daily");

    await loadRevenueTrend("daily");
}

function updateRevenuePeriodUI(activePeriod) {

    document
        .querySelectorAll(".revenue-period-btn")
        .forEach(button => {

            const isActive =
                button.dataset.period === activePeriod;

            if (isActive) {

                button.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-900"
                );

                button.classList.remove(
                    "text-slate-500"
                );

            } else {

                button.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-900"
                );

                button.classList.add(
                    "text-slate-500"
                );
            }

        });
}

async function loadRevenueTrend(period) {

    const loading =
        document.getElementById("revenueTrendLoading");

    const chartContainer =
        document.getElementById("revenueTrendChartContainer");

    const emptyState =
        document.getElementById("revenueTrendEmpty");

    try {

        loading.classList.remove("hidden");
        chartContainer.classList.add("hidden");
        emptyState.classList.add("hidden");

        const response = await fetch(
            `/hotelAdmin/revenue-trend?period=${period}`
        );

        if (!response.ok) {
            throw new Error("Failed to load revenue trend");
        }

        const result = await response.json();

        const data = result.data || [];

        loading.classList.add("hidden");

        if (!data.length) {

            emptyState.classList.remove("hidden");

            return;
        }

        chartContainer.classList.remove("hidden");

        renderRevenueChart(data);

    } catch (error) {

        console.error(error);

        loading.classList.add("hidden");

        emptyState.classList.remove("hidden");
    }
}

function renderRevenueChart(data) {

    const ctx =
        document
            .getElementById("revenueTrendChart")
            .getContext("2d");

    if (revenueChart) {
        revenueChart.destroy();
    }

    revenueChart = new Chart(ctx, {

        type: "bar",

        data: {

            labels: data.map(item => item.label),

            datasets: [
                {
                    label: "Revenue",

                    data: data.map(
                        item => item.revenue
                    ),

                    borderRadius: 8,

                    borderSkipped: false,

                    backgroundColor:
                        "rgba(79,70,229,0.85)",

                    hoverBackgroundColor:
                        "rgba(67,56,202,1)"
                }
            ]
        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {
                    display: false
                },

                tooltip: {

                    callbacks: {

                        label(context) {

                            const value =
                                Number(context.raw);

                            return (
                                " Revenue: ₹" +
                                value.toLocaleString(
                                    "en-IN"
                                )
                            );
                        }
                    }
                }
            },

            scales: {

                x: {

                    grid: {
                        display: false
                    },

                    ticks: {
                        color: "#64748b"
                    }
                },

                y: {

                    beginAtZero: true,

                    grid: {
                        color: "#e2e8f0"
                    },

                    ticks: {

                        color: "#64748b",

                        callback(value) {

                            return (
                                "₹" +
                                Number(value)
                                    .toLocaleString("en-IN")
                            );
                        }
                    }
                }
            }
        }
    });
}

</script>

// for Donut

<script>

let bookingStatusChart = null;

document.addEventListener("DOMContentLoaded", async () => {

    await loadBookingStatusDistribution();

});




async function loadBookingStatusDistribution() {

    const loading =
        document.getElementById(
            "bookingStatusLoading"
        );

    const content =
        document.getElementById(
            "bookingStatusContent"
        );

    const empty =
        document.getElementById(
            "bookingStatusEmpty"
        );

    try {

        loading.classList.remove("hidden");
        content.classList.add("hidden");
        empty.classList.add("hidden");

        const response = await fetch(
            "/hotelAdmin/booking-status-distribution"
        );

        if (!response.ok) {
            throw new Error(
                "Failed to fetch booking status data"
            );
        }

        const result = await response.json();

        loading.classList.add("hidden");

        if (
            !result.data ||
            result.data.length === 0
        ) {

            empty.classList.remove("hidden");
            return;
        }

        content.classList.remove("hidden");

        renderBookingStatusChart(
            result.data
        );

        renderBookingStatusLegend(
            result.data
        );

        document.getElementById(
            "bookingStatusTotal"
        ).textContent =
            result.totalBookings.toLocaleString(
                "en-IN"
            );

    } catch (error) {

        console.error(error);

        loading.classList.add("hidden");

        empty.classList.remove("hidden");
    }
}
// chart Renderer



function renderBookingStatusChart(data) {

    const ctx =
        document
            .getElementById(
                "bookingStatusChart"
            )
            .getContext("2d");

    if (bookingStatusChart) {
        bookingStatusChart.destroy();
    }

    const chartColors = [
        "#10b981", // confirmed
        "#3b82f6", // checked in
        "#8b5cf6", // checked out
        "#f59e0b", // pending
        "#ef4444"  // cancelled
    ];

    bookingStatusChart = new Chart(
        ctx,
        {

            type: "doughnut",

            data: {

                labels: data.map(
                    item =>
                    item.status.replaceAll(
                        "_",
                        " "
                    )
                ),

                datasets: [
                    {
                        data: data.map(
                            item => item.count
                        ),

                        backgroundColor:
                            chartColors,

                        borderWidth: 0
                    }
                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: "70%",

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        callbacks: {

                            label(context) {

                                const value =
                                    context.raw;

                                return (
                                    `${context.label}: ${value}`
                                );
                            }
                        }
                    }
                }
            }
        }
    );
}


function renderBookingStatusLegend(data) {

    const legend =
        document.getElementById(
            "bookingStatusLegend"
        );

    const chartColors = [
        "#10b981",
        "#3b82f6",
        "#8b5cf6",
        "#f59e0b",
        "#ef4444"
    ];

    legend.innerHTML = "";

    data.forEach((item, index) => {

        legend.innerHTML += `
            <div class="flex items-center justify-between">

                <div class="flex items-center gap-3">

                    <span
                        class="h-3 w-3 rounded-full"
                        style="background:${chartColors[index]}"
                    ></span>

                    <span
                        class="text-sm font-medium text-slate-700"
                    >
                        ${item.status.replaceAll("_", " ")}
                    </span>

                </div>

                <div
                    class="text-sm text-slate-500"
                >
                    ${item.count}
                    (${item.percentage}%)
                </div>

            </div>
        `;
    });
}



</script>






