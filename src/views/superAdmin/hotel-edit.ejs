  const hotelId = window.location.pathname.split('/')[3];
 
 
  async function loadHotel() {
 
    try {
 
      const res  = await fetch(`/superadmin/hotels/${hotelId}`,{
 
        headers: { 'Accept': 'application/json' }
 
      });
 
      const data = await res.json();
 
      const h    = data.hotel;
 
 
      document.getElementById('hotel-slug-display').textContent = h.slug;
 
      document.getElementById('name').value      = h.name      || '';
 
      document.getElementById('email').value     = h.email     || '';
 
      document.getElementById('phone').value     = h.phone     || '';
 
      document.getElementById('address').value   = h.address   || '';
 
      document.getElementById('city').value      = h.city      || '';
 
      document.getElementById('state').value     = h.state     || '';
 
      document.getElementById('country').value   = h.country   || '';
 
      // document.getElementById('logo_url').value  = h.logo_url  || '';
 
      // document.getElementById('cover_url').value = h.cover_url || '';

      if (h.logo_url) {
    const logoPreview = document.getElementById('logo_preview');
    logoPreview.src = h.logo_url;
    logoPreview.classList.remove('hidden');
}
if (h.cover_url) {
    const coverPreview = document.getElementById('cover_preview');
    coverPreview.src = h.cover_url;
    coverPreview.classList.remove('hidden');
}

 
 
      document.getElementById('loading-state').classList.add('hidden');
 
      document.getElementById('form-wrapper').classList.remove('hidden');
 
    } catch {
 
      document.getElementById('loading-state').textContent = 'Failed to load hotel data.';
 
    }
 
  }
 
 
