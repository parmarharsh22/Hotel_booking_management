                            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Last Name <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <i class="fa-regular fa-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input type="text" name="last_name" required placeholder="e.g. Smith" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2.5 outline-none focus:bg-white focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition">
