<script>
    /**
     * Intercepts media selections to draw instant binary objects on the image frame
     */
    function previewCategoryPhoto(input) {
        const previewFrame = document.getElementById('typePhotoPreview');
        const standardIcon = document.getElementById('typePlaceholderIcon');
        const selectedAsset = input.files[0];

        if (selectedAsset) {
            const memoryStream = URL.createObjectURL(selectedAsset);
            previewFrame.src = memoryStream;
            previewFrame.classList.remove('hidden');
            standardIcon.classList.add('hidden');

            previewFrame.onload = () => URL.revokeObjectURL(memoryStream);
        }
    }

    /**
     * Resets structural form metrics and completely unchecks selected arrays
     */
    function clearCategoryForm() {
        const activeForm = document.getElementById('createRoomTypeForm');
        const previewFrame = document.getElementById('typePhotoPreview');
        const standardIcon = document.getElementById('typePlaceholderIcon');
        
        activeForm.reset();
        previewFrame.src = "";
        previewFrame.classList.add('hidden');
        standardIcon.classList.remove('hidden');
    }

    /**
     * Packages text metrics, image files, and parsed integer array elements into unified multi-part layouts
     */
    async function handleRoomTypeSubmission(event) {
        event.preventDefault();
        const activeForm = event.target;
        
        // Native FormData automatically intercepts regular fields and binary uploaded image streams
        const multiPartPayload = new FormData(activeForm);

        // --- IMPORTANT ARRAY MANAGEMENT SECTION ---
        // Collect checked input nodes and purge default multi-part array configurations 
        // to serialize them into a standardized, simple integer array string key match.
        const checkedElements = activeForm.querySelectorAll('input[name="amenities[]"]:checked');
        const numericalAmenitiesArray = Array.from(checkedElements).map(node => parseInt(node.value, 10));
        
        // Remove individual checked fields from default form structure
        multiPartPayload.delete('amenities[]');
        
        // Append the array as a unified key. Your backend parser can process this with JSON.parse(req.body.amenities)
        multiPartPayload.append('amenities', JSON.stringify(numericalAmenitiesArray));

        try {
            // Adjust this string tracking path to perfectly route into your backend router handling execution configurations
            const destinationResponse = await fetch('/hotelAdmin/room-types', {
                method: 'POST',
                body: multiPartPayload
            });

            if (destinationResponse.ok) {
                alert('New room type profile and matching feature records logged successfully.');
                clearCategoryForm();
                window.location.reload();
            } else {
                const errorReport = await destinationResponse.json();
                alert(`Operational Category Failure: ${errorReport.message || 'Data rejection detected.'}`);
            }
        } catch (networkFault) {
            console.error('API execution interface tracking breakdown context: ', networkFault);
            alert('A systemic transaction processing anomaly prevented configuration delivery.');
        }
    }
</script>


<script>
    /**
     * Fetches room types from the API and dynamically inserts them into the container
     */
    async function renderRoomTypes() {
        try {
            const response = await fetch("http://localhost:7777/hotelAdmin/room-types");
            const roomTypes = await response.json();
            const roomTypeContainer = document.getElementById("roomContainerParent");
            console.log(roomTypes.roomTypes);
            roomTypes.roomTypes.forEach(type => {console.log(type.type_name);
            })
         


            let htmlContent = "";

            if (roomTypes.roomTypes && roomTypes.roomTypes.length > 0) { 
               roomTypes.roomTypes.forEach(type => {
                
              
                    htmlContent += `
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition duration-200">
                        <div>
                            <div class="flex justify-between items-start gap-2">
                                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider truncate" title="${type.type_name}">
                                    ${type.type_name}
                                </p>
                                <span class="text-[10px] px-1.5 py-0.5 font-bold bg-slate-100 text-slate-600 rounded border border-slate-200 whitespace-nowrap">
                                    ID: ${type.room_type_id}
                                </span>
                            </div>

                            <div class="flex items-baseline space-x-1 mt-2">
                                <span class="text-2xl font-bold text-slate-900">$${Number(type.base_price).toFixed(2)}</span>
                                <span class="text-[11px] text-slate-400 font-medium">/ night</span>
                            </div>

                            <div class="mt-3 space-y-1.5 border-t border-slate-100 pt-3">
                                <div class="flex items-center text-xs text-slate-600">
                                    <i class="fa-solid fa-users w-4 text-slate-400 text-[11px]"></i>
                                    <span class="font-medium">Max Occupancy:</span>
                                    <span class="ml-1 text-slate-900 font-semibold">${type.max_occupancy} ${type.max_occupancy > 1 ? 'Guests' : 'Guest'}</span>
                                </div>
                                ${type.description ? `
                                    <p class="text-[11px] text-slate-500 line-clamp-2 italic leading-relaxed mt-1" title="${type.description}">
                                        "${type.description}"
                                    </p>
                                ` : ''}
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-2 mt-4 pt-3 border-t border-slate-100">
                            <button onclick="triggerCategoryDeletion('${type.room_type_id}', '${type.type_name}')" 
                                class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 border border-transparent hover:border-rose-100 rounded-lg transition"
                                title="Delete Category Profile">
                                <i class="fa-regular fa-trash-can text-sm"></i>
                            </button>
                            
                            <button onclick="launchEditCategoryView('${type.room_type_id}')" 
                                class="flex items-center space-x-1.5 bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-semibold px-3 py-2 rounded-lg shadow-sm transition">
                                <i class="fa-regular fa-pen-to-square text-[11px]"></i>
                                <span>Modify</span>
                            </button>
                        </div>
                    </div>`;
               });
            } else {
                htmlContent = `
                <div class="col-span-full p-8 text-center bg-white border border-dashed border-slate-200 rounded-xl">
                    <i class="fa-solid fa-layer-group text-slate-300 text-2xl mb-2"></i>
                    <p class="text-sm text-slate-500 font-medium">No active room types populated within the live property schema.</p>
                </div>`;
            }

            roomTypeContainer.innerHTML = htmlContent;

        } catch (error) {
            console.error("Error loading room types:", error);
            document.getElementById("roomContainerParent").innerHTML = `
            <div class="col-span-full p-8 text-center bg-white border border-dashed border-rose-200 rounded-xl text-rose-500">
                <i class="fa-solid fa-triangle-exclamation text-2xl mb-2"></i>
                <p class="text-sm font-medium">Failed to populate live hotel room architecture profiles.</p>
            </div>`;
        }
    }

    // Call layout initialization on document parse completion
    renderRoomTypes();

    /**
     * Shifts user context focusing onto the category update profile route parameters
     */
    function launchEditCategoryView(roomTypeId) {
        // Routes client directly toward your specific server-side rendering setup
        window.location.href = `/hotelAdmin/room-type/edit/${roomTypeId}`;
    }

    /**
     * Executes asynchronous pipeline deletion request loops targeting your REST routes
     */
    async function triggerCategoryDeletion(roomTypeId, categoryName) {
        // Safety validation gate protecting data relationships
        const confirmExecution = confirm(`Warning: Are you sure you want to permanently delete the "${categoryName}" category?\nThis will disconnect all structural mappings.`);
        
        if (!confirmExecution) return;

        try {
            // Adjust this routing endpoint string to map onto your chosen deletion controller configuration
            const actionResponse = await fetch(`/room-types/${roomTypeId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (actionResponse.ok) {
                alert('Room category profile purged from live architecture matrix.');
                window.location.reload(); // Synchronize view matrix
            } else {
                const faultDetails = await actionResponse.json();
                
                // Triggers clean warning feedback if foreign constraints block execution
                if (faultDetails.message && faultDetails.message.includes('foreign key')) {
                    alert('Purge Request Terminated: Cannot remove this profile category while operational physical rooms still link to it.');
                } else {
                    alert(`Purge Request Exception: ${faultDetails.message || 'Validation anomaly occurred.'}`);
                }
            }
        } catch (networkFault) {
            console.error('purging asset routine network drop context: ', networkFault);
            alert('A network communication loss failure interrupted target deletion synchronization.');
        }
    }
</script>

</body>
</html>