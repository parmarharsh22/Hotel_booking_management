<script>
    /**
     * Intercepts file select events to safely push blob streams 
     * directly into the image element interface for real-time validation.
     */
    function previewSelectedPhoto(inputElement) {
        const previewImg = document.getElementById('roomPhotoPreview');
        const selectedFile = inputElement.files[0];

        if (selectedFile) {
            const objectUrlStream = URL.createObjectURL(selectedFile);
            previewImg.src = objectUrlStream;

            // Optional: Free up performance garbage collections once object finishes drawing
            previewImg.onload = function() {
                URL.revokeObjectURL(previewImg.src); 
            }
        }
    }
let roomNumberTimeout;

async function VerifyRoomNumber(event) {

    const input = event.target;
    const roomNumber = input.value.trim();

    const errorElement = document.getElementById("roomNumberError");

    // reset state
    input.classList.remove(
        "border-red-500",
        "focus:border-red-500"
    );

    errorElement.classList.add("hidden");

    if (!roomNumber) return;

    // Debounce API calls
    clearTimeout(roomNumberTimeout);

    roomNumberTimeout = setTimeout(async () => {

        try {

            const response = await fetch(
    '/hotelAdmin/rooms/verifyRoomExists',
    {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            room_number: roomNumber
        })
    }
);
const data = await response.json();
            if (data.exists) {

                input.classList.remove("border-slate-200");

                input.classList.add(
                    "border-red-500",
                    "focus:border-red-500"
                );

                errorElement.classList.remove("hidden");

            } else {

                input.classList.remove(
                    "border-red-500",
                    "focus:border-red-500"
                );

                errorElement.classList.add("hidden");
            }

        } catch (error) {

            console.error(
                "Room number validation failed:",
                error
            );

        }

    }, 500); // wait 500ms after user stops typing
}


    /**
     * Resets input nodes back to original data properties and restores base asset frames
     */
    function resetFormState() {
        const structuralForm = document.getElementById('editRoomForm');
        const previewImg = document.getElementById('roomPhotoPreview');
        
        structuralForm.reset();
        // Restore pristine image context from default tracker parameter
        previewImg.src = previewImg.getAttribute('data-default-src');
    }

    /**
     * Asynchronous fetch request router targeting your administrative put pipeline.
     */
    async function handleFormSubmission(event, roomId) {
        event.preventDefault();
        const targetedForm = event.target;
        
        // Packaging components inside a FormData engine to process active file buffers cleanly
        const transmissionPayload = new FormData(targetedForm);
        console.log(transmissionPayload);
        
        try {
            const apiResultResponse = await fetch(`/hotelAdmin/rooms/${roomId}`, {
                method: 'PUT',
                body: transmissionPayload
            });

            if (apiResultResponse.status ===200) {
                alert('Room specifications configuration applied successfully.');
                // Route user context back to tracking views or refresh data layout maps
                window.location.reload();
                
            } else {
                const faultData = await apiResultResponse.json();
                alert(`Configuration Exception Encountered: ${faultData.message || 'System fault validation failed.'}`);
            }
        } catch (networkFault) {
            console.error('API Pipeline Breakdown Context: ', networkFault);
            alert('A network exception interrupted data synchronization operations.');
        }
    }
</script>

