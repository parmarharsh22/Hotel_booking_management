<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStay - Guest Confirmation</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fc;
        }
    </style>
</head>

<body class="bg-background text-on-background">

    <%- include('../partials/frontDesk/sidebar') %>

        <div class="lg:ml-[260px] min-h-screen">

            <!-- Header -->
            <header
                class="bg-white border-b border-outline-variant px-8 py-5 flex items-center justify-between sticky top-0 z-30">
                <div>
                    <h1 class="text-2xl font-bold text-primary">Guest Confirmation</h1>
                    <% if (source==="current" ) { %>
                        <p class="text-sm text-on-surface-variant mt-1">Confirm guest information before identity
                            verification</p>
                        <% } else { %>
                            <p class="text-sm text-on-surface-variant mt-1">Past Happy customers</p>
                            <% } %>
                </div>
                <a href="/frontDesk/home"
                    class="px-4 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition">
                    Back
                </a>
            </header>

            <main class="p-8 space-y-8">

                <!-- Booking Summary -->
                <section class="bg-white border border-outline-variant rounded-xl p-6">

                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">confirmation_number</span>
                        <h2 class="text-xl font-semibold text-primary">Booking Information</h2>
                    </div>

                    <div class="grid md:grid-cols-3 gap-6">

                        <div>
                            <label class="text-sm text-on-surface-variant">Booking Reference</label>
                            <input type="text" readonly value="<%= booking.booking_reference %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Check-In Date</label>
                            <input type="text" readonly
                                value="<%= new Date(booking.checkin_date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Check-Out Date</label>
                            <input type="text" readonly
                                value="<%= new Date(booking.checkout_date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Adults</label>
                            <input type="text" readonly value="<%= booking.adults %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Children</label>
                            <input type="text" readonly value="<%= booking.children %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Total Amount</label>
                            <input type="text" readonly value="₹ <%= booking.total_amount %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                    </div>

                    <% if (booking.special_requests) { %>
                        <div class="mt-6">
                            <label class="text-sm text-on-surface-variant">Special Requests</label>
                            <textarea readonly rows="3"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"><%= booking.special_requests %></textarea>
                        </div>
                        <% } %>

                </section>

                <!-- Room Information -->
                <section class="bg-white border border-outline-variant rounded-xl p-6">

                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">bed</span>
                        <h2 class="text-xl font-semibold text-primary">Room Information</h2>
                    </div>

                    <div class="grid md:grid-cols-3 gap-6">

                        <div>
                            <label class="text-sm text-on-surface-variant">Room Number</label>
                            <input type="text" readonly value="<%= booking.room_number %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Room Type</label>
                            <input type="text" readonly value="<%= booking.type_name %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                        <div>
                            <label class="text-sm text-on-surface-variant">Capacity</label>
                            <input type="text" readonly value="<%= booking.capacity %>"
                                class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                        </div>

                    </div>

                </section>

                <!-- Guest Details -->
                <section class="bg-white border border-outline-variant rounded-xl p-6">

                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-primary">person</span>
                        <h2 class="text-xl font-semibold text-primary">Guest Information</h2>
                    </div>

                    <div class="flex flex-col md:flex-row gap-8">

                        <!-- Profile photo / initials -->
                        <div class="flex flex-col items-center">
                            <% if (booking.photo_url) { %>
                                <img src="/uploads/profile-photos/<%= booking.photo_url %>"
                                    class="w-32 h-32 rounded-full object-cover border-4 border-primary-container"
                                    alt="<%= booking.first_name %>">
                                <% } else { %>
                                    <div
                                        class="w-32 h-32 rounded-full bg-secondary-container flex items-center justify-center text-4xl font-bold text-on-secondary-container">
                                        <%= booking.first_name.charAt(0).toUpperCase() %>
                                            <%= booking.last_name.charAt(0).toUpperCase() %>
                                    </div>
                                    <% } %>
                        </div>

                        <!-- Guest fields -->
                        <div class="flex-1 grid md:grid-cols-2 gap-6">

                            <div>
                                <label class="text-sm text-on-surface-variant">First Name</label>
                                <input readonly value="<%= booking.first_name %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">Last Name</label>
                                <input readonly value="<%= booking.last_name %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">Email</label>
                                <input readonly value="<%= booking.email %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">Phone</label>
                                <input readonly value="<%= booking.phone || '' %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">Date of Birth</label>
                                <input readonly
                                    value="<%= booking.dob ? new Date(booking.dob).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">Gender</label>
                                <input readonly value="<%= booking.gender || 'N/A' %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div class="md:col-span-2">
                                <label class="text-sm text-on-surface-variant">Address</label>
                                <textarea readonly rows="3"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2"><%= booking.address || '' %></textarea>
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">City</label>
                                <input readonly value="<%= booking.city %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                            <div>
                                <label class="text-sm text-on-surface-variant">State</label>
                                <input readonly value="<%= booking.state %>"
                                    class="mt-1 w-full rounded-lg border border-outline-variant bg-surface-container-low p-2">
                            </div>

                        </div>
                    </div>

                </section>

                <!-- Action Buttons -->
                <div class="flex justify-end gap-4">

                    <a href="/frontDesk/home"
                        class="px-6 py-3 border border-outline-variant rounded-lg hover:bg-surface-container transition">
                        Cancel
                    </a>

                    <% if (source==="current" ) { %>

                        <a href="/frontDesk/verifyIdentity/<%= booking.booking_reference %>"
                            class="px-6 py-3 bg-gradient-to-r from-[#775a19] to-[#a8842c] text-white rounded-xl shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 font-medium flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">verified_user</span>
                            Next & Continue
                        </a>

                        <% } else { %>

                            <a href="/frontDesk/bookings?tab=history"
                                class="px-6 py-3 bg-gradient-to-r from-[#775a19] to-[#a8842c] text-white rounded-xl shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 font-medium flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">verified_user</span>
                                Back to History
                            </a>

                            <% } %>

                </div>

            </main>
        </div>

</body>

</html>