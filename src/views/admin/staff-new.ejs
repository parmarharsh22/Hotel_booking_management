                                <select name="gender" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2.5 outline-none focus:bg-white focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition">
