<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | LuxeStay</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }

        .luxury-gradient {
            background: radial-gradient(circle at top right,
                    #1a2b48 0%,
                    #031632 100%);
        }

        .gold-shimmer {
            position: relative;
            overflow: hidden;
        }

        .gold-shimmer::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background:
                linear-gradient(45deg,
                    transparent,
                    rgba(255, 222, 165, 0.08),
                    transparent);
            animation: shimmer 6s infinite linear;
        }

        @keyframes shimmer {
            0% {
                transform: translateX(-100%) rotate(45deg);
            }

            100% {
                transform: translateX(100%) rotate(45deg);
            }
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4 luxury-gradient relative">
    <div
        class="absolute inset-0 bg-gradient-to-t from-[#031632]/90 via-[#031632]/20 to-transparent flex flex-col justify-end p-10">
        <main class="w-full max-w-6xl mx-auto grid lg:grid-cols-12 gap-8 items-center relative z-10">

            <!-- LEFT SIDE -->
            <div class="lg:col-span-6 flex flex-col items-center lg:items-start">

                <div class="text-center lg:text-left mb-10">
                    <h1 class="text-3xl md:text-4xl font-bold text-blue-100">
                        <a href="/">LuxeStay</a>
                    </h1>

                    <p class="uppercase tracking-widest text-xs text-yellow-200 mt-2">
                        Hospitality Business Management System
                    </p>
                </div>

                <div
                    class="w-full max-w-[500px] glass-panel rounded-xl overflow-hidden shadow-2xl border border-white/20">

                    <div class="bg-gray-100 border-b px-8 py-6">
                        <h2 class="text-2xl font-semibold text-[#031632]">
                            Reset Password
                        </h2>

                        <p class="text-sm text-gray-600 mt-2">
                            Verify your OTP and create a new secure password.
                        </p>
                    </div>

                    <div class="p-8">

                        <form action="/resetPassword" id="resetPasswordForm" method="post" class="space-y-6">

                            <div>
                                <label
                                    class="uppercase tracking-wider text-xs font-semibold text-gray-500 flex items-center gap-2 mb-2">

                                    <span class="material-symbols-outlined">mail</span>
                                    Registered Email

                                </label>

                                <input type="text" readonly value="<%= email %>" name="email"
                                    class="w-full h-12 px-4 rounded-lg border border-dashed border-gray-300 bg-gray-100 text-gray-500 font-semibold cursor-not-allowed">
                            </div>

                            <div>
                                <label
                                    class="uppercase tracking-wider text-xs font-semibold text-gray-500 flex items-center gap-2 mb-2">

                                    <span class="material-symbols-outlined">lock</span>
                                    New Password

                                </label>

                                <input type="password" id="password" name="password"
                                    class="w-full h-12 px-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#031632] focus:border-[#031632] outline-none">
                            </div>

                            <div>
                                <label
                                    class="uppercase tracking-wider text-xs font-semibold text-gray-500 flex items-center gap-2 mb-2">

                                    <span class="material-symbols-outlined">lock_reset</span>
                                    Confirm Password

                                </label>

                                <input type="password" id="confirmpassword" name="confirmpassword"
                                    class="w-full h-12 px-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#031632] focus:border-[#031632] outline-none">
                            </div>

                            <div>
                                <label
                                    class="uppercase tracking-wider text-xs font-semibold text-gray-500 flex items-center gap-2 mb-2">

                                    <span class="material-symbols-outlined">security</span>
                                    OTP Verification Code

                                </label>

                                <input type="text" id="otp" name="otp" maxlength="4" placeholder="Enter 4-digit OTP"
                                    class="w-full h-12 px-4 border border-gray-300 rounded-lg text-center tracking-[0.5em] text-lg font-bold focus:ring-2 focus:ring-[#031632] focus:border-[#031632] outline-none">

                                <div class="flex justify-between items-center mt-3">

                                    <div class="flex items-center gap-2 text-sm text-gray-600">
                                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>

                                        <span>
                                            Expires in:
                                            <span id="countdown" class="font-semibold"></span>
                                        </span>
                                    </div>

                                    <a href="/login" id="resend-otp-btn"
                                        class="hidden text-[#775a19] font-semibold hover:underline">
                                        Resend OTP
                                    </a>

                                </div>
                            </div>

                            <button type="submit" id="submitbtn"
                                class="w-full h-14 bg-[#775a19] hover:bg-[#5d4201] text-white uppercase tracking-wider font-semibold rounded-lg flex items-center justify-center gap-3 transition-all">

                                Reset Password

                                <span class="material-symbols-outlined">
                                    arrow_forward
                                </span>

                            </button>

                        </form>

                    </div>
                </div>

                <div
                    class="mt-6 w-full max-w-[500px] p-4 rounded-lg bg-white/10 border border-white/10 flex items-center justify-between">

                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>

                        <span class="text-xs uppercase tracking-wider text-blue-100">
                            Password Recovery Session Active
                        </span>
                    </div>

                    <span class="text-xs text-blue-100 opacity-70">
                        OTP Protected
                    </span>
                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="hidden lg:block lg:col-span-6 h-[650px] rounded-2xl overflow-hidden shadow-2xl relative">

                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAn3DlULXk718lahlzez1e4S9jCbQ3fI-Zghxf_ZfEmKOSLUvYyRssDV8Rzirx9hHIRm2JUDQuwPxzo9ncIGzHsLlZN5PiCTlhmFD_t5j-rWWc9QIOF5mlaYfGOLjcNHnW1yNcQoFG2bfttSHTjKDUKA6Ev12R_0e4jRAmvfsbdTfKxiClJoxHhUUZIpxhPyAa9zodbao6AgxeQYe0swX-yoyjNsoZaGdn4H8N6eXbScscKV3zIox_dTfpH6g-bUv73mkvwfk3HqyL"
                    alt="Luxury Hotel"
                    class="w-full h-full object-cover transition-transform duration-700 hover:scale-105">

                <div
                    class="absolute inset-0 bg-gradient-to-t from-[#031632]/90 via-[#031632]/20 to-transparent flex flex-col justify-end p-10">

                    <p class="uppercase tracking-[0.2em] text-yellow-200 text-xs mb-2">
                        ACCOUNT RECOVERY
                    </p>

                    <h3 class="text-white text-3xl font-semibold leading-relaxed">
                        Secure access to your hospitality experience.
                    </h3>

                    <div class="w-12 h-[2px] bg-yellow-200 mt-4 opacity-60"></div>

                </div>

            </div>

        </main>

    </div>
</body>

<script src="/JS/toastmessage.js"></script>
<script src="/JS/auth/forgetPass/validationResetPassword.js"></script>
<script>
    let timeLeft = "<%= ttl %>";
    console.log(timeLeft);
    const timerDisplay = document.getElementById("countdown");
    const resendBtn = document.getElementById("resend-otp-btn");
    const startCountdown = setInterval(() => {

        if (timeLeft <= 0) {

            clearInterval(startCountdown);

            timerDisplay.innerText = "00:00";

            resendBtn.classList.remove("hidden");

            return;
        }

        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;

        timerDisplay.innerText =
            `${minutes.toString().padStart(2, "0")}:` +
            `${seconds.toString().padStart(2, "0")}`;

        timeLeft--;

    }, 1000);
</script>

</html>