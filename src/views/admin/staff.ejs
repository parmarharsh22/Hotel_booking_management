<%- include('../partials/header') %>
            <div class="p-6 md:p-8 space-y-6 max-w-[1600px] w-full mx-auto">
                
                <!-- Controls and Actions Header -->
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Inventory Overview</h2>
                        <p class="text-sm text-slate-500">Manage property room types, base pricing strategies, and amenity bundles.</p>
                    </div>
                    
                    <div class="flex items-center gap-3 relative self-end lg:self-auto">
                        <button onclick="toggleFilterDropdown()" class="flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-md border border-slate-300 transition">
                            <i class="fa-solid fa-sliders text-xs"></i>
                            <span>Filter</span>
                        </button>
                        <a href="/hoteladmin/staff/new">
                        <button class="flex items-center space-x-2 bg-[#0f172a] hover:bg-slate-800 text-white text-sm font-medium px-4 py-2 rounded-md shadow-sm transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add Staff</span>
                        </button>
                        </a>
                        <!-- Filter Dropdown Drawer -->
                        <div id="filterDropdown" class="hidden absolute right-0 top-12 w-72 bg-white rounded-xl shadow-xl border border-slate-200 p-4 z-50 transition-all duration-200">
                            <h4 class="text-sm font-bold text-slate-900 mb-3 border-b pb-2">Filter Rooms</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Room Type ID</label>
                                    <select id="filterRoomType" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                        <option value="">All Types</option>
                                        <option value="12">Deluxe King Suite (12)</option>
                                        <option value="15">Presidential Royal (15)</option>
                                        <option value="8">Executive Twin (8)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Status ID</label>
                                    <select id="filterStatus" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                        <option value="">All Statuses</option>
                                        <option value="1">Available (1)</option>
                                        <option value="2">Occupied (2)</option>
                                        <option value="3">Maintenance (3)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Floor</label>
                                    <input type="number" id="filterFloor" placeholder="e.g. 4" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-md p-2 outline-none focus:border-slate-400">
                                </div>
                                <div class="flex items-center justify-end gap-2 pt-2">
                                    <button onclick="resetFilters()" class="text-xs text-slate-500 hover:text-slate-800 font-medium px-3 py-1.5 rounded">Reset</button>
                                    <button onclick="applyFilters()" class="text-xs bg-[#0f172a] text-white font-medium px-3 py-1.5 rounded hover:bg-slate-800">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



                <!-- Inventory Data Sheet -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-baseline space-x-3">
            <h3 class="font-bold text-slate-900">Hotel Staff</h3>
            <span id="visibleCounter" class="text-xs text-slate-400 font-medium">0 active members</span>
        </div>
        <div class="relative w-full sm:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" id="tableSearch" oninput="searchTable()" placeholder="Search staff members..." class="w-full text-xs bg-slate-50 border border-slate-200 rounded-md pl-9 pr-3 py-2 outline-none focus:bg-white focus:border-slate-400 transition">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-slate-400 uppercase text-[10px] tracking-wider font-semibold">
                    <th class="py-3 px-6">Staff Member</th>
                    <th class="py-3 px-6">Contact Info</th>
                    <th class="py-3 px-6">Role & Permissions</th>
                    <th class="py-3 px-6">Location</th>
                    <th class="py-3 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="staffTableBody" class="divide-y divide-slate-100 text-sm">
                <% if (staff && staff.length > 0) { %>
                    <% staff.forEach(member => { %>
                       
                        <tr class="hover:bg-slate-50/70 transition">
                            <td class="py-4 px-6 flex items-center space-x-3">
                                <% if (member.photo_url) { %>
                                    <img src="<%= imagekitUrl %>/<%= member.photo_url %>" alt="Staff Profile" class="w-9 h-9 rounded-full object-cover bg-slate-100 border border-slate-200 shrink-0">
                                <% } else { %>
                                    <div class="w-9 h-9 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center font-semibold text-xs shrink-0">
                                        <%= member.first_name[0] %><%= member.last_name[0] %>
                                    </div>
                                <% } %>
                                <div>
                                    <div class="font-semibold text-slate-900"><%= member.first_name %> <%= member.last_name %></div>
                                    <div class="text-[11px] text-slate-400">ID: #<%= member.user_id %></div>
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <div class="text-xs font-medium text-slate-700"><%= member.email %></div>
                                <div class="text-[11px] text-slate-400 mt-0.5"><%= member.phone || 'No phone attached' %></div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold border border-slate-200 uppercase tracking-wide">
                                    <%= member.role_name.replace('_', ' ') %>
                                </span>
                            </td>
                            <td class="py-4 px-6">
                                <div class="text-xs text-slate-700 font-medium"><%= member.city || 'N/A' %></div>
                                <div class="text-[11px] text-slate-400"><%= member.state || '' %></div>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end space-x-1.5 text-slate-400">
                                    <a href="/hotelAdmin/staff/<%= member.user_id %>/edit/" class="p-1.5 hover:text-slate-700 hover:bg-slate-100 rounded-md transition" title="Edit Profile">
                                        <i class="fa-regular fa-pen-to-square text-sm"></i>
                                    </a>
                                    <button onclick="handleStaffDelete('<%= member.user_id %>')" class="p-1.5 hover:text-rose-600 hover:bg-rose-50 rounded-md transition" title="Delete Account">
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="py-12 text-center">
                            <div class="flex flex-col items-center justify-center space-y-2">
                                <div class="w-12 h-12 bg-slate-50 border border-slate-200 text-slate-400 rounded-full flex items-center justify-center">
                                    <i class="fa-solid fa-users-slash text-base"></i>
                                </div>
                                <h4 class="text-sm font-semibold text-slate-800">No staff accounts found</h4>
                                <p class="text-xs text-slate-400 max-w-xs mx-auto">There are currently no staff accounts assigned under the FRONT_DESK administrative role group for this location.</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="p-4 border-t border-slate-200 flex items-center justify-between flex-wrap gap-2 text-xs text-slate-500 bg-slate-50/50">
        <span id="showingIndicator">
            Showing 1-<%= (typeof staff !== 'undefined') ? staff.length : 0 %> of <%= (typeof staff !== 'undefined') ? staff.length : 0 %> records
        </span>
        
    </div>
</div>

            </div>

            <!-- Page Footer -->
            <footer class="mt-auto bg-white border-t border-slate-200 py-6 px-6 md:px-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <div>
                    <span class="font-semibold text-slate-700">LuxeStay</span> &copy; 2026 LuxeStay Hospitality Group. All rights reserved.
                </div>
                <div class="flex items-center space-x-4">
                    <a href="#" class="hover:text-slate-800 transition">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Terms of Service</a>
                    <a href="#" class="hover:text-slate-800 transition">Cookie Policy</a>
                    <a href="#" class="hover:text-slate-800 transition">Accessibility</a>
                </div>
            </footer>
        </main>
    </div>

    <!-- Interface Event Control Scripts -->
    <script>




        // Safely parse the EJS variables directly into a client-side database matrix 
        // to keep search/filter features working completely without extra API hits!
     
        // Toggle Filter UI Popup Card
        function toggleFilterDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside components boundary
        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('filterDropdown');
            if (!dropdown.contains(e.target) && !e.target.closest('button')?.innerText.includes('Filter')) {
                dropdown.classList.add('hidden');
            }
        });


const handleStaffDelete = async(staffId)=>{
    // alert("clicked")

const response = await fetch(`/hotelAdmin/staff/${staffId}`,
    {method:"DELETE"}

)
const res = await response.json();

await Swal.fire({
            icon: "success",
            title: "Success!",
            text: res.message || "staff deleted successfully",
            confirmButtonText: "OK"
        });



}

      
    </script>
</body>
</html>