 
<%
 
  pageTitle   = "Dashboard — HBMS";
 
  activePage  = "dashboard";
 
%>
 <%- include('_layout_start') %>
 
<!-- Top bar -->
 
<div class="px-8 py-5 border-b border-surface-border flex items-center justify-between">
 
  <div>
 
    <h1 class="text-lg font-semibold text-white">Dashboard</h1>
 
    <p class="text-xs text-muted mt-0.5">Overview of your platform</p>
 
  </div>
 
  <span class="text-xs font-mono text-muted bg-surface-2 border border-surface-border px-3 py-1 rounded-full" id="live-time"></span>
 
</div>
 
 
<div class="px-8 py-8 space-y-8">
 
 
  <!-- Stat cards -->
 
  <div class="grid grid-cols-4 gap-4" id="stat-cards">
 
    <!-- Skeleton -->
 
    <% for(let i = 0; i < 4; i++) { %>
 
    <div class="card p-5 animate-pulse">
 
      <div class="h-3 w-20 bg-surface-3 rounded mb-4"></div>
 
      <div class="h-8 w-12 bg-surface-3 rounded"></div>
 
    </div>
 
    <% } %>
 
  </div>
 
 
  <!-- Recent hotels table -->
 
  <div class="card overflow-hidden">
 
    <div class="px-6 py-4 border-b border-surface-border flex items-center justify-between">
 
      <h2 class="text-sm font-semibold text-white">Recent Hotels</h2>
 
      <a href="/superadmin/hotels" class="text-xs text-accent hover:underline">View all →</a>
 
    </div>
 
    <div id="recent-hotels-body">
 
      <div class="px-6 py-8 text-center text-muted text-sm">Loading...</div>
 
    </div>
 
  </div>
 
 
</div>
 
 
<script>
 
  // Live clock
 
  function updateClock() {
 
    const el = document.getElementById('live-time');
 
    if (el) el.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
 
  }
 
  updateClock();
 
  setInterval(updateClock, 1000);
 
 
  // Stat cards
 
  async function loadDashboard() {
 
    try {
 
      const res  = await fetch('/superadmin/hotels');
 
      const hotels = await res.json();
 
 
      const active    = hotels.filter(h => h.tenant_status_id === 1).length;
 
      const suspended = hotels.filter(h => h.tenant_status_id === 2).length;
 
      const pending   = hotels.filter(h => h.tenant_status_id === 3).length;
 
 
      const stats = [
 
        { label: 'Total Hotels',    value: hotels.length, color: 'text-accent' },
 
        { label: 'Active',          value: active,         color: 'text-success' },
 
        { label: 'Suspended',       value: suspended,      color: 'text-danger' },
 
        { label: 'Pending',         value: pending,        color: 'text-warning' },
 
      ];
 
 
      document.getElementById('stat-cards').innerHTML = stats.map(s => `
 
        <div class="card p-5">
 
          <p class="text-xs text-muted uppercase tracking-widest font-mono mb-3">${s.label}</p>
 
          <p class="text-3xl font-semibold ${s.color}">${s.value}</p>
 
        </div>
 
      `).join('');
 
 
      // Recent hotels (last 5)
 
      const recent = [...hotels].reverse().slice(0, 5);
 
      if (recent.length === 0) {
 
        document.getElementById('recent-hotels-body').innerHTML =
 
          '<div class="px-6 py-8 text-center text-muted text-sm">No hotels yet</div>';
 
        return;
 
      }
 
 
      document.getElementById('recent-hotels-body').innerHTML = `
 
        <table class="w-full text-sm">
 
          <thead>
 
            <tr class="border-b border-surface-border text-left">
 
              <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Hotel</th>
 
              <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">City</th>
 
              <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Status</th>
 
              <th class="px-6 py-3 text-xs font-mono text-muted uppercase tracking-wider">Created</th>
 
            </tr>
 
          </thead>
 
          <tbody>
 
            ${recent.map(h => `
 
              <tr class="table-row border-b border-surface-border last:border-0 cursor-pointer" onclick="window.location='/superadmin/hotels/${h.hotel_id}'">
 
                <td class="px-6 py-3.5">
 
                  <div class="font-medium text-white">${h.name}</div>
 
                  <div class="text-xs text-muted font-mono">${h.slug}</div>
 
                </td>
 
                <td class="px-6 py-3.5 text-slate-400">${h.city || '—'}, ${h.country || ''}</td>
 
                <td class="px-6 py-3.5">${statusBadge(h.tenant_status_id)}</td>
 
                <td class="px-6 py-3.5 text-slate-400 font-mono text-xs">${formatDate(h.created_at)}</td>
 
              </tr>
 
            `).join('')}
 
          </tbody>
 
        </table>
 
      `;
 
    } catch (err) {
 
      console.error(err);
 
    }
 
  }
 
 
  function statusBadge(id) {
 
    const map = { 1: ['badge-active','Active'], 2: ['badge-suspended','Suspended'], 3: ['badge-pending','Pending'] };
 
    const [cls, label] = map[id] || ['badge-pending', 'Unknown'];
 
    return `<span class="${cls} text-xs font-mono px-2 py-0.5 rounded-md">${label}</span>`;
 
  }
 
 
  function formatDate(ts) {
 
    if (!ts) return '—';
 
    return new Date(ts).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
 
  }
 
 
  loadDashboard();
 
</script>
 

 <%- include('_layout_end') %>
